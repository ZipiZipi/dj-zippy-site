  }
  .j-disc-glow {
    position: absolute; inset: -46%;
    background: radial-gradient(circle, rgba(255, 120, 35, 0.55), rgba(255, 85, 0, 0.18) 42%, transparent 70%);
    opacity: 0.9;
  }

  /* ---- Scene 1: clouds ---- */
  .sky-grad { position: absolute; inset: 0; background: linear-gradient(180deg, #04020a 0%, #120806 34%, #341507 62%, #6d2d0d 84%, #a34b17 100%); }
  .cl-bank {
    position: absolute; left: -14%; right: -14%; height: 26%;
    filter: blur(13px);
  }
  .cl-b1 {
    top: 46%; opacity: 0.7;
    background: radial-gradient(42% 90% at 22% 55%, rgba(255,150,90,0.12), transparent 70%),
                radial-gradient(36% 85% at 58% 45%, rgba(240,130,70,0.10), transparent 70%),
                radial-gradient(30% 80% at 86% 55%, rgba(255,140,80,0.08), transparent 70%);
    animation: j-fogdrift 26s ease-in-out infinite alternate;
  }
  .cl-b2 {
    top: 58%; opacity: 0.85;
    background: radial-gradient(40% 95% at 30% 50%, rgba(46,20,9,0.85), transparent 72%),
                radial-gradient(34% 88% at 68% 42%, rgba(38,17,8,0.8), transparent 70%),
                radial-gradient(26% 80% at 92% 55%, rgba(46,20,9,0.7), transparent 70%);
    animation: j-fogdrift 20s ease-in-out infinite alternate-reverse;
  }
  .cl-b3 {
    top: 68%; height: 30%; opacity: 0.95; filter: blur(16px);
    background: radial-gradient(46% 95% at 24% 52%, rgba(24,10,5,0.95), transparent 74%),
                radial-gradient(40% 90% at 62% 44%, rgba(30,13,6,0.9), transparent 72%),
                radial-gradient(30% 82% at 90% 52%, rgba(24,10,5,0.85), transparent 70%);
    animation: j-fogdrift 17s ease-in-out infinite alternate;
  }
  .cl-b4 {
    top: 80%; height: 34%; filter: blur(20px);
    background: radial-gradient(55% 100% at 35% 55%, rgba(10,4,2,0.98), transparent 78%),
                radial-gradient(48% 95% at 75% 48%, rgba(13,5,2,0.95), transparent 75%);
    animation: j-fogdrift 23s ease-in-out infinite alternate-reverse;
  }
  .j-birds { position: absolute; top: 24%; left: 0; width: 30vmin; height: 6vmin; overflow: visible; }
  .j-birds-low { top: 34%; }
  .bird { animation: j-birdfly 34s linear infinite; }
  .bird.b2 { animation-duration: 46s; animation-delay: 9s; transform: translateY(4px); }
  .bird.b3 { animation-duration: 58s; animation-delay: 20s; transform: translateY(8px); }
  @keyframes j-birdfly {
    0% { transform: translateX(-12vw) translateY(0); opacity: 0; }
    6% { opacity: 0.9; }
    50% { transform: translateX(46vw) translateY(-2.2vh); }
    94% { opacity: 0.9; }
    100% { transform: translateX(105vw) translateY(0.6vh); opacity: 0; }
  }

  /* ---- Scene 2: summit ---- */
  .peak-grad { position: absolute; inset: 0; background: linear-gradient(180deg, #070309 0%, #221009 34%, #5c2812 66%, #a54d15 90%, #cf6a20 100%); }
  .mist {
    position: absolute; left: -10%; right: -10%; height: 13%;
    background: linear-gradient(180deg, transparent, rgba(255, 150, 90, 0.13) 50%, transparent);
    filter: blur(11px);
  }
  .mist-a { top: 48%; animation: j-fogdrift 21s ease-in-out infinite alternate; }
  .mist-b { top: 68%; animation: j-fogdrift 15s ease-in-out infinite alternate-reverse; }
  /* Cloud banks hugging the summit — we are ABOVE them */
  .peak-cloud {
    position: absolute; left: -14%; right: -14%; height: 24%;
    filter: blur(14px);
  }
  .pc-a {
    top: 56%; opacity: 0.9;
    background: radial-gradient(42% 90% at 26% 52%, rgba(58, 26, 11, 0.9), transparent 72%),
                radial-gradient(36% 85% at 64% 44%, rgba(255, 140, 75, 0.14), transparent 70%),
                radial-gradient(30% 80% at 88% 54%, rgba(48, 22, 10, 0.8), transparent 70%);
    animation: j-fogdrift 19s ease-in-out infinite alternate;
  }
  .pc-b {
    top: 72%; height: 30%; filter: blur(17px);
    background: radial-gradient(48% 95% at 36% 52%, rgba(22, 10, 5, 0.95), transparent 75%),
                radial-gradient(40% 88% at 74% 46%, rgba(255, 130, 65, 0.10), transparent 72%);
    animation: j-fogdrift 24s ease-in-out infinite alternate-reverse;
  }

  /* ---- Scene 3: forest ---- */
  .wood-grad { position: absolute; inset: 0; background: radial-gradient(115% 85% at 50% 4%, #4a2410 0%, #1d0f07 40%, #070302 100%); }
  .moon-glow {
    position: absolute; left: 66%; top: -8%; width: 70vmin; height: 70vmin;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(255, 160, 80, 0.30), rgba(255, 110, 40, 0.10) 45%, transparent 70%);
    filter: blur(6px);
  }
  .j-canopy { position: absolute; inset: 0 0 55% 0; background: linear-gradient(180deg, rgba(5, 2, 1, 0.82), transparent); }
  .wshaft {
    position: absolute; top: -14%; width: 15vw; height: 86%;
    background: linear-gradient(180deg, rgba(255, 160, 85, 0.15), transparent 78%);
    filter: blur(10px); transform: skewX(-11deg);
  }
  .ws-a { left: 30%; }
  .ws-b { left: 60%; width: 10vw; transform: skewX(8deg); }
  .j-midfog {
    position: absolute; left: -10%; right: -10%; top: 40%; height: 24%;
    background: linear-gradient(180deg, transparent, rgba(255, 130, 60, 0.13) 50%, transparent);
    filter: blur(12px);
    animation: j-fogdrift 20s ease-in-out infinite alternate-reverse;
  }
  .j-fog {
    position: absolute; left: -10%; right: -10%; bottom: 0; height: 34%;
    background: linear-gradient(180deg, transparent, rgba(255, 140, 65, 0.17) 45%, rgba(26, 13, 6, 0.88));
    filter: blur(10px);
    animation: j-fogdrift 16s ease-in-out infinite alternate;
  }
  @keyframes j-fogdrift { from { transform: translateX(-2.5%); } to { transform: translateX(2.5%); } }
  .j-ferns { inset: auto 0 0 0; height: 12%; }
  .j-flies span {
    position: absolute; width: 5px; height: 5px; border-radius: 50%;
    background: radial-gradient(circle, #ffc89a, rgba(255, 110, 30, 0) 70%);
    animation: j-firefly 1.935s ease-in-out infinite; /* 124 BPM, 4-beat cycle */
  }
  .j-flies span:nth-child(1) { left: 12%; top: 40%; }
  .j-flies span:nth-child(2) { left: 24%; top: 64%; animation-delay: 0.48s; }
  .j-flies span:nth-child(3) { left: 35%; top: 33%; animation-delay: 0.97s; }
  .j-flies span:nth-child(4) { left: 49%; top: 72%; animation-delay: 1.45s; }
  .j-flies span:nth-child(5) { left: 60%; top: 46%; }
  .j-flies span:nth-child(6) { left: 71%; top: 60%; animation-delay: 0.97s; }
  .j-flies span:nth-child(7) { left: 84%; top: 36%; animation-delay: 0.48s; }
  .j-flies span:nth-child(8) { left: 43%; top: 54%; animation-delay: 1.45s; }
  .j-flies span:nth-child(9) { left: 17%; top: 78%; animation-delay: 0.72s; }
  .j-flies span:nth-child(10) { left: 91%; top: 68%; animation-delay: 1.2s; }
  @keyframes j-firefly { 0%, 100% { opacity: 0.12; transform: scale(0.8); } 12% { opacity: 1; transform: scale(1.35); } 30% { opacity: 0.25; transform: scale(0.9); } }

  /* ---- Scene 4: beach sunset ---- */
  .beach-grad { position: absolute; inset: 0; background: linear-gradient(180deg, #0c0407 0%, #2c1108 34%, #6e2c0c 58%, #c65c17 78%, #ff8f34 94%, #ffb668 100%); }
  .sun-halo {
    position: absolute; left: 50%; top: 30%; width: 90vmin; height: 90vmin;
    transform: translate(-50%, 0);
    background: radial-gradient(circle, rgba(255, 150, 60, 0.30), rgba(255, 110, 30, 0.10) 45%, transparent 70%);
    filter: blur(4px);
  }
  .sea-far {
    position: absolute; left: -4%; right: -4%; top: 62%; bottom: 0;
    background:
      repeating-linear-gradient(179deg, rgba(255, 150, 65, 0.10) 0 2px, transparent 2px 8px),
      linear-gradient(180deg, #431c09 0%, #1c0c05 45%, #0a0402 100%);
  }
  .j-glint {
    position: absolute; left: 32%; right: 32%; top: 62.5%; height: 14%;
    background: linear-gradient(180deg, rgba(255, 190, 110, 0.5), rgba(255, 140, 60, 0.12) 65%, transparent);
    filter: blur(6px);
    -webkit-mask-image: repeating-linear-gradient(180deg, black 0 4px, transparent 4px 8px);
    mask-image: repeating-linear-gradient(180deg, black 0 4px, transparent 4px 8px);
    animation: j-glintpulse 5.5s ease-in-out infinite alternate;
  }
  @keyframes j-glintpulse { from { opacity: 0.75; } to { opacity: 1; } }
  .sea-mid { inset: auto 0 0 0; height: 34%; }

  /* Beach foreground (above the sun) */
  .j-beachfront { position: absolute; inset: 0; z-index: 21; opacity: 0; visibility: hidden; }
  .bf-wave { position: absolute; left: -3%; right: -3%; width: 106%; bottom: 15%; height: 13%; animation: j-swell 6.5s ease-in-out infinite alternate; }
  @keyframes j-swell { from { transform: translate(0, 0); } to { transform: translate(-1.4%, -1.6%); } }
  .bf-sand { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 17%; }
  .bf-crowd { position: absolute; left: 6%; right: 6%; width: 88%; bottom: 8.5%; height: 12%; opacity: 0.95; }
  .bf-palm { position: absolute; bottom: 6%; width: clamp(120px, 17vw, 250px); height: auto; }
  .bf-palm-l { left: -1.5%; transform-origin: 45% 100%; animation: j-palmsway 7s ease-in-out infinite alternate; }
  .bf-palm-r { right: -1.5%; transform-origin: 55% 100%; animation: j-palmsway 8.5s ease-in-out infinite alternate-reverse; }
  @keyframes j-palmsway { from { rotate: -1.4deg; } to { rotate: 1.4deg; } }
  .bf-lights { position: absolute; left: 10%; right: 10%; width: 80%; bottom: 17%; height: 11%; }
  .lantern {
    fill: #ffb066;
    animation: j-lantern 1.935s ease-in-out infinite; /* same 124 BPM pulse as the fireflies */
  }
  @keyframes j-lantern { 0%, 100% { opacity: 0.45; } 12% { opacity: 1; } 40% { opacity: 0.6; } }

  /* Dusk tint (final descent) + vignette */
  .j-dusk {
    position: absolute; inset: 0; z-index: 24; opacity: 0;
    background: linear-gradient(180deg, rgba(8, 2, 6, 0.55), rgba(20, 6, 2, 0.15) 55%, rgba(60, 22, 6, 0.25) 100%);
  }
  .j-vignette {
    position: absolute; inset: 0; z-index: 26;
    background: radial-gradient(125% 125% at 50% 45%, transparent 55%, rgba(0, 0, 0, 0.52) 100%);
  }

  /* Chapter numerals */
  .j-dots {
    position: absolute; right: 4.5%; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 1.1rem; z-index: 30;
  }
  .j-dots span {
    font-family: 'Unbounded', sans-serif; font-size: 0.6rem; font-weight: 700;
    color: rgba(255, 255, 255, 0.22); text-align: center;
    transition: color 0.4s, transform 0.4s, text-shadow 0.4s;
  }
  .j-dots span.on { color: #FF5500; transform: scale(1.45); text-shadow: 0 0 12px rgba(255, 85, 0, 0.8); }
  @media (max-width: 640px) { .j-dots { right: 2.5%; gap: 0.8rem; } }

  /* Passing-through foreground (above content, screen edges only) */
  .j-front { position: fixed; inset: 0; z-index: 12; pointer-events: none; overflow: hidden; }
  .pf {
    position: absolute; bottom: -2%;
    width: min(38vw, 520px); height: 44vh;
    filter: drop-shadow(0 -6px 30px rgba(0, 0, 0, 0.5));
    opacity: 0; visibility: hidden;
  }
  .pf-l { left: -5%; }
  .pf-r { right: -5%; }
  .wf {
    position: absolute; bottom: -2%;
    width: min(26vw, 340px); height: 106vh;
    filter: drop-shadow(6px 0 26px rgba(0, 0, 0, 0.55));
    opacity: 0; visibility: hidden;
  }
  .wf-l { left: -4%; }
  .wf-r { right: -4%; }
  @media (max-width: 640px) {
    .pf { width: 52vw; height: 34vh; }
    .wf { width: 38vw; }
  }

  /* Dolly: scenes scale from a slight push-in as you arrive */
  .j-scene { transform-origin: 50% 62%; }

  /* Reduced motion: static site on black, no moving world */
  html.reduce-motion .j-world { display: none; }
  html.reduce-motion .j-front { display: none; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Where the record-sun parks for each chapter (keyed by section id)
  const DISC: Record<string, Record<string, string | number>> = {
    'ch-collection': { top: '16%', x: '27vw', scale: 0.5 },
    'ch-events': { top: '7%', x: '30vw', scale: 0.38 },
    'ch-lead': { top: '33%', x: '-16vw', scale: 0.85 },
    'contact': { top: '58%', x: '17vw', scale: 1.0 },
  };
  const GLOW: Record<string, number> = { 'ch-collection': 0.7, 'ch-events': 0.4, 'ch-lead': 0.95, 'contact': 1 };

  function initWorld() {
    const world = document.getElementById('journey-world');
    if (!world || world.dataset.bound) return;
    world.dataset.bound = '1';
    if ((window as any).__motionOff()) return;

    gsap.registerPlugin(ScrollTrigger);
    const lenis = (window as any).__lenis;
    if (lenis && !(window as any).__lenisGsap) {
      (window as any).__lenisGsap = true;
      lenis.on('scroll', ScrollTrigger.update);
    }

    const chapters = Array.from(document.querySelectorAll<HTMLElement>('.j-chapter[data-scene]'));
    const dots = Array.from(document.querySelectorAll('.j-dots span'));
    const sceneEl = (k: string) => document.querySelector(`.j-scene[data-s="${k}"]`);
    let master: gsap.core.Timeline | null = null;

    // ONE master timeline over the whole page scroll — every shared element is
    // animated only here, at positions derived from chapter offsets.
    function build() {
      if (master) { master.scrollTrigger?.kill(); master.kill(); master = null; }
      const vh = window.innerHeight;
      const total = document.documentElement.scrollHeight - vh;
      if (total <= 0) return;
      const pos = (px: number) => Math.max(0, Math.min(1, px / total));

      master = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: document.body, start: 0, end: total, scrub: 0.5,
          onUpdate(self) {
            const y = self.scroll();
            let idx = -1;
            chapters.forEach((sec, i) => {
              if (i === 0) return;
              if (y >= sec.offsetTop - vh * 0.6 && y < sec.offsetTop + sec.offsetHeight - vh * 0.4) idx = i - 1;
            });
            dots.forEach((d, i) => d.classList.toggle('on', i === idx));
          },
        },
      });

      // Brand dissolves as the descent begins
      const brand = chapters[0];
      if (brand) {
        const bEnd = pos(brand.offsetHeight * 0.5);
        const brandInner = brand.querySelector('.j-brand-block');
        if (brandInner) master.to(brandInner, { autoAlpha: 0, scale: 0.93, filter: 'blur(8px)', duration: Math.max(bEnd, 0.01), ease: 'power1.in' }, 0);
      }

      chapters.forEach((sec, i) => {
        if (i === 0 || !master) return;
        const key = sec.dataset.scene as string;
        const prevKey = chapters[i - 1].dataset.scene as string;
        const t0 = pos(sec.offsetTop - vh * 0.92);
        const t1 = pos(sec.offsetTop - vh * 0.25);
        const dur = Math.max(t1 - t0, 0.005);

        if (key !== prevKey) {
          const scene = sceneEl(key);
          if (scene) {
            // Camera language per leg of the journey:
            //  sky→peak  = we sink DOWN onto the summit (peak rises into frame)
            //  peak→wood = we ride DOWN the mountain (peak sweeps up past camera)
            //  wood→beach = the camera TURNS (forest swings left, beach comes from the right)
            if (key === 'peak') {
              master.to(sceneEl(prevKey), { autoAlpha: 0, yPercent: -12, scale: 1.05, duration: dur }, t0)
                    .fromTo(scene, { yPercent: 20, scale: 1.06 }, { autoAlpha: 1, yPercent: 0, scale: 1, duration: dur, ease: 'power1.out' }, t0);
            } else if (key === 'wood') {
              master.to(sceneEl(prevKey), { autoAlpha: 0, yPercent: -30, scale: 1.14, duration: dur, ease: 'power1.in' }, t0)
                    .fromTo(scene, { yPercent: 24, scale: 1.06 }, { autoAlpha: 1, yPercent: 0, scale: 1, duration: dur, ease: 'power1.out' }, t0);
            } else if (key === 'beach') {
              master.to(sceneEl(prevKey), { autoAlpha: 0, xPercent: -22, scale: 1.07, duration: dur, ease: 'power1.in' }, t0)
                    .fromTo(scene, { xPercent: 16, scale: 1.04 }, { autoAlpha: 1, xPercent: 0, scale: 1, duration: dur, ease: 'power1.out' }, t0)
                    .fromTo('.j-beachfront', { xPercent: 12 }, { autoAlpha: 1, xPercent: 0, duration: dur, ease: 'power1.out' }, t0);
            } else {
              master.to(sceneEl(prevKey), { autoAlpha: 0, scale: 1.09, duration: dur }, t0)
                    .fromTo(scene, { scale: 1.07 }, { autoAlpha: 1, scale: 1, duration: dur, ease: 'power1.out' }, t0);
            }
            if (prevKey === 'beach') master.to('.j-beachfront', { autoAlpha: 0, duration: dur }, t0);
          }
        }
        if (DISC[sec.id]) master.to('.j-disc', { ...DISC[sec.id], duration: dur, ease: 'power1.inOut' }, t0);
        if (GLOW[sec.id] !== undefined) master.to('.j-disc-glow', { opacity: GLOW[sec.id], duration: dur }, t0);
        // Final descent: the party dusk settles in as the sun touches the sea
        if (sec.id === 'contact') master.to('.j-dusk', { opacity: 0.85, duration: dur }, t0 + dur * 0.25);
      });

      // --- Passing-through foreground choreography ---
      const winFor = (id: string) => {
        const i = chapters.findIndex((s) => s.id === id);
        if (i < 1) return null;
        const t0 = pos(chapters[i].offsetTop - vh * 0.92);
        const t1 = pos(chapters[i].offsetTop - vh * 0.25);
        return { t0, t1, dur: Math.max(t1 - t0, 0.005) };
      };
      const sum = winFor('ch-collection');
      const woods = winFor('ch-events');
      const shore = winFor('ch-lead');
      if (sum) {
        // Rocks rise to frame the collection on the summit
        master.fromTo('.pf-l', { yPercent: 70, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: sum.dur, ease: 'power1.out' }, sum.t0)
              .fromTo('.pf-r', { yPercent: 78, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: sum.dur, ease: 'power1.out' }, sum.t0 + sum.dur * 0.12);
      }
      if (sum && woods) {
        // ...and part left/right as the descent continues
        master.to('.pf-l', { xPercent: -46, scale: 1.28, autoAlpha: 0, duration: woods.dur, ease: 'power1.in' }, woods.t0)
              .to('.pf-r', { xPercent: 46, scale: 1.28, autoAlpha: 0, duration: woods.dur, ease: 'power1.in' }, woods.t0);
      }
      if (woods) {
        // Trees surge up from below — the forest closes around the trail
        master.fromTo('.wf-l', { yPercent: 85, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: woods.dur, ease: 'power1.out' }, woods.t0 + woods.dur * 0.25)
              .fromTo('.wf-r', { yPercent: 92, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: woods.dur, ease: 'power1.out' }, woods.t0 + woods.dur * 0.35);
      }
      if (shore) {
        // The trees part left and right — we step out of the forest onto the sand
        master.to('.wf-l', { xPercent: -60, rotation: -3, scale: 1.2, autoAlpha: 0, duration: shore.dur, ease: 'power1.in' }, shore.t0)
              .to('.wf-r', { xPercent: 60, rotation: 3, scale: 1.2, autoAlpha: 0, duration: shore.dur, ease: 'power1.in' }, shore.t0)
              // ...and the palms slide in from the sides to greet the party
              .fromTo('.bf-palm-l', { xPercent: -75 }, { xPercent: 0, duration: shore.dur, ease: 'power1.out' }, shore.t0 + shore.dur * 0.3)
              .fromTo('.bf-palm-r', { xPercent: 75 }, { xPercent: 0, duration: shore.dur, ease: 'power1.out' }, shore.t0 + shore.dur * 0.3);
      }

      // Pin the timeline's duration to exactly 1 so scrub progress (0..1) maps
      // 1:1 onto our pos() fractions — without this the last tween's end time
      // becomes the duration and every transition lands late.
      master.to('#journey-world', { autoAlpha: 1, duration: 0.0001 }, 0.9999);
    }

    // Per-scene parallax (each layer touched by exactly one trigger)
    chapters.forEach((sec, i) => {
      if (i === 0) return;
      const scene = sceneEl(sec.dataset.scene as string);
      if (!scene) return;
      scene.querySelectorAll('[data-depth]').forEach((layer) => {
        const d = parseFloat((layer as HTMLElement).dataset.depth || '1');
        gsap.fromTo(layer, { yPercent: 3.2 * d }, {
          yPercent: -3.2 * d, ease: 'none',
          scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: 0.5 },
        });
      });
    });

    // Content entrances: everything marked data-anim animates into place
    document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
      const kind = el.dataset.anim;
      const from =
        kind === 'left' ? { x: -44, opacity: 0 } :
        kind === 'right' ? { x: 44, opacity: 0 } :
        kind === 'zoom' ? { scale: 0.92, opacity: 0 } :
        { y: 44, opacity: 0 };
      gsap.from(el, { ...from, duration: 0.85, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' } });
    });
    // Vinyl cards roll in like records being laid out
    ScrollTrigger.batch('.vinyl-card', {
      start: 'top 92%',
      onEnter: (batch) => gsap.from(batch, { y: 64, opacity: 0, rotate: 8, stagger: 0.08, duration: 0.7, ease: 'power3.out', overwrite: true }),
    });
    // Event nodes light up along the trail, alternating sides
    ScrollTrigger.batch('.ev-node', {
      start: 'top 90%',
      onEnter: (batch) => gsap.from(batch, {
        x: (i, t) => ((t as HTMLElement).dataset.side === 'r' ? 60 : -60),
        opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power3.out', overwrite: true,
      }),
    });

    build();
    // Section offsets shift while fonts/images settle — rebake the master when
    // the page is fully loaded and once more shortly after, then on resize.
    window.addEventListener('load', () => setTimeout(build, 50), { once: true });
    setTimeout(build, 1500);
    let rt: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(build, 300); });
  }

  document.addEventListener('astro:page-load', initWorld);
  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
