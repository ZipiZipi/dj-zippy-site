---
// "One Record, Every Horizon" v2 — the fixed WORLD layer.
// The vinyl record is the sun. It starts high above a sea of clouds (hero),
// descends past a mountain summit (The Collection), drops behind the forest
// at the mountain's foot (Upcoming Therapy), and finally sets into the sea at
// a beach sunset party (Guest List + Booking) — the end of the page.
// Layer-rich, realistic silhouettes; every shared element is animated on ONE
// master timeline built from section offsets (no scrub conflicts).

const STARS: Array<[number, number, number, number]> = [
  [6, 10, 0.0, 1], [14, 22, 1.2, 0.7], [22, 6, 2.1, 1.2], [31, 18, 0.6, 0.8],
  [38, 11, 1.8, 1], [47, 5, 0.3, 0.7], [55, 15, 2.4, 1.1], [63, 8, 1.0, 0.8],
  [71, 20, 0.2, 1], [78, 6, 1.5, 0.7], [86, 13, 2.7, 1.2], [93, 21, 0.9, 0.8],
  [11, 30, 1.4, 0.6], [27, 27, 0.5, 0.7], [69, 28, 2.0, 0.6], [89, 32, 1.1, 0.7],
];
---

<div id="journey-world" class="j-world" aria-hidden="true">

  <!-- ============ SCENE 1: above the clouds (hero) ============ -->
  <div class="j-scene j-sky" data-s="sky">
    <div class="sky-grad"></div>
    <div class="j-stars">
      {STARS.map(([x, y, d, s]) => <i style={`left:${x}%;top:${y}%;animation-delay:${d}s;transform:scale(${s})`}></i>)}
    </div>
    <svg class="j-layer" data-depth="0.5" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path fill="#160b06" opacity="0.55" d="M0 88 C 9 82 15 86 24 80 C 32 75 40 83 50 78 C 60 73 68 81 78 76 C 86 72 94 80 100 77 V100 H0 Z"/>
    </svg>
    <div class="cl-bank cl-b1" data-depth="0.8"></div>
    <div class="cl-bank cl-b2" data-depth="1.4"></div>
    <div class="cl-bank cl-b3" data-depth="2.2"></div>
    <div class="cl-bank cl-b4" data-depth="3"></div>
    <svg class="j-birds" viewBox="0 0 100 20" preserveAspectRatio="xMidYMid meet">
      <g class="bird b1"><path d="M0 2 Q1.5 0.4 3 2 M3 2 Q4.5 0.4 6 2" stroke="#241209" stroke-width="0.5" fill="none" stroke-linecap="round"/></g>
      <g class="bird b2"><path d="M0 2 Q1.2 0.6 2.4 2 M2.4 2 Q3.6 0.6 4.8 2" stroke="#241209" stroke-width="0.4" fill="none" stroke-linecap="round"/></g>
      <g class="bird b3"><path d="M0 2 Q1 0.7 2 2 M2 2 Q3 0.7 4 2" stroke="#1d0e07" stroke-width="0.35" fill="none" stroke-linecap="round"/></g>
    </svg>
  </div>

  <!-- ============ SCENE 2: AT the summit — just the peak, clouds and the record ============ -->
  <div class="j-scene j-peak" data-s="peak">
    <div class="peak-grad"></div>
    <div class="j-stars j-stars-half">
      {STARS.slice(0, 8).map(([x, y, d, s]) => <i style={`left:${x}%;top:${y * 0.7}%;animation-delay:${d}s;transform:scale(${s})`}></i>)}
    </div>
    <svg class="j-layer" data-depth="0.6" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path fill="#2a1509" d="M-2 100 L6 62 L14 70 L22 56 L30 66 L36 60 L40 100 Z" opacity="0.85"/>
      <path fill="#241208" d="M60 100 L68 64 L76 72 L84 58 L92 68 L102 60 L104 100 Z" opacity="0.85"/>
      <path fill="rgba(255,206,160,0.14)" d="M22 56 L30 66 L27 67 L22 59.5 L17 66 L14 70 L12 68 Z"/>
      <path fill="rgba(255,206,160,0.12)" d="M84 58 L92 68 L89 69 L84 61.5 L79 68 L76 72 L74 70 Z"/>
    </svg>
    <div class="mist mist-a" data-depth="0.9"></div>
    <svg class="j-layer" data-depth="1.8" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path fill="#100704" d="M-4 100 L16 76 L28 58 L40 40 L50 24 L59 37 L68 52 L82 74 L104 100 Z"/>
      <path fill="rgba(255,224,196,0.20)" d="M40 40 L50 24 L59 37 L55 40 L50 30 L45 44 Z"/>
      <path fill="rgba(255,150,80,0.10)" d="M50 24 L59 37 L68 52 L82 74 L79 74.5 L66 54 L57 40 L50 28 Z"/>
      <path fill="rgba(255,150,80,0.06)" d="M28 58 L40 40 L43 43 L31 61 L22 76 L18 76.5 Z"/>
    </svg>
    <div class="peak-cloud pc-a" data-depth="1.2"></div>
    <div class="peak-cloud pc-b" data-depth="2"></div>
    <div class="mist mist-b" data-depth="2.2"></div>
    <svg class="j-layer" data-depth="2.8" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path fill="#050201" d="M0 100 V88 C 16 80 30 88 46 82 C 62 76 76 86 100 80 V100 Z"/>
      <path fill="rgba(255,140,70,0.08)" d="M0 88 C 16 80 30 88 46 82 C 62 76 76 86 100 80 L100 82.4 C 76 88.4 62 78.4 46 84.4 C 30 90.4 16 82.4 0 90.4 Z"/>
    </svg>
    <svg class="j-birds j-birds-low" viewBox="0 0 100 20" preserveAspectRatio="xMidYMid meet">
      <g class="bird b2"><path d="M0 2 Q1.2 0.6 2.4 2 M2.4 2 Q3.6 0.6 4.8 2" stroke="#1a0d06" stroke-width="0.4" fill="none" stroke-linecap="round"/></g>
      <g class="bird b3"><path d="M0 2 Q1 0.7 2 2 M2 2 Q3 0.7 4 2" stroke="#160b05" stroke-width="0.35" fill="none" stroke-linecap="round"/></g>
    </svg>
  </div>

  <!-- ============ SCENE 3: forest at the mountain's foot (events) ============ -->
  <div class="j-scene j-wood" data-s="wood">
    <div class="wood-grad"></div>
    <div class="moon-glow"></div>
    <svg class="j-layer" data-depth="0.4" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path fill="#3a1c0b" opacity="0.55" d="M0 34 L14 20 L 22 27 L 34 14 L 44 24 L 56 12 L 68 25 L 80 16 L 100 30 V45 H0 Z"/>
    </svg>
    <div class="j-canopy"></div>
    <svg class="j-layer" data-depth="0.9" viewBox="0 0 100 100" preserveAspectRatio="none">
      <g fill="#2d160a">
        <ellipse cx="8" cy="16" rx="7" ry="10"/><ellipse cx="24" cy="10" rx="8" ry="12"/><ellipse cx="45" cy="14" rx="9" ry="11"/><ellipse cx="66" cy="9" rx="8" ry="12"/><ellipse cx="88" cy="15" rx="9" ry="11"/>
        <polygon points="7,100 7.7,18 8.9,18 9.6,100"/><polygon points="23,100 23.7,12 24.9,12 25.6,100"/>
        <polygon points="44,100 44.8,16 46.2,16 47,100"/><polygon points="65,100 65.7,11 66.9,11 67.6,100"/>
        <polygon points="87,100 87.8,17 89.2,17 90,100"/>
        <line x1="24.3" y1="34" x2="30" y2="27" stroke="#2d160a" stroke-width="0.7"/>
        <line x1="45.5" y1="40" x2="39" y2="32" stroke="#2d160a" stroke-width="0.7"/>
        <line x1="66.3" y1="30" x2="72" y2="24" stroke="#2d160a" stroke-width="0.7"/>
      </g>
    </svg>
    <div class="wshaft ws-a" data-depth="1.3"></div>
    <div class="j-midfog"></div>
    <svg class="j-layer" data-depth="1.7" viewBox="0 0 100 100" preserveAspectRatio="none">
      <g fill="#170c06">
        <ellipse cx="16" cy="8" rx="9" ry="12"/><ellipse cx="55" cy="5" rx="10" ry="12"/><ellipse cx="82" cy="9" rx="9" ry="11"/>
        <polygon points="15,100 15.9,10 17.3,10 18.2,100"/><polygon points="54,100 54.8,7 56.2,7 57,100"/>
        <polygon points="81,100 81.8,11 83.2,11 84,100"/>
        <polygon points="16.6,42 23,35 23.8,36 17.2,43.4"/><polygon points="55.6,38 49,31 48.2,32 54.8,39.4"/>
      </g>
    </svg>
    <div class="wshaft ws-b" data-depth="2"></div>
    <svg class="j-layer" data-depth="2.6" viewBox="0 0 100 100" preserveAspectRatio="none">
      <g fill="#070302">
        <ellipse cx="3" cy="6" rx="10" ry="14"/><ellipse cx="34" cy="2" rx="11" ry="13"/><ellipse cx="72" cy="5" rx="12" ry="15"/><ellipse cx="98" cy="3" rx="9" ry="12"/>
        <polygon points="1,100 2.2,8 6,8 7.2,100"/><polygon points="32,100 33.4,4 37.6,4 39,100"/>
        <polygon points="70,100 71.5,7 75.5,7 77,100"/><polygon points="96,100 97,5 99.8,5 100,100 96,100"/>
        <line x1="6.4" y1="30" x2="14" y2="22" stroke="#070302" stroke-width="1.1"/>
        <line x1="37" y1="36" x2="28" y2="27" stroke="#070302" stroke-width="1.1"/>
        <line x1="75.8" y1="28" x2="84" y2="20" stroke="#070302" stroke-width="1.1"/>
      </g>
      <!-- warm moonlight rims on the near trunks -->
      <g fill="rgba(255,140,70,0.16)">
        <polygon points="6,100 6.6,8 7.4,8 8,100"/>
        <polygon points="37.8,100 38.4,4 39.2,4 39.8,100"/>
        <polygon points="75.8,100 76.4,7 77.2,7 77.8,100"/>
      </g>
    </svg>
    <svg class="j-layer j-ferns" data-depth="3.4" viewBox="0 0 100 20" preserveAspectRatio="none">
      <path fill="#0d0603" d="M0 20 L0 12 Q 4 6 7 12 Q 9 4 12 11 Q 16 5 19 12 Q 22 7 25 12 Q 28 3 32 11 Q 35 6 38 12 Q 42 5 45 11 Q 48 7 52 12 Q 55 4 59 11 Q 62 6 65 12 Q 69 5 72 11 Q 75 7 78 12 Q 82 4 85 11 Q 88 6 91 12 Q 95 6 100 11 L100 20 Z"/>
      <path fill="rgba(255,150,80,0.10)" d="M28 3 Q 30 7 32 11 L 31 11.4 Q 29.4 7.6 27.4 4.2 Z M55 4 Q 57 7.5 59 11 L 58 11.4 Q 56.2 8 54.2 4.8 Z M82 4 Q 83.6 7.5 85 11 L 84 11.4 Q 82.6 8 81 4.8 Z"/>
    </svg>
    <div class="j-fog"></div>
    <div class="j-parts j-flies">{Array.from({ length: 10 }).map(() => <span></span>)}</div>
  </div>

  <!-- ============ SCENE 4: beach sunset party (guest list + booking) ============ -->
  <div class="j-scene j-beach" data-s="beach">
    <div class="beach-grad"></div>
    <div class="sun-halo"></div>
    <div class="sea-far" data-depth="0.5"></div>
    <div class="j-glint"></div>
    <svg class="sea-mid j-layer" data-depth="1" viewBox="0 0 100 12" preserveAspectRatio="none">
      <path fill="#1c0c05" opacity="0.85" d="M0 6 Q 6 4.6 12 6 T 24 6 T 36 5.4 T 48 6.4 T 60 5.6 T 72 6.4 T 84 5.6 T 100 6 V12 H0 Z"/>
    </svg>
  </div>

  <!-- Beach foreground: sits ABOVE the record so the sun sets behind the waves -->
  <div class="j-beachfront" data-s-front="beach">
    <svg class="bf-wave" viewBox="0 0 100 16" preserveAspectRatio="none">
      <path fill="#120803" d="M0 8 Q 5 5.6 10 8 T 20 8 T 30 7 T 40 8.6 T 50 7.2 T 60 8.6 T 70 7 T 80 8.4 T 90 7.4 T 100 8 V16 H0 Z"/>
      <path fill="rgba(255,170,110,0.14)" d="M0 8 Q 5 5.6 10 8 T 20 8 T 30 7 T 40 8.6 T 50 7.2 T 60 8.6 T 70 7 T 80 8.4 T 90 7.4 T 100 8 L100 8.8 Q 94 7.9 90 8.2 T 80 9.2 T 70 7.8 T 60 9.4 T 50 8 T 40 9.4 T 30 7.8 T 20 8.8 T 10 8.8 Q 5 6.6 0 8.8 Z"/>
    </svg>
    <svg class="bf-sand" viewBox="0 0 100 18" preserveAspectRatio="none">
      <path fill="#0d0502" d="M0 18 L0 9 C 12 5 30 8 46 6.4 C 64 4.6 82 7.4 100 5.4 L100 18 Z"/>
    </svg>
    <svg class="bf-crowd" viewBox="0 0 100 12" preserveAspectRatio="none">
      <g fill="#060201">
        <circle cx="18" cy="6.4" r="1.1"/><rect x="17" y="7.2" width="2" height="4.8" rx="0.8"/><line x1="16.4" y1="6.2" x2="15.4" y2="4" stroke="#060201" stroke-width="0.55" stroke-linecap="round"/>
        <circle cx="24" cy="7" r="1"/><rect x="23.1" y="7.8" width="1.8" height="4.2" rx="0.8"/><line x1="25" y1="6.6" x2="26.2" y2="4.6" stroke="#060201" stroke-width="0.5" stroke-linecap="round"/>
        <circle cx="30" cy="6.2" r="1.15"/><rect x="29" y="7" width="2" height="5" rx="0.8"/><line x1="31.2" y1="5.8" x2="32.4" y2="3.6" stroke="#060201" stroke-width="0.55" stroke-linecap="round"/><line x1="29" y1="5.8" x2="27.8" y2="3.8" stroke="#060201" stroke-width="0.55" stroke-linecap="round"/>
        <circle cx="70" cy="6.6" r="1.05"/><rect x="69" y="7.4" width="2" height="4.6" rx="0.8"/><line x1="71.2" y1="6.2" x2="72.4" y2="4.2" stroke="#060201" stroke-width="0.5" stroke-linecap="round"/>
        <circle cx="77" cy="6" r="1.2"/><rect x="76" y="6.9" width="2.1" height="5.1" rx="0.8"/><line x1="75.4" y1="5.6" x2="74.2" y2="3.5" stroke="#060201" stroke-width="0.55" stroke-linecap="round"/><line x1="78.4" y1="5.6" x2="79.6" y2="3.5" stroke="#060201" stroke-width="0.55" stroke-linecap="round"/>
        <rect x="84.6" y="5.4" width="3.4" height="6.6" rx="0.4"/><circle cx="86.3" cy="4.6" r="0.5" fill="#FF5500" opacity="0.85"/>
      </g>
    </svg>
    <svg class="bf-palm bf-palm-l" viewBox="0 0 40 60">
      <path fill="#080302" d="M18 60 C 17 46 16 34 13 24 L 16.4 23.4 C 19 33 20.5 46 21.6 60 Z"/>
      <g fill="none" stroke="#080302" stroke-width="2.6" stroke-linecap="round">
        <path d="M14.5 24 C 8 20 3 21 0 26"/><path d="M14.5 23.5 C 9 16 4 14 -1 15"/>
        <path d="M15 23 C 13 14 10 9 5 7"/><path d="M15.5 23 C 16 13 19 7 24 5"/>
        <path d="M16 23.5 C 22 16 28 14 33 16"/><path d="M16 24 C 23 21 29 22 33 27"/>
      </g>
    </svg>
    <svg class="bf-palm bf-palm-r" viewBox="0 0 40 60">
      <path fill="#080302" d="M22 60 C 23 46 24 34 27 24 L 23.6 23.4 C 21 33 19.5 46 18.4 60 Z"/>
      <g fill="none" stroke="#080302" stroke-width="2.6" stroke-linecap="round">
        <path d="M25.5 24 C 32 20 37 21 40 26"/><path d="M25.5 23.5 C 31 16 36 14 41 15"/>
        <path d="M25 23 C 27 14 30 9 35 7"/><path d="M24.5 23 C 24 13 21 7 16 5"/>
        <path d="M24 23.5 C 18 16 12 14 7 16"/><path d="M24 24 C 17 21 11 22 7 27"/>
      </g>
    </svg>
    <svg class="bf-lights" viewBox="0 0 100 14" preserveAspectRatio="none">
      <path d="M4 3 Q 50 12 96 3" fill="none" stroke="rgba(20,10,5,0.9)" stroke-width="0.25"/>
      {[10, 20, 30, 40, 50, 60, 70, 80, 90].map((x, i) => {
        const y = 3 + 9 * (1 - Math.abs(x - 50) / 46) * (Math.abs(x - 50) / 46 * -1 + 1);
        return <circle class="lantern" cx={x} cy={3 + (1 - Math.pow(Math.abs(x - 50) / 46, 2)) * 6.4} r="0.75" style={`animation-delay:${i * 0.24}s`} />;
      })}
    </svg>
  </div>

  <!-- The traveling record = the sun -->
  <div class="j-disc">
    <div class="j-disc-glow"></div>
    <div class="j-disc-core">
      <div class="j-disc-label"></div>
      <div class="j-disc-hole"></div>
    </div>
  </div>

  <!-- Dusk tint for the final descent + cinematic vignette -->
  <div class="j-dusk"></div>
  <div class="j-vignette"></div>

</div>

<!-- Passing-through foreground: sits ABOVE the content (screen edges only) so
     sections feel nested inside the terrain. Rocks frame the summit and part
     as you head down; trees surge up at the forest and split left/right on
     the way out to the beach. -->
<div id="journey-front" class="j-front" aria-hidden="true">
  <svg class="pf pf-l" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path fill="#070302" d="M0 100 V26 L10 34 L18 28 L30 46 L40 42 L50 62 L62 60 L74 80 L86 88 L100 100 Z"/>
    <path fill="rgba(255,150,90,0.07)" d="M0 26 L10 34 L18 28 L30 46 L40 42 L50 62 L62 60 L74 80 L86 88 L100 100 L97 100 L84 90 L72 82 L60 63 L49 65 L39 45 L29 49 L17 31 L9 37 L0 29 Z"/>
  </svg>
  <svg class="pf pf-r" viewBox="0 0 100 100" preserveAspectRatio="none">
    <g transform="translate(100,0) scale(-1,1)">
      <path fill="#070302" d="M0 100 V26 L10 34 L18 28 L30 46 L40 42 L50 62 L62 60 L74 80 L86 88 L100 100 Z"/>
      <path fill="rgba(255,150,90,0.07)" d="M0 26 L10 34 L18 28 L30 46 L40 42 L50 62 L62 60 L74 80 L86 88 L100 100 L97 100 L84 90 L72 82 L60 63 L49 65 L39 45 L29 49 L17 31 L9 37 L0 29 Z"/>
    </g>
  </svg>
  <svg class="wf wf-l" viewBox="0 0 60 100" preserveAspectRatio="none">
    <g fill="#030201">
      <path d="M12 100 C 13 74 11 48 14 22 C 15 12 17 6 18 0 L30 0 C 27 12 26 22 25 36 C 24 58 25 79 27 100 Z"/>
      <path d="M23 28 C 32 22 40 20 48 22 C 40 27 31 30 24 32 Z"/>
      <path d="M21 46 C 29 42 37 42 45 46 C 36 49 28 50 22 50 Z"/>
      <ellipse cx="48" cy="20" rx="12" ry="7"/>
      <ellipse cx="45" cy="44" rx="10" ry="6"/>
      <ellipse cx="12" cy="7" rx="16" ry="10"/>
      <ellipse cx="36" cy="3" rx="18" ry="9"/>
      <ellipse cx="55" cy="9" rx="12" ry="8"/>
      <polygon points="25,36 27,100 29.4,100 27.4,36" fill="rgba(255,140,70,0.15)"/>
    </g>
  </svg>
  <svg class="wf wf-r" viewBox="0 0 60 100" preserveAspectRatio="none">
    <g transform="translate(60,0) scale(-1,1)" fill="#030201">
      <path d="M12 100 C 13 74 11 48 14 22 C 15 12 17 6 18 0 L30 0 C 27 12 26 22 25 36 C 24 58 25 79 27 100 Z"/>
      <path d="M23 28 C 32 22 40 20 48 22 C 40 27 31 30 24 32 Z"/>
      <path d="M21 46 C 29 42 37 42 45 46 C 36 49 28 50 22 50 Z"/>
      <ellipse cx="48" cy="20" rx="12" ry="7"/>
      <ellipse cx="45" cy="44" rx="10" ry="6"/>
      <ellipse cx="12" cy="7" rx="16" ry="10"/>
      <ellipse cx="36" cy="3" rx="18" ry="9"/>
      <ellipse cx="55" cy="9" rx="12" ry="8"/>
      <polygon points="25,36 27,100 29.4,100 27.4,36" fill="rgba(255,140,70,0.15)"/>
    </g>
  </svg>

  <!-- Chapter numerals (here so the passing terrain can't cover them) -->
  <div class="j-dots">
    {['I', 'II', 'III', 'IV'].map((n) => <span>{n}</span>)}
  </div>
</div>

<style is:global>
  .j-world { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: #020202; }
  .j-scene { position: absolute; inset: 0; opacity: 0; visibility: hidden; }
  .j-scene.j-sky { opacity: 1; visibility: visible; }
  .j-layer { position: absolute; inset: -7% 0; width: 100%; height: 114%; }

  /* Chapter shell (sections floating over the world) */
  .j-chapter { position: relative; z-index: 10; }
  .j-chapter-head { text-align: center; margin-bottom: 2.2rem; }
  .j-kicker {
    display: block; color: rgba(255, 140, 70, 0.85);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.45em; margin-bottom: 0.7rem;
  }
  .j-title {
    font-family: 'Unbounded', sans-serif; font-weight: 900;
    font-size: clamp(1.7rem, 4.5vw, 3rem); letter-spacing: 0.12em;
    color: #fff; text-shadow: 0 2px 24px rgba(0,0,0,0.7);
  }
  .j-title::after { content: ''; display: block; width: 56px; height: 2px; margin: 0.7rem auto 0; background: #FF5500; box-shadow: 0 0 10px rgba(255,85,0,0.8); }
  .j-sub { color: rgba(235, 225, 218, 0.85); font-size: clamp(0.95rem, 2vw, 1.15rem); text-shadow: 0 1px 12px rgba(0,0,0,0.8); margin-top: 0.6rem; }
  .j-glass {
    background: rgba(5, 3, 2, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  /* Brand opening */
  .j-brand-kicker { color: rgba(255, 130, 60, 0.85); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.5em; margin-bottom: 1.2rem; }
  .j-brand-h {
    font-family: 'Unbounded', sans-serif; font-weight: 900; color: #fff;
    font-size: clamp(3.2rem, 11vw, 8rem); line-height: 0.95;
    text-shadow: 0 2px 34px rgba(0, 0, 0, 0.55);
  }
  .j-brand-sub {
    font-family: 'Unbounded', sans-serif; font-weight: 900;
    font-size: clamp(1.1rem, 3.4vw, 2.6rem); letter-spacing: 0.02em;
    background: linear-gradient(90deg, #FF5500, #ffffff);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 2px 16px rgba(0, 0, 0, 0.5));
  }
  .j-hint {
    color: rgba(255,255,255,0.4); font-size: 0.65rem; letter-spacing: 0.5em; font-weight: 700;
    animation: j-hintpulse 2.2s ease-in-out infinite;
  }
  @keyframes j-hintpulse { 0%, 100% { opacity: 0.35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-6px); } }

  /* Stars */
  .j-stars { position: absolute; inset: 0; }
  .j-stars-half { opacity: 0.55; }
  .j-stars i {
    position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: rgba(255, 235, 215, 0.9);
    box-shadow: 0 0 6px rgba(255, 200, 150, 0.7);
    animation: j-twinkle 3.4s ease-in-out infinite;
  }
  @keyframes j-twinkle { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }

  /* The record (sun) */
  .j-disc {
    position: absolute; left: 50%; top: 19%;
    width: clamp(130px, 18vw, 240px); height: clamp(130px, 18vw, 240px);
    margin-left: calc(clamp(130px, 18vw, 240px) / -2);
    z-index: 20;
  }
  .j-disc-core {
    position: absolute; inset: 0; border-radius: 50%;
    background:
      radial-gradient(circle at center, transparent 17%, #0c0c0c 18%),
      repeating-radial-gradient(circle at center, rgba(34,34,34,1) 0px, rgba(18,18,18,1) 1.5px, rgba(27,27,27,1) 3px),
      linear-gradient(135deg, #131313 0%, #090909 55%, #131313 100%);
    box-shadow: 0 0 0 2px rgba(255, 130, 55, 0.6), 0 0 34px rgba(255, 95, 10, 0.5), inset 0 0 50px rgba(0,0,0,0.85);
    animation: vinyl-spin 16s linear infinite;
  }
  .j-disc-label {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 34%; height: 34%; border-radius: 50%;
    background-image: url('/images/art/vinyl-label.webp');
    background-size: cover; background-position: center;
    box-shadow: 0 0 0 2px rgba(0,0,0,0.6);
