---
// Segmented EN / SR toggle. Both options are always rendered as real links, so
// the switcher works without JS and crawlers can follow it to the other locale.
// `alternateUrl` keeps the current page: /mixes -> /sr/mixes, not /sr.
import { alternateUrl, localize, stripLang, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props as Props;

const basePath = stripLang(Astro.url.pathname);
const suffix = Astro.url.search + Astro.url.hash;

const options: { code: Lang; label: string; href: string; title: string }[] = [
  {
    code: 'en',
    label: 'EN',
    href: localize(basePath, 'en') + suffix,
    title: ui.en.langSwitch.label + ': English',
  },
  {
    code: 'sr',
    label: 'SR',
    href: localize(basePath, 'sr') + suffix,
    title: ui.sr.langSwitch.label + ': Srpski',
  },
];

// Kept for the aria-label on the group.
const groupLabel = ui[lang].langSwitch.label;
const other = alternateUrl(Astro.url, lang);
---

<!-- The track has its own inner padding, so the globe and the pills sit inside
     the rounded edge instead of running into its curve. -->
<div
  class={`inline-flex items-center gap-0.5 p-1 rounded-full border border-white/15 bg-white/5 text-xs font-bold tracking-wide ${className}`}
  role="group"
  aria-label={groupLabel}
  data-lang-switcher
  data-other={other}
>
  <span class="flex items-center pl-2 pr-1.5 text-[13px] leading-none text-gray-500" aria-hidden="true"><i class="fa-solid fa-globe"></i></span>
  {
    options.map((o) => (
      <a
        href={o.href}
        hreflang={o.code === 'sr' ? 'sr-Latn' : 'en'}
        title={o.title}
        aria-current={o.code === lang ? 'true' : undefined}
        class={`lang-opt relative inline-flex h-8 min-w-[2.5rem] items-center justify-center rounded-full px-3 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white ${
          o.code === lang
            ? 'bg-brand-orange text-brand-black'
            : 'text-gray-400 hover:text-white hover:bg-white/10'
        }`}
      >
        {o.label}
      </a>
    ))
  }
</div>

<style>
  /* Pills stay 32px tall, but on touch screens the tap target reaches 40px by
     spilling into the track's padding. */
  @media (pointer: coarse) {
    .lang-opt::after {
      content: '';
      position: absolute;
      inset: -4px -1px;
    }
  }
</style>
