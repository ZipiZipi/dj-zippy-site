---
// Segmented EN / SR toggle. Both options are always rendered as real links, so
// the switcher works without JS and crawlers can follow it to the other locale.
// The link keeps the current page: /mixes -> /sr/mixes, not /sr.
//
// Language is not a side, so the picked option is plain white rather than the
// accent: the header keeps its colour for the A/B flip and the booking button.
import { alternateUrl, localize, stripLang, type Lang } from '../i18n/utils';
import { ui, languages, htmlLang } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props as Props;

const basePath = stripLang(Astro.url.pathname);
// Keep the page's own query (e.g. a filter), but not campaign tags or click
// IDs: carried onto an internal link they would report the switch as a fresh
// visit from the same ad.
const params = new URLSearchParams(Astro.url.search);
for (const key of [...params.keys()]) {
  if (/^(utm_|gclid$|gbraid$|wbraid$|fbclid$|msclkid$|ttclid$|_gl$)/i.test(key)) params.delete(key);
}
const query = params.toString();
const suffix = query ? `?${query}` : '';

const options = (['en', 'sr'] as Lang[]).map((code) => ({
  code,
  label: code.toUpperCase(),
  // the language's own name, so a screen reader says "Srpski", not "S R"
  name: languages[code],
  href: localize(basePath, code) + suffix,
}));

const groupLabel = ui[lang].langSwitch.label;
const other = alternateUrl(Astro.url, lang);
---

<div class:list={['lang-switch', className]} role="group" aria-label={groupLabel} data-lang-switcher data-other={other}>
  {
    options.map((o) => (
      <a
        href={o.href}
        hreflang={htmlLang[o.code]}
        lang={htmlLang[o.code]}
        aria-label={o.name}
        title={o.name}
        aria-current={o.code === lang ? 'true' : undefined}
        class="lang-switch__opt"
      >
        {o.label}
      </a>
    ))
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.04);
  }
  .lang-switch__opt {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    min-width: 2.125rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    color: rgb(255 255 255 / 0.55);
    transition: color 0.2s, background-color 0.2s;
  }
  .lang-switch__opt:hover { color: #fff; }
  .lang-switch__opt[aria-current='true'] { background: #fff; color: #050505; }
  .lang-switch__opt:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* The pills are 24px tall; on touch screens the tap target grows to 44px
     by spilling over the track and the header bar around it. */
  @media (pointer: coarse) {
    .lang-switch__opt::after {
      content: '';
      position: absolute;
      inset: -10px -1px;
    }
  }
</style>
