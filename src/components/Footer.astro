---
// The footer of every page (Layout.astro) is the booking desk, "Let's Connect":
// a heading and the direct lines (email, Resident Advisor, socials) next to a
// booking form built like a piece of the dates deck. In the form the visitor
// picks a side (B · underground, A · open format or not sure yet) and slides a
// fader to the part of the night; the genres for that side and that part light
// up. Behaviour: src/scripts/booking-set.ts (the set) and the script at the
// bottom (sending). Without JS the radios still carry the side and the part of
// the night, and the form posts straight to web3forms.
import { getLangFromUrl, useTranslations, localize, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = (Astro.props as Props).lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// What goes out in the email and to analytics stays English in both languages.
const en = useTranslations('en');

const EMAIL = 'booking@zippydj.com';
const privacyHref = localize('/privacy', lang);
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';

const sidePads = [
  { key: 'B', value: 'B side (underground)', short: t.sides.b, name: t.sides.bLabel, note: t.footer.sideBNote },
  { key: 'A', value: 'A side (open format)', short: t.sides.a, name: t.sides.aLabel, note: t.footer.sideANote },
] as const;

// Three stops on the fader, each in the middle of its third of the night.
const parts = [
  { label: t.room.warmup, value: en.room.warmup, at: 100 / 6 },
  { label: t.room.peak, value: en.room.peak, at: 50 },
  { label: t.room.closing, value: en.room.closing, at: 500 / 6 },
];
const START = 1;   // peak time

// The night as a waveform, one shape per side: B builds to the peak and stays
// deep through the closing, A keeps climbing to a singalong finish. Fixed noise
// gives the bars their texture. Heights are % of the strip; CSS picks the
// side's set and morphs between them when the side changes.
const BARS = 64;
type Env = [number, number][];
const B_ENV: Env = [[0, 0.2], [0.18, 0.38], [0.33, 0.55], [0.45, 0.88], [0.58, 1], [0.7, 0.88], [0.82, 0.74], [1, 0.6]];
const A_ENV: Env = [[0, 0.26], [0.18, 0.44], [0.33, 0.56], [0.5, 0.72], [0.66, 0.8], [0.78, 0.9], [0.9, 1], [1, 0.9]];
function envelope(keys: Env, u: number) {
  for (let k = 1; k < keys.length; k++) {
    const [x0, y0] = keys[k - 1];
    const [x1, y1] = keys[k];
    if (u <= x1) {
      const s = (u - x0) / (x1 - x0);
      return y0 + (y1 - y0) * s * s * (3 - 2 * s);
    }
  }
  return keys[keys.length - 1][1];
}
const bars = Array.from({ length: BARS }, (_, i) => {
  const u = (i + 0.5) / BARS;
  const noise = Math.abs(Math.sin(i * 0.9)) * 0.5 + Math.abs(Math.sin(i * 0.37)) * 0.3 + Math.abs(Math.sin(i * 2.3)) * 0.2;
  const k = 0.55 + 0.45 * noise;
  const pct = (v: number) => `${Math.round(Math.max(0.1, v * k) * 100)}%`;
  return `--hb:${pct(envelope(B_ENV, u))};--ha:${pct(envelope(A_ENV, u))}`;
});

const strings = {
  sides: { B: t.sides.b, A: t.sides.a, any: t.footer.sideAny },
  lines: { B: t.room.B.lines, A: t.room.A.lines, any: t.room.anyLine },
};

const socials = [
  { href: 'https://www.instagram.com/zovumezippy/', label: 'Instagram', icon: 'fa-instagram' },
  { href: 'https://www.youtube.com/@zovumezippy/', label: 'YouTube', icon: 'fa-youtube' },
  { href: 'https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle', label: 'Spotify', icon: 'fa-spotify' },
  { href: 'https://www.mixcloud.com/zovumezippy/', label: 'MixCloud', icon: 'fa-mixcloud' },
  { href: 'https://www.deezer.com/en/profile/2582254702', label: 'Deezer', icon: 'fa-deezer' },
];
---

<footer id="contact" class="book" aria-labelledby="contact-heading">
  <div class="container mx-auto px-6 sm:px-8 lg:px-12">
    <div class="max-w-6xl mx-auto">
      {/* One panel: the heading and the direct lines on the left, the booking
          desk on the right (stacked on phones). On wide screens the desk first
          shows only the set (side, part of the night); "03 Details" opens it
          across the whole panel and the left side folds away, the arrow in the
          desk's top bar brings it back. Without JS everything stays open. */}
      <div class="book-panel" data-book-panel data-reveal>
        <div class="book-panel__side" id="contact-side">
          <h2 id="contact-heading" class="section-title">{t.footer.heading1}<span class="text-brand-orange">{t.footer.heading2}</span></h2>
        <div class="book__direct">
          <ul class="book-rows">
            <li class="book-row">
              <span class="book-row__label mono-caps">{t.footer.emailShort}</span>
              <a class="book-row__value" href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <button type="button" class="book-row__copy" data-copy={EMAIL} data-copied={t.footer.copied} aria-label={t.footer.copyLabel} title={t.footer.copyLabel} hidden>
                <svg class="is-idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" /></svg>
                <svg class="is-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              </button>
              <span class="sr-only" data-copy-status aria-live="polite"></span>
            </li>
            <li class="book-row">
              <span class="book-row__label mono-caps">{t.footer.profile}</span>
              <a class="book-row__value" href="https://ra.co/dj/zippy-2" target="_blank" rel="noopener noreferrer" title={t.footer.raProfile}>
                Resident Advisor
                <svg class="book-row__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
              </a>
            </li>
            <li class="book-row book-row--social">
              <span class="book-row__label mono-caps">{t.footer.follow}</span>
              <span class="book-socials">
                {socials.map((s) => (
                  <a href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={s.label} class="book-social">
                    <i class={`fa-brands ${s.icon}`} aria-hidden="true"></i>
                  </a>
                ))}
              </span>
            </li>
          </ul>
        </div>
        </div>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          action="https://api.web3forms.com/submit"
          class="book-desk"
          aria-labelledby="cf-title"
          data-astro-reload
          data-book-strings={JSON.stringify(strings)}
          data-sending={t.footer.sending}
          data-sent={t.footer.sent}
          data-error={t.footer.error}
          data-sent-note={t.footer.sentNote}
          data-error-note={t.footer.errorNote}
        >
          <input type="hidden" name="access_key" value="53a011ae-cafe-4a90-b080-b4e4d5891262" />
          <input type="hidden" name="subject" value={t.footer.subject} />
          <input type="hidden" name="language" value={lang} />
          <!-- where the visit came from; filled in by the attribution script -->
          <input type="hidden" name="source" value="" data-attribution />
          <!-- web3forms honeypot: people never see it, bots that tick it get rejected -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="book-desk__top mono-caps">
            <button type="button" class="book-back" data-book-back aria-label={`${t.footer.heading1}${t.footer.heading2}`} title={`${t.footer.heading1}${t.footer.heading2}`} aria-controls="contact-side">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            </button>
            <span id="cf-title" class="book-desk__title">{t.footer.deskTitle}</span>
          </div>

          <div class="book-desk__body">
            <div class="book-set">
              <fieldset class="book-group">
                <legend class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">01</span>{t.footer.sideLabel}</legend>
                <div class="book-sides">
                  {sidePads.map((o) => (
                    <label class="book-pad" data-side={o.key}>
                      <input type="radio" name="side" value={o.value} data-side-choice={o.key} checked={o.key === 'B'} required class="book-pad__input" />
                      <span class="book-pad__face">
                        <span class="side-key" aria-hidden="true">{o.key}</span>
                        <span class="book-pad__text">
                          <span class="sr-only">{o.short}: </span>
                          <span class="book-pad__name">{o.name}</span>
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="book-group book-night">
                <legend class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">02</span>{t.room.title}</legend>
                <div class="book-wave" data-book-wave aria-hidden="true">
                  {bars.map((style) => <i style={style}></i>)}
                </div>
                <div class="book-fader" data-book-fader title={t.room.faderLabel}>
                  <span class="book-fader__rail" aria-hidden="true"><i class="book-fader__win"></i></span>
                  <span class="book-fader__ticks" aria-hidden="true">
                    {Array.from({ length: 13 }, (_, i) => <i class={i % 4 === 2 ? 'is-major' : undefined}></i>)}
                  </span>
                  <span class="book-fader__slide" aria-hidden="true"><span class="book-fader__cap"></span></span>
                  {parts.map((p, i) => (
                    <label class="book-stop" style={`--at:${p.at.toFixed(3)}`}>
                      <input type="radio" name="set" value={p.value} data-stop={i} data-at={p.at.toFixed(3)} checked={i === START} class="book-stop__input" />
                      <span class="book-stop__label mono-caps">{p.label}</span>
                    </label>
                  ))}
                </div>
                {(['B', 'A'] as const).map((side) => (
                  <div class="book-genres" data-book-genres={side} data-side={side} hidden={side !== 'B'}>
                    <span class="side-key book-genres__key" aria-hidden="true">{side}</span>
                    <ul aria-label={`${side === 'A' ? t.sides.a : t.sides.b} · ${t.room.genresLabel}`}>
                      {t.room[side].genres.map((g, i) => <li data-genre={en.room[side].genres[i]}>{g}</li>)}
                    </ul>
                  </div>
                ))}
                <input type="hidden" name="genres" value="" disabled />
              </fieldset>
              <button type="button" class="book-next mono-caps" data-book-next aria-controls="cf-details-group" aria-expanded="false">
                <span class="book-step__n" aria-hidden="true">03</span>{t.footer.detailsLabel}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>

            <div class="book-details" id="cf-details-group" role="group" aria-labelledby="cf-details">
              <p id="cf-details" class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">03</span>{t.footer.detailsLabel}</p>
              <div class="book-details__body">
                <div class="book-fields">
                  <div class="book-fields__pair">
                    <div class="book-field">
                      <label for="cf-name" class="mono-caps">{t.footer.name}</label>
                      <input type="text" id="cf-name" name="name" autocomplete="name" enterkeyhint="next" placeholder=" " required class="book-input" />
                    </div>
                    <div class="book-field">
                      <label for="cf-email" class="mono-caps">{t.footer.email}</label>
                      <input type="email" id="cf-email" name="email" autocomplete="email" inputmode="email" enterkeyhint="next" placeholder=" " required class="book-input" />
                    </div>
                  </div>
                  <div class="book-field">
                    <label for="cf-venue" class="mono-caps">{t.footer.venue}</label>
                    <input type="text" id="cf-venue" name="venue" autocomplete="organization" enterkeyhint="next" placeholder=" " required class="book-input" />
                  </div>
                  <div class="book-field book-field--grow">
                    <label for="cf-message" class="mono-caps">{t.footer.messageLabel}</label>
                    <textarea id="cf-message" name="message" rows="3" placeholder={t.footer.message} required class="book-input"></textarea>
                  </div>
                </div>
                <div class="book-send-row">
                  <button type="submit" class="btn btn--primary book-send">
                    <span data-book-send>{t.footer.submit}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </button>
                  <p class="book-status" data-book-status role="status" aria-live="polite"></p>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div class="book__bottom">
        <p>{t.footer.copyright(new Date().getFullYear())}</p>
        {/* the privacy page and the way back to the cookie choice, on every page
            (CookieConsent.astro opens itself for any [data-consent-open]) */}
        <div class="book__legal">
          <a href={privacyHref} aria-current={here === privacyHref ? 'page' : undefined}>{t.footer.privacy}</a>
          <button type="button" data-consent-open>{t.footer.cookieSettings}</button>
          {/* the gallery is not in the menu; this is the one link to it on every page */}
          <a href={localize('/gallery', lang)} aria-current={here === localize('/gallery', lang) ? 'page' : undefined}>{t.breadcrumb.gallery}</a>
          <a href={localize('/links', lang)}>{t.footer.allLinks} <span class="book__go" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* === The booking desk (Footer.astro) ===
     The form is a panel from the same family as the dates deck. Its colour
     follows the side picked in it (--book-rgb), and the other side's colour
     (--book-alt-rgb) marks the small details, so a B request stays orange with
     touches of blue and an A request turns it around. */
  .book {
    position: relative;
    isolation: isolate;
    padding: 4rem 0 2rem;
    background: var(--bg, #050505);
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }
  /* the hero's lighting once more: a warm key light on the left, a cool rim on the right */
  .book::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: min(36rem, 100%);
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 60% at 8% 22%, rgb(var(--accent-rgb) / 0.12), transparent 70%),
      radial-gradient(ellipse 34% 50% at 96% 18%, rgb(var(--alt-rgb) / 0.08), transparent 70%);
    /* fades in from the top edge, so the light never ends in a hard line
       where the section above meets the footer */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 9rem);
    mask-image: linear-gradient(to bottom, transparent, #000 9rem);
  }
  @media (min-width: 640px) { .book { padding-top: 3.5rem; } }
  /* While the cookie card (CookieConsent.astro) is open it covers the bottom of
     the screen; room under the footer lets the send button and the bottom row
     still scroll up above it. */
  :root:has([data-consent]:not([hidden])) .book { padding-bottom: 21rem; }

  /* The panel: heading and direct lines, then the desk (side by side from 1024px).
     Its light follows the side picked in the desk, like the desk itself. */
  .book-panel {
    --book-rgb: var(--side-b-rgb);
    position: relative;
    display: grid;
    padding: 1.25rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line, rgb(255 255 255 / 0.09));
    background: linear-gradient(180deg, #141414, #0b0b0b);
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.95), inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .book-panel:has(.book-desk[data-book-side="A"]) { --book-rgb: var(--side-a-rgb); }
  .book-panel:has(.book-desk[data-book-side="any"]) { --book-rgb: var(--accent-rgb); }
  .book-panel:has(.book-desk:not([data-book-side]) input[data-side-choice="A"]:checked) { --book-rgb: var(--side-a-rgb); }
  /* a wash of the side's colour from the top left, like a lit display */
  .book-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 60% at 6% 0%, rgb(var(--book-rgb) / 0.1), transparent 70%);
  }
  .book-panel > * { position: relative; min-width: 0; }
  @media (min-width: 640px) { .book-panel { padding: 1.75rem 2rem; } }
  .book-panel__side .section-title { margin: 0 0 1.25rem; }
  /* stacked: a hairline between the direct lines and the desk */
  .book-desk { margin-top: 1.75rem; padding-top: 1.75rem; border-top: 1px solid rgb(255 255 255 / 0.07); }

  @media (min-width: 1024px) {
    .book-panel {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      transition: grid-template-columns 0.55s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
    }
    .book-panel__side {
      overflow: clip;
      overflow-clip-margin: 6px;
      padding-right: 2rem;
      border-right: 1px solid rgb(255 255 255 / 0.07);
      transition: opacity 0.35s 0.1s, padding 0.55s var(--ease-out, ease-out), border-color 0.35s;
    }
    /* the content keeps its width while the column folds, so nothing rewraps */
    .book-panel__side > * { width: 18rem; }
    .book-desk { margin-top: 0; padding-top: 0; border-top: 0; padding-left: 2rem; transition: padding 0.55s var(--ease-out, ease-out); }

    /* open: the desk takes the whole panel */
    .book-panel.is-open { grid-template-columns: minmax(0, 0rem) minmax(0, 1fr); }
    .book-panel.is-open .book-panel__side {
      opacity: 0;
      visibility: hidden;
      padding-right: 0;
      border-right-color: transparent;
      transition: opacity 0.2s, visibility 0s 0.55s, padding 0.55s var(--ease-out, ease-out), border-color 0.2s;
    }
    .book-panel.is-open .book-desk { padding-left: 0; }
    .book-panel.is-open .book-details { animation: book-open 0.45s 0.2s var(--ease-out, ease-out) both; }

    /* closed (only once the script runs): just the set, and the way on to the details */
    .book-panel.is-ready:not(.is-open) .book-desk__body { grid-template-columns: minmax(0, 1fr); }
    .book-panel.is-ready:not(.is-open) .book-set { padding-right: 0; }
    .book-panel.is-ready:not(.is-open) .book-details { display: none; }
    .book-panel.is-ready:not(.is-open) .book-next { display: inline-flex; }
    .book-panel.is-ready.is-open .book-back { display: inline-flex; }
  }
  @keyframes book-open { from { opacity: 0; transform: translateX(1.5rem); } }

  /* "03 Details" under the set, and the arrow back to the direct lines */
  .book-next, .book-back { display: none; }
  .book-next {
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
    padding: 0.75rem 1.125rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--book-rgb) / 0.55);
    font-size: 0.6875rem;
    color: #fff;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .book-next svg { width: 1rem; height: 1rem; transition: transform 0.25s var(--ease-out, ease-out); }
  .book-next:hover { background: rgb(var(--book-rgb)); border-color: rgb(var(--book-rgb)); color: #050505; }
  .book-next:hover .book-step__n { color: #050505; }
  .book-next:hover svg { transform: translateX(3px); }
  .book-back {
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-block: -0.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.75);
    transition: color 0.2s, border-color 0.2s;
  }
  .book-back svg { width: 1rem; height: 1rem; }
  .book-back:hover { color: #fff; border-color: rgb(255 255 255 / 0.3); }
  .book-next:focus-visible, .book-back:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* Direct lines: a small spec sheet, label on the left */
  .book-rows { border-top: 1px solid var(--line, rgb(255 255 255 / 0.09)); }
  .book-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--line, rgb(255 255 255 / 0.09));
  }
  .book-row:last-child { border-bottom: 0; }
  .book-row__label { flex: 0 0 4rem; font-size: 0.6875rem; color: rgb(255 255 255 / 0.55); }
  /* the link fills the height of its row: a comfortable target for a thumb */
  .book-row__value {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #fff;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .book-row__value:hover { color: rgb(var(--accent-rgb)); }
  .book-row__go { width: 0.875rem; height: 0.875rem; flex-shrink: 0; color: rgb(var(--alt-rgb)); transition: transform 0.2s var(--ease-out, ease-out); }
  .book-row__value:hover .book-row__go { transform: translate(2px, -2px); }
  .book-row__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.6);
    transition: color 0.2s, border-color 0.2s;
  }
  .book-row__copy[hidden] { display: none; }
  .book-row__copy svg { width: 0.9rem; height: 0.9rem; }
  .book-row__copy .is-ok, .book-row__copy.is-done .is-idle { display: none; }
  .book-row__copy.is-done .is-ok { display: block; }
  .book-row__copy:hover { color: #fff; border-color: rgb(255 255 255 / 0.3); }
  .book-row__copy.is-done { color: rgb(var(--alt-rgb)); border-color: rgb(var(--alt-rgb) / 0.5); }
  /* phones open the mail app instead, and copy with a long press */
  @media (hover: none) { .book-row__copy { display: none; } }
  .book-socials { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .book-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.8);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .book-social:hover { color: #050505; background: rgb(var(--accent-rgb)); border-color: rgb(var(--accent-rgb)); }
  @media (pointer: coarse) { .book-social { width: 2.75rem; height: 2.75rem; } }

  /* The desk */
  .book-desk {
    --book-rgb: var(--side-b-rgb);
    --book-alt-rgb: var(--side-a-rgb);
    container: book / inline-size;
    position: relative;
  }
  .book-desk[data-book-side="A"] { --book-rgb: var(--side-a-rgb); --book-alt-rgb: var(--side-b-rgb); }
  .book-desk[data-book-side="any"] { --book-rgb: var(--accent-rgb); --book-alt-rgb: var(--alt-rgb); }
  /* before the script runs (or without it) the checked pad sets the colours */
  .book-desk:not([data-book-side]):has(input[data-side-choice="A"]:checked) { --book-rgb: var(--side-a-rgb); --book-alt-rgb: var(--side-b-rgb); }
  .book-desk:not([data-book-side]):has(input[data-side-choice="any"]:checked) { --book-rgb: var(--accent-rgb); --book-alt-rgb: var(--alt-rgb); }

  .book-desk__top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; font-size: 0.6875rem; color: rgb(255 255 255 / 0.62); }

  .book-desk__body { display: grid; gap: 2.25rem; }
  .book-set { container-type: inline-size; min-width: 0; }
  @container book (min-width: 38rem) {
    .book-desk__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; }
    .book-set { padding-right: 1.75rem; }
    .book-details { padding-left: 1.75rem; border-left: 1px solid rgb(255 255 255 / 0.07); }
    /* side by side with the set, the message box takes up the spare height */
    .book-fields { flex: 1; }
    .book-field--grow { flex: 1; display: flex; flex-direction: column; }
    .book-field--grow > .book-input { flex: 1; }
  }
  .book-group { min-width: 0; margin: 0; padding: 0; border: 0; }
  .book-step { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.625rem; padding: 0; font-size: 0.6875rem; color: rgb(255 255 255 / 0.62); }
  .book-step__n { color: rgb(var(--book-alt-rgb)); }

  /* 01 · the side pads */
  .book-sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; }
  .book-pad { position: relative; display: block; cursor: pointer; }
  .book-pad__input { position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  /* compact: the key and the name in one row */
  .book-pad__face {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    padding: 0.625rem 0.875rem;
    border-radius: 1rem;
    border: 1px solid var(--line, rgb(255 255 255 / 0.09));
    background: rgb(255 255 255 / 0.035);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .book-pad:hover .book-pad__face { border-color: rgb(255 255 255 / 0.24); background: rgb(255 255 255 / 0.055); }
  .book-pad__input:checked + .book-pad__face { border-color: var(--side); background: rgb(255 255 255 / 0.07); box-shadow: inset 0 0 0 1px var(--side); }
  .book-pad__input:focus-visible + .book-pad__face { outline: 2px solid #fff; outline-offset: 2px; }
  .book-pad__face > .side-key { margin: 0; flex-shrink: 0; }
  .book-pad__text { display: flex; flex-direction: column; min-width: 0; }
  .book-pad__name { font-size: 0.9375rem; font-weight: 600; line-height: 1.25; color: #fff; white-space: nowrap; }
  /* A narrow set column (a phone, or the desk's left half on a window around
     800px wide): tighter pads and a size smaller, so "Underground" never runs
     past the pad's edge and "Open format" keeps to one line. Narrower still,
     the letter goes (the pad's colour says the side). */
  @container (max-width: 20rem) {
    .book-pad__face { gap: 0.375rem; padding: 0.5rem; }
    .book-pad__name { font-size: 0.875rem; }
  }
  @container (max-width: 17.75rem) {
    .book-pad__face { padding-inline: 0.625rem; }
    .book-pad__face > .side-key { display: none; }
  }
  @container (max-width: 15rem) {
    .book-pad__name { font-size: 0.8125rem; }
  }

  /* 02 · the night: waveform, fader, genres, line */
  .book-night { margin-top: 1.25rem; }
  .book-wave { display: flex; align-items: center; gap: 2px; height: 2.5rem; }
  .book-wave i {
    flex: 1 1 0;
    min-width: 1px;
    height: var(--hb);
    border-radius: 2px;
    background: rgb(255 255 255 / 0.14);
    transition: height 0.6s var(--ease-out, ease-out), background-color 0.25s;
  }
  .book-desk[data-book-side="A"] .book-wave i { height: var(--ha); }
  .book-wave i.on { background: rgb(var(--book-rgb)); }
  @container book (max-width: 32rem) { .book-wave i:nth-child(even) { display: none; } }

  .book-fader {
    --pos: 50;
    position: relative;
    height: 4.25rem;
    margin-top: 0.375rem;
    /* sideways drags move the fader; vertical swipes still scroll and pinches
       still zoom the page (plain pan-y first, for browsers without pinch-zoom) */
    touch-action: pan-y;
    touch-action: pan-y pinch-zoom;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .book-fader__rail { position: absolute; left: 0; right: 0; top: 1rem; height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.12); overflow: hidden; }
  /* the part of the night being booked, lit on the rail */
  .book-fader__win {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 33.334%;
    border-radius: 4px;
    background: rgb(var(--book-rgb));
    transform: translateX(calc((var(--pos) - 16.667) / 33.334 * 100%));
  }
  .book-fader__ticks { position: absolute; left: 0; right: 0; top: 1.5rem; display: flex; align-items: flex-start; justify-content: space-between; }
  .book-fader__ticks i { width: 1px; height: 4px; background: rgb(255 255 255 / 0.2); }
  .book-fader__ticks i.is-major { height: 8px; background: rgb(255 255 255 / 0.45); }
  /* a zero-size point on the rail that carries the cap (a full-width box moved
     with a transform would stick out past the page edge on phones) */
  .book-fader__slide { position: absolute; left: calc(var(--pos) * 1%); top: calc(1rem + 2px); width: 0; height: 0; transition: left 0.45s var(--ease-out, ease-out); }
  .book-fader__win { transition: transform 0.45s var(--ease-out, ease-out); }
  .book-fader.is-dragging .book-fader__slide, .book-fader.is-dragging .book-fader__win { transition: none; }
  /* a fader cap: dark, ribbed, with a lit centre line */
  .book-fader__cap {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.125rem;
    height: 2.125rem;
    margin: -1.0625rem 0 0 -0.5625rem;
    border-radius: 0.4rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: linear-gradient(180deg, #3b3b3b, #1b1b1b 55%, #262626);
    box-shadow: 0 8px 16px -4px rgb(0 0 0 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.12);
    transition: border-color 0.2s;
  }
  .book-fader__cap::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 5px;
    bottom: 5px;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: rgb(var(--book-rgb));
    box-shadow: 0 0 6px rgb(var(--book-rgb) / 0.8);
  }
  .book-fader:hover .book-fader__cap, .book-fader.is-dragging .book-fader__cap { border-color: rgb(255 255 255 / 0.45); }
  .book-stop {
    position: absolute;
    top: 2.25rem;
    left: calc(var(--at) * 1%);
    transform: translateX(-50%);
    padding: 0.375rem 0.5rem;
    white-space: nowrap;
    cursor: pointer;
  }
  .book-stop__input { position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .book-stop__label { display: block; font-size: 0.6875rem; color: rgb(255 255 255 / 0.55); transition: color 0.2s; }
  .book-stop:hover .book-stop__label { color: #fff; }
  .book-stop__input:checked + .book-stop__label { color: rgb(var(--book-rgb)); }
  .book-stop__input:focus-visible + .book-stop__label { outline: 2px solid #fff; outline-offset: 4px; border-radius: 3px; }
  /* no script: the checked stop places the fader */
  .book-desk:not(.is-live):has([data-stop="0"]:checked) .book-fader { --pos: 16.667; }
  .book-desk:not(.is-live):has([data-stop="2"]:checked) .book-fader { --pos: 83.333; }

  .book-genres { display: flex; align-items: baseline; gap: 0.625rem; margin-top: 0.75rem; }
  .book-genres[hidden] { display: none; }
  .book-genres + .book-genres { margin-top: 0.5rem; }
  .book-genres .book-genres__key { display: none; transform: translateY(0.2rem); }
  .book-desk[data-book-side="any"] .book-genres .book-genres__key { display: inline-flex; }
  /* One row where it can be: the names shrink with the column. Where even the
     smallest size does not fit, the list wraps; a name is never cut off. */
  .book-genres { min-width: 0; }
  .book-genres ul { display: flex; flex-wrap: wrap; row-gap: 0.15rem; min-width: 0; font-size: clamp(0.6875rem, 2.85cqi, 0.9375rem); font-weight: 600; line-height: 1.4; }
  .book-genres li { white-space: nowrap; }
  .book-genres li { color: rgb(255 255 255 / 0.75); transition: color 0.25s; }
  /* the slash goes after each genre, so a wrapped line ends on one instead of starting with it */
  .book-genres li:not(:last-child)::after { content: '/'; margin: 0 0.45em; color: rgb(255 255 255 / 0.16); font-weight: 400; }
  .book-desk.is-live .book-genres li { color: rgb(255 255 255 / 0.45); }
  .book-desk.is-live .book-genres li.on { color: #fff; }

  /* 03 · details */
  .book-details { display: flex; flex-direction: column; min-width: 0; }
  .book-details__body { container: book-details / inline-size; display: flex; flex-direction: column; flex: 1; }
  .book-fields { display: flex; flex-direction: column; gap: 0.75rem; }
  .book-fields__pair { display: grid; gap: 0.75rem; }
  @container book-details (min-width: 17rem) {
    .book-fields__pair { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0.875rem; }
  }
  /* The label sits inside the field. An empty field shows it like a placeholder;
     typing (or focus) moves it up to the top edge, where it stays readable. The
     inputs carry placeholder=" " so :placeholder-shown can tell empty from filled.
     Without :has() the label simply stays at the top. */
  .book-field { position: relative; }
  .book-field > label {
    position: absolute;
    z-index: 1;
    left: 1rem;
    right: 1rem;
    top: 0.5rem;
    margin: 0;
    font-size: 0.625rem;
    line-height: 1.2;
    color: rgb(255 255 255 / 0.55);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: top 0.2s, font-size 0.2s, color 0.2s;
  }
  .book-field:not(.book-field--grow):has(> .book-input:placeholder-shown:not(:focus)) > label { top: 1.05rem; font-size: 0.75rem; color: rgb(255 255 255 / 0.5); }
  .book-field:has(> .book-input:focus) > label { color: rgb(var(--book-rgb)); }
  .book-field > .book-input { padding: 1.3rem 1rem 0.4rem; line-height: 1.25; }
  @media (prefers-reduced-motion: reduce) { .book-field > label { transition: none; } }
  .book-input {
    display: block;
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font-size: 1rem;   /* 16px: iOS does not zoom into the field */
    line-height: 1.4;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .book-input::placeholder { color: rgb(255 255 255 / 0.45); }
  .book-input:hover { border-color: rgb(255 255 255 / 0.2); }
  .book-input:focus, .book-input:focus-visible { outline: none; border-color: rgb(var(--book-rgb)); background: rgb(0 0 0 / 0.5); box-shadow: 0 0 0 3px rgb(var(--book-rgb) / 0.2); }
  .book-input:user-invalid { border-color: rgb(248 113 113 / 0.7); }
  textarea.book-input { min-height: 5.5rem; resize: vertical; }

  .book-send-row { display: flex; flex-direction: column; align-items: stretch; gap: 0.875rem; margin-top: auto; padding-top: 1rem; }
  @container book-details (min-width: 26rem) {
    .book-send-row { flex-direction: row; align-items: center; }
    /* next to the status line the button keeps one size and one line in every state */
    .book-desk .book-send { flex-shrink: 0; min-width: 13rem; }
  }
  .book-desk .book-send {
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    background-color: rgb(var(--book-rgb));
    font-family: 'Unbounded', sans-serif;
    font-size: 0.875rem;
    box-shadow: 0 16px 32px -14px rgb(var(--book-rgb) / 0.6);
    white-space: normal;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .book-desk .book-send svg { width: 1.125rem; height: 1.125rem; transition: transform 0.25s var(--ease-out, ease-out); }
  .book-desk .book-send:hover { background-color: #fff; box-shadow: 0 16px 32px -14px rgb(255 255 255 / 0.3); }
  .book-desk .book-send:hover svg { transform: translateX(4px); }
  .book-desk .book-send:disabled { opacity: 1; }
  .book-desk[data-state="sending"] .book-send { cursor: progress; }
  .book-desk[data-state="sending"] .book-send svg { animation: book-nudge 0.9s ease-in-out infinite; }
  .book-desk[data-state="sent"] .book-send { background-color: #fff; }
  .book-desk[data-state="error"] .book-send { background-color: #fca5a5; }
  .book-desk[data-state="sent"] .book-send svg, .book-desk[data-state="error"] .book-send svg { display: none; }
  @keyframes book-nudge { 50% { transform: translateX(5px); opacity: 0.35; } }
  .book-status { font-size: 0.875rem; line-height: 1.45; color: rgb(255 255 255 / 0.62); }
  .book-status:empty { display: none; }
  .book-status[data-tone="ok"] { color: #fff; }
  .book-status[data-tone="error"] { color: #fca5a5; }

  .book__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.06);
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.55);
    text-align: center;
  }
  /* the copyright, then the privacy page, the cookie choice and all links */
  .book__bottom > p { text-wrap: balance; }
  .book__legal { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: 1.5rem; }
  .book__legal a, .book__legal button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    color: rgb(255 255 255 / 0.68);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .book__legal a:hover, .book__legal button:hover { color: rgb(var(--accent-rgb)); }
  .book__legal a[aria-current="page"] { color: #fff; }
  .book__go { color: rgb(var(--alt-rgb)); transition: transform 0.2s var(--ease-out, ease-out); }
  .book__legal a:hover .book__go { transform: translateX(3px); }
  @media (pointer: coarse) { .book__legal a, .book__legal button { min-height: 2.75rem; } }
  @media (min-width: 768px) { .book__bottom { flex-direction: row; justify-content: space-between; gap: 2rem; text-align: left; } }

  /* Short laptop and desktop windows: tighter rows, a lower fader and less air
     around the desk, so the heading, the whole desk and the bottom row fit one
     screen (on the home page the footer is the last panel) */
  @media (min-width: 768px) and (max-height: 820px) {
    .book-row { min-height: 0; padding: 0.125rem 0; }
    .book-row__value { min-height: 2.25rem; }
    .book-social { width: 2.25rem; height: 2.25rem; }
    .book-panel { padding: 1.125rem 1.5rem; }
    .book-desk__top { margin-bottom: 0.5rem; }
    .book-night { margin-top: 0.875rem; }
    .book-fader { height: 3.75rem; }
    .book-stop { top: 1.875rem; }
    .book__bottom { margin-top: 1.5rem; padding-top: 0.75rem; }
  }
  @media (min-width: 768px) and (max-height: 720px) {
    .book-panel { padding-block: 1rem; }
    .book-wave { height: 2.25rem; }
    .book-genres { margin-top: 0.5rem; }
    .book__legal a, .book__legal button { min-height: 2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-wave i, .book-fader__slide, .book-fader__win, .book-genres li, .book-pad__face, .book-row__go, .book__go, .book-desk .book-send svg { transition: none; }
    .book-desk[data-state="sending"] .book-send svg { animation: none; }
  }
</style>

<script>
  import { bookingLead, type BookingSide } from '../scripts/booking-set';

  interface Lead { side: BookingSide; set: string; genres: string }

  // Reports a sent booking request. GTM turns booking_form_submit into the GA4
  // generate_lead event and the Google Ads conversion (AW-17997341905), so the
  // Ads conversion is not sent from here. Meta's Lead only goes out when
  // marketing cookies are allowed (Analytics.astro loads the pixel only then).
  // Analytics may still be loading (or blocked), so each call is guarded and
  // none of them can break the form.
  function trackBookingLead(lang: string, lead: Lead) {
    const w = window as any;
    try {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({
        event: 'booking_form_submit',
        form_language: lang,
        booking_side: lead.side,       // 'A' | 'B' | 'any'
        booking_set: lead.set,         // the part of the night, in English
        booking_genres: lead.genres,   // comma-separated
      });
    } catch { /* ignore */ }
    try {
      if (w.zippyConsent?.get()?.marketing && typeof w.fbq === 'function') {
        w.fbq('track', 'Lead', { content_name: 'Booking request', content_category: `side_${lead.side}` });
      }
    } catch { /* ignore */ }
  }

  // The email lists the fields in the order they arrive: who, then what, then the rest.
  const FIRST = ['name', 'email', 'venue', 'side', 'set', 'genres', 'message'];
  const clip = (v: unknown, max: number) => (typeof v === 'string' ? v.replace(/\s+/g, ' ').trim().slice(0, max) : '');
  function payload(form: HTMLFormElement) {
    const all = Object.fromEntries(new FormData(form));
    // Each request gets its own subject, so the inbox shows who and what at a
    // glance and Gmail does not fold every request into one thread:
    // "DJ Zippy — Booking Request · Drugstore · B side, Peak time".
    // (Without JS the form posts the plain subject from its hidden field.)
    const who = clip(all.venue, 60) || clip(all.name, 60);
    const what = [clip(all.side, 40).replace(/\s*\(.*\)$/, ''), clip(all.set, 20)].filter(Boolean).join(', ');
    all.subject = [clip(all.subject, 80), who, what].filter(Boolean).join(' · ');
    const out: Record<string, FormDataEntryValue> = {};
    for (const k of FIRST) if (k in all) out[k] = all[k];
    for (const k of Object.keys(all)) if (!(k in out)) out[k] = all[k];
    return out;
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    // Status copy is rendered per-language onto the form element.
    const sendingText = form.dataset.sending || 'Sending...';
    const sentText = form.dataset.sent || 'Sent ✓';
    const errorText = form.dataset.error || 'Not sent';
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = btn?.querySelector<HTMLElement>('[data-book-send]') ?? btn;
    const status = form.querySelector<HTMLElement>('[data-book-status]');
    const idle = label?.textContent ?? '';
    let timer = 0;

    const say = (text: string, tone: 'ok' | 'error' | '') => {
      if (!status) return;
      status.textContent = text;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!btn || !label || form.dataset.state === 'sending') return;
      // What the request is for, read now: the form is reset once it has gone through.
      const lead = bookingLead(form);
      const lang = (form.elements.namedItem('language') as HTMLInputElement | null)?.value || 'en';
      clearTimeout(timer);
      form.dataset.state = 'sending';
      form.setAttribute('aria-busy', 'true');
      btn.disabled = true;
      label.textContent = sendingText;
      say('', '');
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload(form)),
      })
        .then((res) => {
          form.dataset.state = res.ok ? 'sent' : 'error';
          label.textContent = res.ok ? sentText : errorText;
          say((res.ok ? form.dataset.sentNote : form.dataset.errorNote) || '', res.ok ? 'ok' : 'error');
          if (res.ok) {
            // the visit's attribution outlives one request
            const source = form.elements.namedItem('source') as HTMLInputElement | null;
            const kept = source?.value ?? '';
            form.reset();
            if (source) source.value = kept;
            trackBookingLead(lang, lead);
          }
        })
        .catch(() => {
          form.dataset.state = 'error';
          label.textContent = errorText;
          say(form.dataset.errorNote || '', 'error');
        })
        .finally(() => {
          form.removeAttribute('aria-busy');
          timer = window.setTimeout(() => {
            btn.disabled = false;
            label.textContent = idle;
            delete form.dataset.state;
          }, 4000);
        });
    });
  }
  document.addEventListener('astro:page-load', initContactForm);

  // Wide screens: "03 Details" opens the desk across the panel and folds the
  // direct lines away; the arrow in the desk's top bar brings them back.
  // CSS shows both buttons only from 1024px, and only once this has run.
  function initPanel() {
    const panel = document.querySelector<HTMLElement>('[data-book-panel]');
    if (!panel || panel.dataset.panelBound) return;
    panel.dataset.panelBound = '1';
    const next = panel.querySelector<HTMLButtonElement>('[data-book-next]');
    const back = panel.querySelector<HTMLButtonElement>('[data-book-back]');
    const side = panel.querySelector<HTMLElement>('.book-panel__side');
    if (!next || !back || !side) return;
    const wide = window.matchMedia('(min-width: 1024px)');
    const sync = () => { side.inert = wide.matches && panel.classList.contains('is-open'); };
    const set = (open: boolean) => {
      panel.classList.toggle('is-open', open);
      next.setAttribute('aria-expanded', String(open));
      sync();
      (open ? panel.querySelector<HTMLElement>('#cf-name') : next)?.focus({ preventScroll: true });
    };
    next.addEventListener('click', () => set(true));
    back.addEventListener('click', () => set(false));
    wide.addEventListener('change', sync);
    panel.classList.add('is-ready');
  }
  document.addEventListener('astro:page-load', initPanel);
</script>
