  /* 02 · the night: waveform, fader, genres, line */
  .book-night { margin-top: 1.75rem; }
  .book-wave { display: flex; align-items: center; gap: 2px; height: 3.25rem; }
  .book-wave i {
    flex: 1 1 0;
    min-width: 1px;
    height: var(--hb);
    border-radius: 2px;
    background: rgb(255 255 255 / 0.14);
    transition: height 0.6s var(--ease-out, ease-out), background-color 0.25s;
  }
  .book-desk[data-book-side="A"] .book-wave i { height: var(--ha); }
  .book-wave i.on { background: rgb(var(--book-rgb)); }
  @container book (max-width: 32rem) { .book-wave i:nth-child(even) { display: none; } }

  .book-fader {
    --pos: 50;
    position: relative;
    height: 4.25rem;
    margin-top: 0.375rem;
    /* sideways drags move the fader; vertical swipes still scroll and pinches
       still zoom the page (plain pan-y first, for browsers without pinch-zoom) */
    touch-action: pan-y;
    touch-action: pan-y pinch-zoom;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .book-fader__rail { position: absolute; left: 0; right: 0; top: 1rem; height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.12); overflow: hidden; }
  /* the part of the night being booked, lit on the rail */
  .book-fader__win {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 33.334%;
    border-radius: 4px;
    background: rgb(var(--book-rgb));
    transform: translateX(calc((var(--pos) - 16.667) / 33.334 * 100%));
  }
  .book-fader__ticks { position: absolute; left: 0; right: 0; top: 1.5rem; display: flex; align-items: flex-start; justify-content: space-between; }
  .book-fader__ticks i { width: 1px; height: 4px; background: rgb(255 255 255 / 0.2); }
  .book-fader__ticks i.is-major { height: 8px; background: rgb(255 255 255 / 0.45); }
  /* a zero-size point on the rail that carries the cap (a full-width box moved
     with a transform would stick out past the page edge on phones) */
  .book-fader__slide { position: absolute; left: calc(var(--pos) * 1%); top: calc(1rem + 2px); width: 0; height: 0; transition: left 0.45s var(--ease-out, ease-out); }
  .book-fader__win { transition: transform 0.45s var(--ease-out, ease-out); }
  .book-fader.is-dragging .book-fader__slide, .book-fader.is-dragging .book-fader__win { transition: none; }
  /* a fader cap: dark, ribbed, with a lit centre line */
  .book-fader__cap {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.125rem;
    height: 2.125rem;
    margin: -1.0625rem 0 0 -0.5625rem;
    border-radius: 0.4rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: linear-gradient(180deg, #3b3b3b, #1b1b1b 55%, #262626);
    box-shadow: 0 8px 16px -4px rgb(0 0 0 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.12);
    transition: border-color 0.2s;
  }
  .book-fader__cap::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 5px;
    bottom: 5px;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: rgb(var(--book-rgb));
    box-shadow: 0 0 6px rgb(var(--book-rgb) / 0.8);
  }
  .book-fader:hover .book-fader__cap, .book-fader.is-dragging .book-fader__cap { border-color: rgb(255 255 255 / 0.45); }
  .book-stop {
    position: absolute;
    top: 2.25rem;
    left: calc(var(--at) * 1%);
    transform: translateX(-50%);
    padding: 0.375rem 0.5rem;
    white-space: nowrap;
    cursor: pointer;
  }
  .book-stop__input { position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .book-stop__label { display: block; font-size: 0.6875rem; color: rgb(255 255 255 / 0.55); transition: color 0.2s; }
  .book-stop:hover .book-stop__label { color: #fff; }
  .book-stop__input:checked + .book-stop__label { color: rgb(var(--book-rgb)); }
  .book-stop__input:focus-visible + .book-stop__label { outline: 2px solid #fff; outline-offset: 4px; border-radius: 3px; }
  /* no script: the checked stop places the fader */
  .book-desk:not(.is-live):has([data-stop="0"]:checked) .book-fader { --pos: 16.667; }
  .book-desk:not(.is-live):has([data-stop="2"]:checked) .book-fader { --pos: 83.333; }

  .book-genres { display: flex; align-items: baseline; gap: 0.625rem; margin-top: 0.75rem; }
  .book-genres[hidden] { display: none; }
  .book-genres + .book-genres { margin-top: 0.5rem; }
  .book-genres .book-genres__key { display: none; transform: translateY(0.2rem); }
  .book-desk[data-book-side="any"] .book-genres .book-genres__key { display: inline-flex; }
  .book-genres ul { display: flex; flex-wrap: wrap; row-gap: 0.25rem; font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
  .book-genres li { color: rgb(255 255 255 / 0.75); transition: color 0.25s; }
  /* the slash goes after each genre, so a wrapped line ends on one instead of starting with it */
  .book-genres li:not(:last-child)::after { content: '/'; margin: 0 0.55rem; color: rgb(255 255 255 / 0.16); font-weight: 400; }
  .book-desk.is-live .book-genres li { color: rgb(255 255 255 / 0.45); }
  .book-desk.is-live .book-genres li.on { color: #fff; }
  .book-line { min-height: 2.9em; margin-top: 0.75rem; font-size: 0.9375rem; line-height: 1.45; color: rgb(255 255 255 / 0.78); }
  @container book (max-width: 26rem) { .book-line { min-height: 4.35em; } }
  .book-desk:not(.is-live) .book-line { visibility: hidden; }

  /* 03 · details */
  .book-details { display: flex; flex-direction: column; min-width: 0; }
  .book-details__body { container: book-details / inline-size; display: flex; flex-direction: column; flex: 1; }
  .book-fields { display: flex; flex-direction: column; gap: 1rem; }
  .book-fields__pair { display: grid; gap: 1rem; }
  @container book-details (min-width: 26rem) {
    .book-fields__pair { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0.875rem; }
  }
  .book-field > label { display: block; margin-bottom: 0.5rem; font-size: 0.6875rem; color: rgb(255 255 255 / 0.62); }
  .book-input {
    display: block;
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font-size: 1rem;   /* 16px: iOS does not zoom into the field */
    line-height: 1.4;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .book-input::placeholder { color: rgb(255 255 255 / 0.45); }
  .book-input:hover { border-color: rgb(255 255 255 / 0.2); }
  .book-input:focus, .book-input:focus-visible { outline: none; border-color: rgb(var(--book-rgb)); background: rgb(0 0 0 / 0.5); box-shadow: 0 0 0 3px rgb(var(--book-rgb) / 0.2); }
  .book-input:user-invalid { border-color: rgb(248 113 113 / 0.7); }
  textarea.book-input { min-height: 7.25rem; resize: vertical; }

  .book-send-row { display: flex; flex-direction: column; align-items: stretch; gap: 0.875rem; margin-top: auto; padding-top: 1.5rem; }
  @container book-details (min-width: 26rem) {
    .book-send-row { flex-direction: row; align-items: center; }
    /* next to the status line the button keeps one size and one line in every state */
    .book-desk .book-send { flex-shrink: 0; min-width: 13rem; }
  }
  .book-desk .book-send {
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    background-color: rgb(var(--book-rgb));
    font-family: 'Unbounded', sans-serif;
    font-size: 0.875rem;
    box-shadow: 0 16px 32px -14px rgb(var(--book-rgb) / 0.6);
    white-space: normal;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .book-desk .book-send svg { width: 1.125rem; height: 1.125rem; transition: transform 0.25s var(--ease-out, ease-out); }
  .book-desk .book-send:hover { background-color: #fff; box-shadow: 0 16px 32px -14px rgb(255 255 255 / 0.3); }
  .book-desk .book-send:hover svg { transform: translateX(4px); }
  .book-desk .book-send:disabled { opacity: 1; }
  .book-desk[data-state="sending"] .book-send { cursor: progress; }
  .book-desk[data-state="sending"] .book-send svg { animation: book-nudge 0.9s ease-in-out infinite; }
  .book-desk[data-state="sent"] .book-send { background-color: #fff; }
  .book-desk[data-state="error"] .book-send { background-color: #fca5a5; }
  .book-desk[data-state="sent"] .book-send svg, .book-desk[data-state="error"] .book-send svg { display: none; }
  @keyframes book-nudge { 50% { transform: translateX(5px); opacity: 0.35; } }
  .book-status { font-size: 0.875rem; line-height: 1.45; color: rgb(255 255 255 / 0.62); }
  .book-status:empty { display: none; }
  .book-status[data-tone="ok"] { color: #fff; }
  .book-status[data-tone="error"] { color: #fca5a5; }

  .book__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.06);
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.55);
    text-align: center;
  }
  /* the copyright, then the privacy page, the cookie choice and all links */
  .book__bottom > p { text-wrap: balance; }
  .book__legal { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: 1.5rem; }
  .book__legal a, .book__legal button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    color: rgb(255 255 255 / 0.68);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .book__legal a:hover, .book__legal button:hover { color: rgb(var(--accent-rgb)); }
  .book__legal a[aria-current="page"] { color: #fff; }
  .book__go { color: rgb(var(--alt-rgb)); transition: transform 0.2s var(--ease-out, ease-out); }
  .book__legal a:hover .book__go { transform: translateX(3px); }
  @media (pointer: coarse) { .book__legal a, .book__legal button { min-height: 2.75rem; } }
  @media (min-width: 768px) { .book__bottom { flex-direction: row; justify-content: space-between; gap: 2rem; text-align: left; } }

  @media (prefers-reduced-motion: reduce) {
    .book-wave i, .book-fader__slide, .book-fader__win, .book-genres li, .book-pad__face, .book-row__go, .book__go, .book-desk .book-send svg { transition: none; }
    .book-desk[data-state="sending"] .book-send svg { animation: none; }
  }
</style>

<script>
  import { bookingLead, type BookingSide } from '../scripts/booking-set';

  interface Lead { side: BookingSide; set: string; genres: string }

  // Reports a sent booking request. GTM turns booking_form_submit into the GA4
  // generate_lead event and the Google Ads conversion (AW-17997341905), so the
  // Ads conversion is not sent from here. Meta's Lead only goes out when
  // marketing cookies are allowed (Analytics.astro loads the pixel only then).
  // Analytics may still be loading (or blocked), so each call is guarded and
  // none of them can break the form.
  function trackBookingLead(lang: string, lead: Lead) {
    const w = window as any;
    try {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({
        event: 'booking_form_submit',
        form_language: lang,
        booking_side: lead.side,       // 'A' | 'B' | 'any'
        booking_set: lead.set,         // the part of the night, in English
        booking_genres: lead.genres,   // comma-separated
      });
    } catch { /* ignore */ }
    try {
      if (w.zippyConsent?.get()?.marketing && typeof w.fbq === 'function') {
        w.fbq('track', 'Lead', { content_name: 'Booking request', content_category: `side_${lead.side}` });
      }
    } catch { /* ignore */ }
  }

  // The email lists the fields in the order they arrive: who, then what, then the rest.
  const FIRST = ['name', 'email', 'venue', 'side', 'set', 'genres', 'message'];
  const clip = (v: unknown, max: number) => (typeof v === 'string' ? v.replace(/\s+/g, ' ').trim().slice(0, max) : '');
  function payload(form: HTMLFormElement) {
    const all = Object.fromEntries(new FormData(form));
    // Each request gets its own subject, so the inbox shows who and what at a
    // glance and Gmail does not fold every request into one thread:
    // "DJ Zippy — Booking Request · Drugstore · B side, Peak time".
    // (Without JS the form posts the plain subject from its hidden field.)
    const who = clip(all.venue, 60) || clip(all.name, 60);
    const what = [clip(all.side, 40).replace(/\s*\(.*\)$/, ''), clip(all.set, 20)].filter(Boolean).join(', ');
    all.subject = [clip(all.subject, 80), who, what].filter(Boolean).join(' · ');
    const out: Record<string, FormDataEntryValue> = {};
    for (const k of FIRST) if (k in all) out[k] = all[k];
    for (const k of Object.keys(all)) if (!(k in out)) out[k] = all[k];
    return out;
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    // Status copy is rendered per-language onto the form element.
    const sendingText = form.dataset.sending || 'Sending...';
    const sentText = form.dataset.sent || 'Sent ✓';
    const errorText = form.dataset.error || 'Not sent';
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = btn?.querySelector<HTMLElement>('[data-book-send]') ?? btn;
    const status = form.querySelector<HTMLElement>('[data-book-status]');
    const idle = label?.textContent ?? '';
    let timer = 0;

    const say = (text: string, tone: 'ok' | 'error' | '') => {
      if (!status) return;
      status.textContent = text;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!btn || !label || form.dataset.state === 'sending') return;
      // What the request is for, read now: the form is reset once it has gone through.
      const lead = bookingLead(form);
      const lang = (form.elements.namedItem('language') as HTMLInputElement | null)?.value || 'en';
      clearTimeout(timer);
      form.dataset.state = 'sending';
      form.setAttribute('aria-busy', 'true');
      btn.disabled = true;
      label.textContent = sendingText;
      say('', '');
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload(form)),
      })
        .then((res) => {
          form.dataset.state = res.ok ? 'sent' : 'error';
          label.textContent = res.ok ? sentText : errorText;
          say((res.ok ? form.dataset.sentNote : form.dataset.errorNote) || '', res.ok ? 'ok' : 'error');
          if (res.ok) {
            // the visit's attribution outlives one request
            const source = form.elements.namedItem('source') as HTMLInputElement | null;
            const kept = source?.value ?? '';
            form.reset();
            if (source) source.value = kept;
            trackBookingLead(lang, lead);
          }
        })
        .catch(() => {
          form.dataset.state = 'error';
          label.textContent = errorText;
          say(form.dataset.errorNote || '', 'error');
        })
        .finally(() => {
          form.removeAttribute('aria-busy');
          timer = window.setTimeout(() => {
            btn.disabled = false;
            label.textContent = idle;
            delete form.dataset.state;
          }, 4000);
        });
    });
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
