---
import { getLangFromUrl, useTranslations, localize, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = (Astro.props as Props).lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer id="contact" class="bg-brand-dark pt-12 sm:pt-14 pb-8 border-t border-white/10">
  <div class="max-w-3xl mx-auto px-6 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold mb-3">{t.footer.heading1}<span class="text-brand-orange">{t.footer.heading2}</span></h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-5">
          {t.footer.blurb}
        </p>

        <div class="space-y-2.5 mb-5 text-sm">
          <a href="mailto:veljkoned@gmail.com" class="flex items-center gap-3 hover:text-brand-orange transition-colors">
            <i class="fa-regular fa-envelope text-brand-orange w-4"></i> veljkoned@gmail.com
          </a>
          <a href="https://ra.co/dj/zippy-2" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-brand-orange transition-colors">
            <i class="fa-solid fa-square-poll-vertical text-brand-orange w-4"></i> {t.footer.raProfile}
          </a>
        </div>

        <div class="flex gap-2.5 flex-wrap">
          <a href="https://www.instagram.com/zovumezippy/" target="_blank" rel="me noopener noreferrer" aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-all">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a href="https://www.youtube.com/@zovumezippy/" target="_blank" rel="me noopener noreferrer" aria-label="YouTube"
            class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-all">
            <i class="fa-brands fa-youtube"></i>
          </a>
          <a href="https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle" target="_blank" rel="me noopener noreferrer" aria-label="Spotify"
            class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-all">
            <i class="fa-brands fa-spotify"></i>
          </a>
          <a href="https://www.mixcloud.com/zovumezippy/" target="_blank" rel="me noopener noreferrer" aria-label="MixCloud"
            class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-all">
            <i class="fa-brands fa-mixcloud"></i>
          </a>
          <a href="https://www.deezer.com/en/profile/2582254702" target="_blank" rel="me noopener noreferrer" aria-label="Deezer"
            class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-all">
            <i class="fa-brands fa-deezer"></i>
          </a>
        </div>
      </div>

      <form
        id="contact-form"
        name="contact"
        method="POST"
        class="space-y-4"
        data-sending={t.footer.sending}
        data-sent={t.footer.sent}
        data-error={t.footer.error}
      >
        <input type="hidden" name="access_key" value="53a011ae-cafe-4a90-b080-b4e4d5891262" />
        <input type="hidden" name="subject" value={t.footer.subject} />
        <input type="hidden" name="language" value={lang} />
        <!-- web3forms honeypot: people never see it, bots that tick it get rejected -->
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="cf-name" class="block mb-1 text-[11px] font-semibold uppercase tracking-widest text-gray-400">{t.footer.name}</label>
            <input type="text" id="cf-name" name="name" autocomplete="name" required
              class="w-full bg-transparent border-b border-white/15 pb-2 text-sm text-white focus:border-brand-orange focus:outline-none" />
          </div>
          <div>
            <label for="cf-venue" class="block mb-1 text-[11px] font-semibold uppercase tracking-widest text-gray-400">{t.footer.venue}</label>
            <input type="text" id="cf-venue" name="venue" autocomplete="organization" required
              class="w-full bg-transparent border-b border-white/15 pb-2 text-sm text-white focus:border-brand-orange focus:outline-none" />
          </div>
        </div>

        <div>
          <label for="cf-email" class="block mb-1 text-[11px] font-semibold uppercase tracking-widest text-gray-400">{t.footer.email}</label>
          <input type="email" id="cf-email" name="email" autocomplete="email" inputmode="email" required
            class="w-full bg-transparent border-b border-white/15 pb-2 text-sm text-white focus:border-brand-orange focus:outline-none" />
        </div>

        <div>
          <label for="cf-message" class="block mb-1 text-[11px] font-semibold uppercase tracking-widest text-gray-400">{t.footer.messageLabel}</label>
          <textarea id="cf-message" name="message" rows="3" placeholder={t.footer.message} required
            class="w-full bg-transparent border-b border-white/15 pb-2 text-sm text-white placeholder-gray-500 focus:border-brand-orange focus:outline-none resize-none"></textarea>
        </div>

        <button type="submit"
          class="text-sm text-brand-orange font-bold uppercase tracking-widest border-b border-brand-orange hover:text-white hover:border-white transition-colors pb-1">
          {t.footer.submit}
        </button>
      </form>
    </div>

    <div class="mt-8 pt-5 border-t border-white/5 text-center text-gray-600 text-xs">
      {t.footer.copyright(new Date().getFullYear())}
      <span class="mx-2">|</span>
      <a href={localize('/links', lang)} class="hover:text-brand-orange transition-colors">{t.footer.allLinks} &rarr;</a>
    </div>
  </div>
</footer>

<script>
  // Google Ads conversion label for the booking form: Google Ads → Goals →
  // Conversions → (the booking conversion) → Tag setup, the part after
  // "AW-975400552/". Empty = the Ads conversion is skipped; Meta Lead and the
  // GTM event still fire.
  const ADS_CONVERSION_LABEL = '';

  // Reports a sent booking request to every tracker on the page. Analytics may
  // still be loading (or blocked), so each call is guarded and none of them
  // can break the form.
  function trackBookingLead(lang: string) {
    const w = window as any;
    try {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: 'booking_form_submit', form_language: lang });
    } catch { /* ignore */ }
    try {
      if (typeof w.fbq === 'function') w.fbq('track', 'Lead');
    } catch { /* ignore */ }
    try {
      if (ADS_CONVERSION_LABEL && typeof w.gtag === 'function') {
        w.gtag('event', 'conversion', { send_to: `AW-975400552/${ADS_CONVERSION_LABEL}` });
      }
    } catch { /* ignore */ }
  }

  function initContactForm() {
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form && !form.dataset.bound) {
    form.dataset.bound = '1';
    // Status copy is rendered per-language onto the form element.
    const sendingText = form.dataset.sending || 'Sending...';
    const sentText = form.dataset.sent || 'Sent ✓';
    const errorText = form.dataset.error || 'Error — try veljkoned@gmail.com';
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const btn = this.querySelector('button[type="submit"]') as HTMLButtonElement;
      const orig = btn.innerText;
      btn.disabled = true;
      btn.innerText = sendingText;
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(this))),
      })
      .then(res => {
        btn.innerText = res.ok ? sentText : errorText;
        if (res.ok) {
          const lang = (form.elements.namedItem('language') as HTMLInputElement | null)?.value || 'en';
          form.reset();
          trackBookingLead(lang);
        }
      })
      .catch(() => { btn.innerText = errorText; })
      .finally(() => {
        setTimeout(() => { btn.disabled = false; btn.innerText = orig; }, 4000);
      });
    });
  }
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
