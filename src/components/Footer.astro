---
// The footer of every page (Layout.astro) is the booking desk, "Let's Connect":
// a heading and the direct lines (email, Resident Advisor, socials) next to a
// booking form built like a piece of the dates deck. In the form the visitor
// picks a side (B · underground, A · open format or not sure yet) and slides a
// fader to the part of the night; the genres for that side and that part light
// up. Behaviour: src/scripts/booking-set.ts (the set) and the script at the
// bottom (sending). Without JS the radios still carry the side and the part of
// the night, and the form posts straight to web3forms.
import { getLangFromUrl, useTranslations, localize, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = (Astro.props as Props).lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// What goes out in the email and to analytics stays English in both languages.
const en = useTranslations('en');

const EMAIL = 'veljkoned@gmail.com';
const privacyHref = localize('/privacy', lang);
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';

const sidePads = [
  { key: 'B', value: 'B side (underground)', short: t.sides.b, name: t.sides.bLabel, note: t.footer.sideBNote },
  { key: 'A', value: 'A side (open format)', short: t.sides.a, name: t.sides.aLabel, note: t.footer.sideANote },
] as const;

// Three stops on the fader, each in the middle of its third of the night.
const parts = [
  { label: t.room.warmup, value: en.room.warmup, at: 100 / 6 },
  { label: t.room.peak, value: en.room.peak, at: 50 },
  { label: t.room.closing, value: en.room.closing, at: 500 / 6 },
];
const START = 1;   // peak time

// The night as a waveform, one shape per side: B builds to the peak and stays
// deep through the closing, A keeps climbing to a singalong finish. Fixed noise
// gives the bars their texture. Heights are % of the strip; CSS picks the
// side's set and morphs between them when the side changes.
const BARS = 64;
type Env = [number, number][];
const B_ENV: Env = [[0, 0.2], [0.18, 0.38], [0.33, 0.55], [0.45, 0.88], [0.58, 1], [0.7, 0.88], [0.82, 0.74], [1, 0.6]];
const A_ENV: Env = [[0, 0.26], [0.18, 0.44], [0.33, 0.56], [0.5, 0.72], [0.66, 0.8], [0.78, 0.9], [0.9, 1], [1, 0.9]];
function envelope(keys: Env, u: number) {
  for (let k = 1; k < keys.length; k++) {
    const [x0, y0] = keys[k - 1];
    const [x1, y1] = keys[k];
    if (u <= x1) {
      const s = (u - x0) / (x1 - x0);
      return y0 + (y1 - y0) * s * s * (3 - 2 * s);
    }
  }
  return keys[keys.length - 1][1];
}
const bars = Array.from({ length: BARS }, (_, i) => {
  const u = (i + 0.5) / BARS;
  const noise = Math.abs(Math.sin(i * 0.9)) * 0.5 + Math.abs(Math.sin(i * 0.37)) * 0.3 + Math.abs(Math.sin(i * 2.3)) * 0.2;
  const k = 0.55 + 0.45 * noise;
  const pct = (v: number) => `${Math.round(Math.max(0.1, v * k) * 100)}%`;
  return `--hb:${pct(envelope(B_ENV, u))};--ha:${pct(envelope(A_ENV, u))}`;
});

const strings = {
  sides: { B: t.sides.b, A: t.sides.a, any: t.footer.sideAny },
  lines: { B: t.room.B.lines, A: t.room.A.lines, any: t.room.anyLine },
};

const socials = [
  { href: 'https://www.instagram.com/zovumezippy/', label: 'Instagram', icon: 'fa-instagram' },
  { href: 'https://www.youtube.com/@zovumezippy/', label: 'YouTube', icon: 'fa-youtube' },
  { href: 'https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle', label: 'Spotify', icon: 'fa-spotify' },
  { href: 'https://www.mixcloud.com/zovumezippy/', label: 'MixCloud', icon: 'fa-mixcloud' },
  { href: 'https://www.deezer.com/en/profile/2582254702', label: 'Deezer', icon: 'fa-deezer' },
];
---

<footer id="contact" class="book" aria-labelledby="contact-heading">
  <div class="container mx-auto px-6 sm:px-8 lg:px-12">
    <div class="max-w-6xl mx-auto">
      <div class="book__grid">
        <div class="book__intro" data-reveal>
          <p class="eyebrow">{t.footer.kicker}</p>
          <h2 id="contact-heading" class="section-title mt-3">{t.footer.heading1}<span class="text-brand-orange">{t.footer.heading2}</span></h2>
          <p class="book__blurb">{t.footer.blurb}</p>
        </div>

        {/* the direct lines come before the form in the page, as they do on wider
            screens (beside the heading), so the keyboard follows the screen there;
            phones show the form first and the direct lines under it */}
        <div class="book__direct">
          <ul class="book-rows">
            <li class="book-row">
              <span class="book-row__label mono-caps">{t.footer.emailShort}</span>
              <a class="book-row__value" href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <button type="button" class="book-row__copy" data-copy={EMAIL} data-copied={t.footer.copied} aria-label={t.footer.copyLabel} title={t.footer.copyLabel} hidden>
                <svg class="is-idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" /></svg>
                <svg class="is-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              </button>
              <span class="sr-only" data-copy-status aria-live="polite"></span>
            </li>
            <li class="book-row">
              <span class="book-row__label mono-caps">{t.footer.profile}</span>
              <a class="book-row__value" href="https://ra.co/dj/zippy-2" target="_blank" rel="noopener noreferrer" title={t.footer.raProfile}>
                Resident Advisor
                <svg class="book-row__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
              </a>
            </li>
            <li class="book-row book-row--social">
              <span class="book-row__label mono-caps">{t.footer.follow}</span>
              <span class="book-socials">
                {socials.map((s) => (
                  <a href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={s.label} class="book-social">
                    <i class={`fa-brands ${s.icon}`} aria-hidden="true"></i>
                  </a>
                ))}
              </span>
            </li>
          </ul>
        </div>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          action="https://api.web3forms.com/submit"
          class="book-desk"
          aria-labelledby="cf-title"
          data-astro-reload
          data-reveal
          data-book-strings={JSON.stringify(strings)}
          data-sending={t.footer.sending}
          data-sent={t.footer.sent}
          data-error={t.footer.error}
          data-sent-note={t.footer.sentNote}
          data-error-note={t.footer.errorNote}
        >
          <input type="hidden" name="access_key" value="53a011ae-cafe-4a90-b080-b4e4d5891262" />
          <input type="hidden" name="subject" value={t.footer.subject} />
          <input type="hidden" name="language" value={lang} />
          <!-- where the visit came from; filled in by the attribution script -->
          <input type="hidden" name="source" value="" data-attribution />
          <!-- web3forms honeypot: people never see it, bots that tick it get rejected -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="book-desk__top mono-caps">
            <span id="cf-title" class="book-desk__title"><span class="book-led" aria-hidden="true"></span>{t.footer.deskTitle}</span>
            <span class="book-readout" data-book-readout aria-hidden="true">{t.sides.b} · {t.room.peak}</span>
          </div>

          <div class="book-desk__body">
            <div class="book-set">
              <fieldset class="book-group">
                <legend class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">01</span>{t.footer.sideLabel}</legend>
                <div class="book-sides">
                  {sidePads.map((o) => (
                    <label class="book-pad" data-side={o.key}>
                      <input type="radio" name="side" value={o.value} data-side-choice={o.key} checked={o.key === 'B'} class="book-pad__input" />
                      <span class="book-pad__face">
                        <span class="side-key" aria-hidden="true">{o.key}</span>
                        <span class="book-pad__text">
                          <span class="sr-only">{o.short}: </span>
                          <span class="book-pad__name">{o.name}</span>
                          <span class="book-pad__note">{o.note}</span>
                        </span>
                      </span>
                    </label>
                  ))}
                  <label class="book-pad book-pad--any">
                    <input type="radio" name="side" value="Not sure yet" data-side-choice="any" class="book-pad__input" />
                    <span class="book-pad__face">
                      <span class="side-key book-pad__both" aria-hidden="true"><span>A</span><span>B</span></span>
                      <span class="book-pad__name">{t.footer.sideAny}</span>
                    </span>
                  </label>
                </div>
              </fieldset>

              <fieldset class="book-group book-night">
                <legend class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">02</span>{t.room.title}</legend>
                <div class="book-wave" data-book-wave aria-hidden="true">
                  {bars.map((style) => <i style={style}></i>)}
                </div>
                <div class="book-fader" data-book-fader title={t.room.faderLabel}>
                  <span class="book-fader__rail" aria-hidden="true"><i class="book-fader__win"></i></span>
                  <span class="book-fader__ticks" aria-hidden="true">
                    {Array.from({ length: 13 }, (_, i) => <i class={i % 4 === 2 ? 'is-major' : undefined}></i>)}
                  </span>
                  <span class="book-fader__slide" aria-hidden="true"><span class="book-fader__cap"></span></span>
                  {parts.map((p, i) => (
                    <label class="book-stop" style={`--at:${p.at.toFixed(3)}`}>
                      <input type="radio" name="set" value={p.value} data-stop={i} data-at={p.at.toFixed(3)} checked={i === START} class="book-stop__input" />
                      <span class="book-stop__label mono-caps">{p.label}</span>
                    </label>
                  ))}
                </div>
                {(['B', 'A'] as const).map((side) => (
                  <div class="book-genres" data-book-genres={side} data-side={side} hidden={side !== 'B'}>
                    <span class="side-key book-genres__key" aria-hidden="true">{side}</span>
                    <ul aria-label={`${side === 'A' ? t.sides.a : t.sides.b} · ${t.room.genresLabel}`}>
                      {t.room[side].genres.map((g, i) => <li data-genre={en.room[side].genres[i]}>{g}</li>)}
                    </ul>
                  </div>
                ))}
                <p class="book-line" data-book-line>{t.room.B.lines[START]}</p>
                <input type="hidden" name="genres" value="" disabled />
              </fieldset>
            </div>

            <div class="book-details" role="group" aria-labelledby="cf-details">
              <p id="cf-details" class="book-step mono-caps"><span class="book-step__n" aria-hidden="true">03</span>{t.footer.detailsLabel}</p>
              <div class="book-details__body">
                <div class="book-fields">
                  <div class="book-fields__pair">
                    <div class="book-field">
                      <label for="cf-name" class="mono-caps">{t.footer.name}</label>
                      <input type="text" id="cf-name" name="name" autocomplete="name" enterkeyhint="next" required class="book-input" />
                    </div>
                    <div class="book-field">
                      <label for="cf-email" class="mono-caps">{t.footer.email}</label>
                      <input type="email" id="cf-email" name="email" autocomplete="email" inputmode="email" enterkeyhint="next" required class="book-input" />
                    </div>
                  </div>
                  <div class="book-field">
                    <label for="cf-venue" class="mono-caps">{t.footer.venue}</label>
                    <input type="text" id="cf-venue" name="venue" autocomplete="organization" enterkeyhint="next" required class="book-input" />
                  </div>
                  <div class="book-field book-field--grow">
                    <label for="cf-message" class="mono-caps">{t.footer.messageLabel}</label>
                    <textarea id="cf-message" name="message" rows="4" placeholder={t.footer.message} required class="book-input"></textarea>
                  </div>
                </div>
                <div class="book-send-row">
                  <button type="submit" class="btn btn--primary book-send">
                    <span data-book-send>{t.footer.submit}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </button>
                  <p class="book-status" data-book-status role="status" aria-live="polite"></p>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <div class="book__bottom">
        <p>{t.footer.copyright(new Date().getFullYear())}</p>
        {/* the privacy page and the way back to the cookie choice, on every page
            (CookieConsent.astro opens itself for any [data-consent-open]) */}
        <div class="book__legal">
          <a href={privacyHref} aria-current={here === privacyHref ? 'page' : undefined}>{t.footer.privacy}</a>
          <button type="button" data-consent-open>{t.footer.cookieSettings}</button>
          <a href={localize('/links', lang)}>{t.footer.allLinks} <span class="book__go" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* === The booking desk (Footer.astro) ===
     The form is a panel from the same family as the dates deck. Its colour
     follows the side picked in it (--book-rgb), and the other side's colour
     (--book-alt-rgb) marks the small details, so a B request stays orange with
     touches of blue and an A request turns it around. */
  .book {
    position: relative;
    isolation: isolate;
    padding: 4rem 0 2rem;
    background: var(--bg, #050505);
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }
  /* the hero's lighting once more: a warm key light on the left, a cool rim on the right */
  .book::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: min(36rem, 100%);
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 70% at 8% 0%, rgb(var(--accent-rgb) / 0.12), transparent 70%),
      radial-gradient(ellipse 34% 50% at 96% 0%, rgb(var(--alt-rgb) / 0.08), transparent 70%);
  }
  @media (min-width: 640px) { .book { padding-top: 5.5rem; } }
  /* While the cookie card (CookieConsent.astro) is open it covers the bottom of
     the screen; room under the footer lets the send button and the bottom row
     still scroll up above it. */
  :root:has([data-consent]:not([hidden])) .book { padding-bottom: 21rem; }

  .book__grid { display: grid; gap: 2.5rem; grid-template-areas: "intro" "desk" "direct"; }
  .book__intro { grid-area: intro; }
  .book__direct { grid-area: direct; }
  @media (min-width: 768px) {
    .book__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "intro direct" "desk desk";
      column-gap: 3rem;
      row-gap: 2.5rem;
      align-items: end;
    }
  }
  @media (min-width: 1024px) { .book__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .book__blurb { max-width: 34rem; margin-top: 1rem; font-size: 1rem; line-height: 1.6; color: rgb(255 255 255 / 0.62); text-wrap: pretty; }
  @media (min-width: 640px) { .book__blurb { font-size: 1.0625rem; } }

  /* Direct lines: a small spec sheet, label on the left */
  .book-rows { border-top: 1px solid var(--line, rgb(255 255 255 / 0.09)); }
  .book-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--line, rgb(255 255 255 / 0.09));
  }
  .book-row__label { flex: 0 0 4rem; font-size: 0.6875rem; color: rgb(255 255 255 / 0.55); }
  /* the link fills the height of its row: a comfortable target for a thumb */
  .book-row__value {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #fff;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .book-row__value:hover { color: rgb(var(--accent-rgb)); }
  .book-row__go { width: 0.875rem; height: 0.875rem; flex-shrink: 0; color: rgb(var(--alt-rgb)); transition: transform 0.2s var(--ease-out, ease-out); }
  .book-row__value:hover .book-row__go { transform: translate(2px, -2px); }
  .book-row__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.6);
    transition: color 0.2s, border-color 0.2s;
  }
  .book-row__copy[hidden] { display: none; }
  .book-row__copy svg { width: 0.9rem; height: 0.9rem; }
  .book-row__copy .is-ok, .book-row__copy.is-done .is-idle { display: none; }
  .book-row__copy.is-done .is-ok { display: block; }
  .book-row__copy:hover { color: #fff; border-color: rgb(255 255 255 / 0.3); }
  .book-row__copy.is-done { color: rgb(var(--alt-rgb)); border-color: rgb(var(--alt-rgb) / 0.5); }
  /* phones open the mail app instead, and copy with a long press */
  @media (hover: none) { .book-row__copy { display: none; } }
  .book-socials { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .book-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.8);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .book-social:hover { color: #050505; background: rgb(var(--accent-rgb)); border-color: rgb(var(--accent-rgb)); }
  @media (pointer: coarse) { .book-social { width: 2.75rem; height: 2.75rem; } }

  /* The desk */
  .book-desk {
    --book-rgb: var(--side-b-rgb);
    --book-alt-rgb: var(--side-a-rgb);
    grid-area: desk;
    container: book / inline-size;
    position: relative;
    padding: 1.125rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line, rgb(255 255 255 / 0.09));
    background: linear-gradient(180deg, #141414, #0b0b0b);
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.95), inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .book-desk[data-book-side="A"] { --book-rgb: var(--side-a-rgb); --book-alt-rgb: var(--side-b-rgb); }
  .book-desk[data-book-side="any"] { --book-rgb: var(--accent-rgb); --book-alt-rgb: var(--alt-rgb); }
  /* before the script runs (or without it) the checked pad sets the colours */
  .book-desk:not([data-book-side]):has(input[data-side-choice="A"]:checked) { --book-rgb: var(--side-a-rgb); --book-alt-rgb: var(--side-b-rgb); }
  .book-desk:not([data-book-side]):has(input[data-side-choice="any"]:checked) { --book-rgb: var(--accent-rgb); --book-alt-rgb: var(--alt-rgb); }
  /* a wash of the side's colour from the top left, like a lit display */
  .book-desk::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse 70% 50% at 10% 0%, rgb(var(--book-rgb) / 0.1), transparent 70%);
  }
  .book-desk > * { position: relative; }
  @media (min-width: 640px) { .book-desk { padding: 1.75rem; } }

  .book-desk__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.6875rem; color: rgb(255 255 255 / 0.62); }
  .book-led {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: rgb(var(--book-rgb));
    box-shadow: 0 0 8px 1px rgb(var(--book-rgb));
    vertical-align: 1px;
  }
  .book-readout { color: rgb(var(--book-rgb)); text-align: right; }
  @container book (max-width: 26rem) { .book-readout { display: none; } }

  .book-desk__body { display: grid; gap: 2.25rem; }
  @container book (min-width: 50rem) {
    .book-desk__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; }
    .book-set { padding-right: 2.25rem; }
    .book-details { padding-left: 2.25rem; border-left: 1px solid rgb(255 255 255 / 0.07); }
    /* side by side with the set, the message box takes up the spare height */
    .book-fields { flex: 1; }
    .book-field--grow { flex: 1; display: flex; flex-direction: column; }
    .book-field--grow > .book-input { flex: 1; }
  }
  .book-group { min-width: 0; margin: 0; padding: 0; border: 0; }
  .book-step { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.875rem; padding: 0; font-size: 0.6875rem; color: rgb(255 255 255 / 0.62); }
  .book-step__n { color: rgb(var(--book-alt-rgb)); }

  /* 01 · the side pads */
  .book-sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; }
  .book-pad { position: relative; display: block; cursor: pointer; }
  .book-pad--any { grid-column: 1 / -1; --side: rgb(var(--accent-rgb)); }
  .book-pad__input { position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .book-pad__face {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: 0.875rem;
    border-radius: 1rem;
    border: 1px solid var(--line, rgb(255 255 255 / 0.09));
    background: rgb(255 255 255 / 0.035);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  /* each pad has an LED that lights in its side's colour when picked */
  .book-pad__face::after {
    content: '';
    position: absolute;
    top: 1.1rem;
    right: 0.9rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    transition: background-color 0.2s, box-shadow 0.2s;
  }
  .book-pad:hover .book-pad__face { border-color: rgb(255 255 255 / 0.24); background: rgb(255 255 255 / 0.055); }
  .book-pad__input:checked + .book-pad__face { border-color: var(--side); background: rgb(255 255 255 / 0.07); box-shadow: inset 0 0 0 1px var(--side); }
  .book-pad__input:checked + .book-pad__face::after { background: var(--side); box-shadow: 0 0 8px 1px var(--side); }
  .book-pad__input:focus-visible + .book-pad__face { outline: 2px solid #fff; outline-offset: 2px; }
  .book-pad__face > .side-key { margin-bottom: 0.875rem; }
  .book-pad__text { display: flex; flex-direction: column; min-width: 0; }
  .book-pad__name { font-size: 0.9375rem; font-weight: 600; line-height: 1.25; color: #fff; }
  .book-pad__note { margin-top: 0.25rem; font-size: 0.75rem; line-height: 1.35; color: rgb(255 255 255 / 0.55); }
  .book-pad--any .book-pad__face { flex-direction: row; align-items: center; gap: 0.75rem; padding: 0.625rem 2rem 0.625rem 0.875rem; }
  .book-pad--any .book-pad__face::after { top: 50%; margin-top: -3.5px; }
  .book-pad--any .book-pad__face > .side-key { margin: 0; }
  .book-pad--any .book-pad__name { font-size: 0.875rem; font-weight: 500; color: rgb(255 255 255 / 0.8); }
  .book-pad--any .book-pad__input:checked + .book-pad__face .book-pad__name { color: #fff; }
  /* "not sure yet": a key that is half of each side */
  .book-pad .book-pad__both { width: auto; padding: 0; overflow: hidden; background: none; }
  .book-pad__both span { display: inline-flex; align-items: center; justify-content: center; width: 1.125rem; height: 100%; }
  .book-pad__both span:first-child { background: var(--side-a); }
  .book-pad__both span:last-child { background: var(--side-b); }
  /* a narrow desk: one pad per row, key on the left */
  @container book (max-width: 24rem) {
    .book-sides { grid-template-columns: minmax(0, 1fr); }
    .book-pad__face { flex-direction: row; align-items: center; gap: 0.75rem; padding: 0.75rem 2rem 0.75rem 0.875rem; }
    .book-pad__face::after { top: 50%; margin-top: -3.5px; }
    .book-pad__face > .side-key { margin: 0; }
