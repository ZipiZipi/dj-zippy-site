---
// Standalone link-in-bio page — no site nav or footer, and no Tailwind, so the
// language toggle here is styled with the page's own CSS rather than reusing
// <LanguageSwitcher />.
import Analytics from '../Analytics.astro';
import { useTranslations, localize, alternateLinks, htmlLang, ogLocale, type Lang } from '../../i18n/utils';
import '../../styles/fonts.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const canonical = `https://zippydj.com${l('/links')}`;
const alternates = alternateLinks(Astro.url, Astro.site ?? new URL('https://zippydj.com'));
const xDefault = alternates.find((a) => a.lang === 'en')!.href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.links.title}</title>
    <meta name="description" content={t.links.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <!-- Open Graph -->
    <meta property="og:title" content={t.links.title} />
    <meta property="og:description" content={t.links.ogDescription} />
    <meta property="og:image" content="https://zippydj.com/images/og-dj-zippy.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.schema.ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DJ Zippy" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.links.title} />
    <meta name="twitter:description" content={t.links.twitterDescription} />
    <meta name="twitter:image" content="https://zippydj.com/images/og-dj-zippy.jpg" />
    <meta name="twitter:image:alt" content={t.schema.ogImageAlt} />
    <!-- Self-hosted fonts (src/styles/fonts.css) + the above-the-fold portrait -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/unbounded/unbounded-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter/inter-latin.woff2" crossorigin />
    <link rel="preload" as="image" href="/images/dj-zippy-house-music-dj.webp" fetchpriority="high" />
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Zippy" />
    <!-- Meta Pixel + GTM + Google Ads (deferred, see Analytics.astro) -->
    <Analytics />
    <link rel="stylesheet" href="/fonts/fa/fa-subset.css" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --orange: #ff5500;
        --orange-fill: #cc4400;
      }

      html { overflow-x: hidden; }
      body {
        background: #000;
        color: #fff;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 0;
        position: relative;
        overflow-x: hidden;
      }

      /* === Background video === */
      .bg-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
        object-fit: cover;
        object-position: center;
        z-index: -2;
        pointer-events: none;
      }
      .bg-overlay {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(130% 90% at 50% 0%, rgba(0,0,0,0.30), transparent 55%),
          linear-gradient(180deg,
            rgba(8,8,10,0.62) 0%,
            rgba(8,8,10,0.40) 30%,
            rgba(8,8,10,0.46) 64%,
            rgba(4,4,6,0.86) 100%);
        backdrop-filter: saturate(115%);
        -webkit-backdrop-filter: saturate(115%);
      }

      main {
        width: 100%;
        max-width: 488px;          /* ~440 card area + 24px gutter each side */
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        padding: 84px 24px 56px;   /* gutter lives here, so cards never touch edges */
        position: relative;
        z-index: 1;
      }
      @media (min-width: 640px) {
        main { max-width: 496px; padding: 108px 28px 64px; }
      }

      /* === Language toggle ===
         Segmented control: the track has its own inner padding, so the globe and
         the pills sit inside the rounded edge instead of running into its curve. */
      .lang-switch {
        position: absolute;
        top: 20px;
        right: 24px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 4px;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        background: rgba(14,14,17,0.55);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      .lang-switch > .globe { display: flex; padding: 0 6px 0 8px; color: rgba(255,255,255,0.45); font-size: 0.8rem; }
      .lang-switch a {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
        transition: color 0.3s, background 0.3s;
      }
      /* 40px tap target on touch screens, spilling into the track's padding */
      @media (pointer: coarse) {
        .lang-switch a::after { content: ''; position: absolute; inset: -4px -1px; }
      }
      .lang-switch a:hover { color: #fff; background: rgba(255,255,255,0.1); }
      .lang-switch a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
      .lang-switch a[aria-current] { background: var(--orange); color: #000; }
      @media (min-width: 640px) {
        .lang-switch { top: 28px; right: 28px; }
      }

      /* === Profile header === */
      header { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
      .avatar-ring {
        padding: 3px;
        border-radius: 50%;
        background: conic-gradient(from 210deg, var(--orange), #ff8a4c, var(--orange));
        box-shadow: 0 14px 44px rgba(0,0,0,0.6), 0 0 30px rgba(255,85,0,0.18);
      }
      header img {
        display: block;
        width: 108px; height: 108px;
        border-radius: 50%;
        border: 3px solid rgba(8,8,10,0.9);
        object-fit: cover;
      }
      header h1 {
        font-family: 'Unbounded', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 24px rgba(0,0,0,0.6);
      }
      header p {
        color: #d8d8de;
        font-size: 1.05rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-shadow: 0 2px 16px rgba(0,0,0,0.7);
      }

      section { width: 100%; display: flex; flex-direction: column; gap: 11px; }
      .section-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 6px;
        padding-left: 4px;
        color: rgba(255,255,255,0.5);
        text-shadow: 0 1px 10px rgba(0,0,0,0.7);
      }

      /* === Glass cards === */
      a.link-primary,
      a.link-secondary {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        text-decoration: none;
        border-radius: 15px;
        -webkit-backdrop-filter: blur(16px) saturate(135%);
        backdrop-filter: blur(16px) saturate(135%);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                    border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
      }

      a.link-primary {
        padding: 16px 22px;
        font-weight: 500;
        color: #fff;
        background: rgba(22, 22, 26, 0.46);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 6px 26px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255,255,255,0.05);
      }
      a.link-primary i { color: var(--orange); width: 22px; font-size: 1.1rem; flex-shrink: 0; text-align: center; transition: color 0.3s; }

      a.link-secondary {
        padding: 13px 22px;
        font-size: 0.9rem;
        font-weight: 500;
        color: #e2e2e7;
        background: rgba(14, 14, 17, 0.42);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
      }
      a.link-secondary i { width: 20px; flex-shrink: 0; text-align: center; color: #cfcfd6; transition: color 0.3s; }

      /* Orange fill on hover/focus/tap. #cc4400 keeps white text at 4.7:1
         (plain #ff5500 is only 3.2:1); the brighter #ff5500 lives in the border and glow. */
      a.link-primary,
      a.link-secondary,
      a.link-site { -webkit-tap-highlight-color: transparent; }

      a.link-primary:focus-visible,
      a.link-primary:active {
        color: #fff;
        background: var(--orange-fill);
        border-color: var(--orange);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgba(255, 85, 0, 0.45);
      }
      a.link-secondary:focus-visible,
      a.link-secondary:active {
        color: #fff;
        background: rgba(204, 68, 0, 0.88);
        border-color: rgba(255, 85, 0, 0.9);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px rgba(255, 85, 0, 0.35);
      }
      a.link-primary:focus-visible i, a.link-primary:active i,
      a.link-secondary:focus-visible i, a.link-secondary:active i { color: #fff; }
      a.link-primary:focus-visible, a.link-secondary:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      a.link-primary:active, a.link-secondary:active { transform: scale(0.98); transition-duration: 0.1s; }

      @media (hover: hover) {
        a.link-primary:hover {
          transform: translateY(-2px);
          color: #fff;
          background: var(--orange-fill);
          border-color: var(--orange);
          box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgba(255, 85, 0, 0.45);
        }
        a.link-secondary:hover {
          transform: translateY(-2px);
          color: #fff;
          background: rgba(204, 68, 0, 0.88);
          border-color: rgba(255, 85, 0, 0.9);
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px rgba(255, 85, 0, 0.35);
        }
        a.link-primary:hover i, a.link-secondary:hover i { color: #fff; }
        a.link-primary:active:hover, a.link-secondary:active:hover { transform: scale(0.98); }
      }

      /* === Site nav (minimal) === */
      a.link-site {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 9px 16px;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        border-radius: 11px;
        transition: color 0.3s, background 0.3s;
      }
      a.link-site i { width: 16px; flex-shrink: 0; text-align: center; }
      a.link-site .arrow { margin-left: auto; font-size: 0.75rem; opacity: 0; transition: opacity 0.3s, transform 0.3s; transform: translateX(-4px); }
      a.link-site:focus-visible,
      a.link-site:active { color: var(--orange); background: rgba(255,85,0,0.08); }
      a.link-site:focus-visible .arrow,
      a.link-site:active .arrow { opacity: 1; transform: translateX(0); }
      @media (hover: hover) {
        a.link-site:hover { color: var(--orange); background: rgba(255,85,0,0.08); }
        a.link-site:hover .arrow { opacity: 1; transform: translateX(0); }
      }

      .divider {
        width: 56px;
        height: 1px;
        border: none;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
        margin: 2px auto;
      }

      footer { text-align: center; display: flex; flex-direction: column; gap: 6px; padding-top: 12px; }
      footer p, footer a { font-size: 0.8rem; color: rgba(255,255,255,0.45); text-decoration: none; }
      footer a:hover { color: #fff; }

      /* === Subtle entrance === */
      @keyframes rise {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: none; }
      }
      main > * { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
      main > *:nth-child(1) { animation-delay: 0.04s; }
      main > *:nth-child(2) { animation-delay: 0.12s; }
      main > *:nth-child(3) { animation-delay: 0.18s; }
      main > *:nth-child(4) { animation-delay: 0.24s; }
      main > *:nth-child(5) { animation-delay: 0.30s; }
      main > *:nth-child(6) { animation-delay: 0.36s; }
      main > *:nth-child(7) { animation-delay: 0.42s; }

      @media (prefers-reduced-motion: reduce) {
        main > * { animation: none; }
        a.link-primary, a.link-secondary { transition: border-color 0.3s, background 0.3s, color 0.3s; }
        a.link-primary:hover, a.link-secondary:hover,
        a.link-primary:active, a.link-secondary:active { transform: none; }
      }
    </style>
  </head>
  <body>
    <!-- GTM noscript -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KLGKHMGM" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Background video (540×960, ~0.7 MB, no audio). The poster is its own
         first frame, so the hand-off is seamless. The source is attached by the
         script below — skipped on Save-Data / 2G, where the poster stays. -->
    <video
      class="bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster="/videos/links-bg-poster.jpg"
      data-src="/videos/links-bg.mp4"
      aria-hidden="true"
    ></video>
    <script is:inline>
      (function () {
        var v = document.querySelector('.bg-video');
        var c = navigator.connection || {};
        if (!v || c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
        v.src = v.getAttribute('data-src');
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      })();
    </script>
    <div class="bg-overlay" aria-hidden="true"></div>

    <div class="lang-switch" role="group" aria-label={t.langSwitch.label}>
      <span class="globe" aria-hidden="true"><i class="fa-solid fa-globe"></i></span>
      <a href="/links" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      <a href="/sr/links" hreflang="sr-Latn" aria-current={lang === 'sr' ? 'true' : undefined}>SR</a>
    </div>

    <main>

      <!-- Profile Header -->
      <header>
        <div class="avatar-ring">
          {/* Above the fold and the only real image on the page, so it is
              preloaded and loads eagerly at high priority — otherwise it queues
              behind the background video and the ring sits empty for a beat. */}
          <img
            src="/images/dj-zippy-house-music-dj.webp"
            alt={t.links.avatarAlt}
            width="108"
            height="108"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div>
          <h1>Zippy</h1>
          <p>{t.links.tagline}</p>
        </div>
      </header>

      <!-- Main Links -->
      <section aria-label={t.links.mainLabel}>
        <p class="section-label">{t.links.streamFollow}</p>

        <a href={`https://zippydj.com${l('/')}`} class="link-primary">
          <i class="fa-solid fa-globe"></i>
          <span>{t.links.website}</span>
        </a>

        <a href="https://www.instagram.com/zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-instagram"></i>
          <span>Instagram</span>
        </a>

        <a href="https://www.youtube.com/@zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-youtube"></i>
          <span>{t.links.youtube}</span>
        </a>

        <a href="https://www.mixcloud.com/zovumezippy/" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-mixcloud"></i>
          <span>{t.links.mixcloud}</span>
        </a>

        <a href="https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-spotify"></i>
          <span>Spotify</span>
        </a>
      </section>

      <hr class="divider" />

      <!-- Secondary Links -->
      <section aria-label={t.links.secondaryLabel}>
        <p class="section-label">{t.links.alsoOn}</p>

        <a href="https://soundcloud.com/zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-soundcloud"></i>
          <span>SoundCloud</span>
        </a>

        <a href="https://www.deezer.com/en/profile/2582254702" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-deezer"></i>
          <span>Deezer</span>
        </a>

        <a href="https://www.tiktok.com/@zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-tiktok"></i>
          <span>TikTok</span>
        </a>

        <a href="https://ra.co/dj/zippy-2" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-solid fa-square-poll-vertical"></i>
          <span>Resident Advisor</span>
        </a>
      </section>

      <hr class="divider" />

      <!-- Site Navigation -->
      <section aria-label={t.links.navLabel}>
        <p class="section-label">{t.links.explore}</p>

        <a href={l('/events')} class="link-site">
          <i class="fa-solid fa-calendar"></i>
          <span>{t.links.events}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={l('/about')} class="link-site">
          <i class="fa-solid fa-user"></i>
          <span>{t.links.about}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={l('/mixes')} class="link-site">
          <i class="fa-solid fa-music"></i>
          <span>{t.links.mixes}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={`${l('/')}#contact`} class="link-site">
          <i class="fa-solid fa-envelope"></i>
          <span>{t.links.contact}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>
      </section>

      <!-- Footer -->
      <footer>
        <p>{t.links.copyright(new Date().getFullYear())}</p>
        <a href={`https://zippydj.com${l('/')}`}>{t.links.visit}</a>
      </footer>

    </main>
  </body>
</html>
