---
// Standalone link-in-bio page — no site nav or footer, and no Tailwind, so the
// language toggle here is styled with the page's own CSS rather than reusing
// <LanguageSwitcher />.
import Analytics from '../Analytics.astro';
import CookieConsent from '../CookieConsent.astro';
import { useTranslations, localize, alternateLinks, htmlLang, ogLocale, languages, type Lang } from '../../i18n/utils';
import '../../styles/fonts.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const canonical = `https://zippydj.com${l('/links')}`;
const alternates = alternateLinks(Astro.url, Astro.site ?? new URL('https://zippydj.com'));
const xDefault = alternates.find((a) => a.lang === 'en')!.href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The browser bar takes the page's own black (the rest of the site sets the same in Layout) -->
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <title>{t.links.title}</title>
    <meta name="description" content={t.links.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <!-- Open Graph -->
    <meta property="og:title" content={t.links.title} />
    <meta property="og:description" content={t.links.ogDescription} />
    <meta property="og:image" content="https://zippydj.com/images/og-dj-zippy.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.schema.ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DJ Zippy" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.links.title} />
    <meta name="twitter:description" content={t.links.twitterDescription} />
    <meta name="twitter:image" content="https://zippydj.com/images/og-dj-zippy.jpg" />
    <meta name="twitter:image:alt" content={t.schema.ogImageAlt} />
    <!-- Self-hosted fonts (src/styles/fonts.css) + the above-the-fold portrait -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/unbounded/unbounded-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter/inter-latin.woff2" crossorigin />
    <link rel="preload" as="image" href="/images/dj-zippy-house-music-dj.webp" fetchpriority="high" />
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Zippy" />
    <!-- Meta Pixel + GTM + Google Ads (deferred, see Analytics.astro) -->
    <Analytics />
    <link rel="stylesheet" href="/fonts/fa/fa-subset.css" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        /* This page is standalone: it does not load global.css, so the accent
           the rest of the site reads from there is defined here as well. */
        --accent-rgb: 255 85 0;
        --orange: rgb(var(--accent-rgb));
        --orange-fill: #cc4400;
        /* the two sides, fixed: B = underground (orange), A = open format (blue) */
        --side-b-rgb: 255 85 0;
        --side-a-rgb: 56 189 248;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      html { overflow-x: hidden; }
      body {
        background: #000;
        color: #fff;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 0;
        position: relative;
        overflow-x: hidden;
      }

      /* === Background video === */
      .bg-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
        object-fit: cover;
        object-position: center;
        z-index: -2;
        pointer-events: none;
      }
      /* Wide screens: the 540×960 clip stretched across the window turns to big
         pixels. There it plays at its own shape, a full-height column behind the
         cards (about 1:1), and the sides get its poster, blurred. */
      .bg-ambient { display: none; }
      @media (min-width: 768px) {
        .bg-video {
          left: 50%;
          right: auto;
          width: auto;
          aspect-ratio: 9 / 16;
          transform: translateX(-50%);
          -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
          mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
        }
        .bg-ambient {
          display: block;
          position: fixed;
          inset: -60px;
          z-index: -3;
          pointer-events: none;
          background: #08080a url('/videos/links-bg-poster.jpg') center / cover no-repeat;
          filter: blur(40px) brightness(0.8) saturate(1.3);
        }
      }
      .bg-overlay {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(130% 90% at 50% 0%, rgba(0,0,0,0.30), transparent 55%),
          linear-gradient(180deg,
            rgba(8,8,10,0.62) 0%,
            rgba(8,8,10,0.40) 30%,
            rgba(8,8,10,0.46) 64%,
            rgba(4,4,6,0.86) 100%);
        backdrop-filter: saturate(115%);
        -webkit-backdrop-filter: saturate(115%);
      }

      main {
        width: 100%;
        max-width: 488px;          /* ~440 card area + 24px gutter each side */
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        padding: 84px 24px 56px;   /* gutter lives here, so cards never touch edges */
        position: relative;
        z-index: 1;
      }
      @media (min-width: 640px) {
        main { max-width: 496px; padding: 108px 28px 64px; }
      }

      /* === Language toggle ===
         The site header's segmented EN / SR switch: mono labels, and the picked
         language in plain white. Language is not a side, so orange stays with
         the links. The track's inner padding keeps the pills off its curve. */
      .lang-switch {
        position: absolute;
        top: 20px;
        right: 24px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 4px;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 999px;
        background: rgba(14,14,17,0.55);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      .lang-switch a {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 32px;
        padding: 0 11px;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        line-height: 1;
        color: rgba(255,255,255,0.62);
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
        transition: color 0.3s, background 0.3s;
      }
      /* 44px tap target on touch screens, spilling over the track's padding */
      @media (pointer: coarse) {
        .lang-switch a::after { content: ''; position: absolute; inset: -6px -1px; }
      }
      .lang-switch a:hover { color: #fff; background: rgba(255,255,255,0.1); }
      .lang-switch a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
      .lang-switch a[aria-current] { background: #fff; color: #050505; }
      @media (min-width: 640px) {
        .lang-switch { top: 28px; right: 28px; }
      }

      /* === Profile header === */
      header { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
      .avatar-ring {
        padding: 3px;
        border-radius: 50%;
        background: conic-gradient(from 210deg, var(--orange), #ff8a4c, var(--orange));
        box-shadow: 0 14px 44px rgba(0,0,0,0.6), 0 0 30px rgb(var(--accent-rgb)/0.18);
      }
      header img {
        display: block;
        width: 108px; height: 108px;
        border-radius: 50%;
        border: 3px solid rgba(8,8,10,0.9);
        object-fit: cover;
      }
      header h1 {
        font-family: 'Unbounded', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 24px rgba(0,0,0,0.6);
      }
      header p {
        margin-top: 8px;
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        padding-left: 0.22em;   /* balances the trailing letter-spacing */
        text-transform: uppercase;
        color: rgba(255,255,255,0.72);
        text-shadow: 0 2px 16px rgba(0,0,0,0.7);
      }

      section { width: 100%; display: flex; flex-direction: column; gap: 11px; }
      .section-label {
        font-family: var(--mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 700;
        margin-bottom: 6px;
        padding-left: 4px;
        color: rgba(255,255,255,0.55);
        text-shadow: 0 1px 10px rgba(0,0,0,0.7);
      }

      /* === Two sides: B leads (House Music Therapy), A follows (Core Memories) ===
         Each side keeps its own colour here, whatever the accent. */
      section.sides { gap: 10px; }
      a.link-side {
        --side-rgb: var(--side-b-rgb);
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        min-height: 68px;
        padding: 12px 18px 12px 12px;
        border-radius: 15px;
        text-decoration: none;
        color: #fff;
        background: rgba(22, 22, 26, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 6px 26px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255,255,255,0.05);
        -webkit-backdrop-filter: blur(16px) saturate(135%);
        backdrop-filter: blur(16px) saturate(135%);
        -webkit-tap-highlight-color: transparent;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                    border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
      }
      a.link-side[data-side="A"] { --side-rgb: var(--side-a-rgb); }
      /* the B side leads: its edge and glow are on before anyone touches it */
      a.link-side[data-side="B"] {
        border-color: rgb(var(--side-b-rgb) / 0.42);
        box-shadow: 0 6px 26px rgba(0, 0, 0, 0.38), 0 0 26px rgb(var(--side-b-rgb) / 0.14), inset 0 1px 0 rgba(255,255,255,0.05);
      }
      .link-side .key {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: rgb(var(--side-rgb));
        color: #050505;
        font-family: 'Unbounded', sans-serif;
        font-size: 1.05rem;
        font-weight: 800;
      }
      .link-side .side-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
      .link-side .side-name { font-family: 'Unbounded', sans-serif; font-size: 0.95rem; font-weight: 700; line-height: 1.25; }
      .link-side .side-detail {
        font-family: var(--mono);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.4;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
      }
      .link-side .side-arrow { flex-shrink: 0; font-size: 0.8rem; color: rgba(255,255,255,0.5); transition: transform 0.3s, color 0.3s; }
      /* the smallest phones: a little more room for the name */
      @media (max-width: 359px) {
        a.link-side { gap: 12px; padding: 11px 14px 11px 11px; }
        .link-side .key { width: 40px; height: 40px; border-radius: 10px; }
        .link-side .side-name { font-size: 0.9rem; }
      }
      a.link-side:focus-visible,
      a.link-side:active {
        border-color: rgb(var(--side-rgb));
        background: rgb(var(--side-rgb) / 0.16);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgb(var(--side-rgb) / 0.35);
      }
      a.link-side:focus-visible .side-arrow,
      a.link-side:active .side-arrow { color: rgb(var(--side-rgb)); transform: translateX(3px); }
      a.link-side:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      a.link-side:active { transform: scale(0.98); transition-duration: 0.1s; }
      @media (hover: hover) {
        a.link-side:hover {
          transform: translateY(-2px);
          border-color: rgb(var(--side-rgb));
          background: rgb(var(--side-rgb) / 0.16);
          box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgb(var(--side-rgb) / 0.35);
        }
        a.link-side:hover .side-arrow { color: rgb(var(--side-rgb)); transform: translateX(3px); }
        a.link-side:active:hover { transform: scale(0.98); }
      }

      /* === Glass cards === */
      a.link-primary,
      a.link-secondary {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        text-decoration: none;
        border-radius: 15px;
        -webkit-backdrop-filter: blur(16px) saturate(135%);
        backdrop-filter: blur(16px) saturate(135%);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                    border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
      }

      a.link-primary {
        padding: 16px 22px;
        font-weight: 500;
        color: #fff;
        background: rgba(22, 22, 26, 0.46);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 6px 26px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255,255,255,0.05);
      }
      a.link-primary i { color: var(--orange); width: 22px; font-size: 1.1rem; flex-shrink: 0; text-align: center; transition: color 0.3s; }

      a.link-secondary {
        padding: 13px 22px;
        font-size: 0.9rem;
        font-weight: 500;
        color: #e2e2e7;
        background: rgba(14, 14, 17, 0.42);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
      }
      a.link-secondary i { width: 20px; flex-shrink: 0; text-align: center; color: #cfcfd6; transition: color 0.3s; }

      /* Orange fill on hover/focus/tap. #cc4400 keeps white text at 4.7:1
         (plain #ff5500 is only 3.2:1); the brighter #ff5500 lives in the border and glow. */
      a.link-primary,
      a.link-secondary,
      a.link-site { -webkit-tap-highlight-color: transparent; }

      a.link-primary:focus-visible,
      a.link-primary:active {
        color: #fff;
        background: var(--orange-fill);
        border-color: var(--orange);
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgb(var(--accent-rgb)/0.45);
      }
      a.link-secondary:focus-visible,
      a.link-secondary:active {
        color: #fff;
        background: rgba(204, 68, 0, 0.88);
        border-color: rgb(var(--accent-rgb)/0.9);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px rgb(var(--accent-rgb)/0.35);
      }
      a.link-primary:focus-visible i, a.link-primary:active i,
      a.link-secondary:focus-visible i, a.link-secondary:active i { color: #fff; }
      a.link-primary:focus-visible, a.link-secondary:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      a.link-primary:active, a.link-secondary:active { transform: scale(0.98); transition-duration: 0.1s; }

      @media (hover: hover) {
        a.link-primary:hover {
          transform: translateY(-2px);
          color: #fff;
          background: var(--orange-fill);
          border-color: var(--orange);
          box-shadow: 0 14px 38px rgba(0, 0, 0, 0.5), 0 0 28px rgb(var(--accent-rgb)/0.45);
        }
        a.link-secondary:hover {
          transform: translateY(-2px);
          color: #fff;
          background: rgba(204, 68, 0, 0.88);
          border-color: rgb(var(--accent-rgb)/0.9);
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px rgb(var(--accent-rgb)/0.35);
        }
        a.link-primary:hover i, a.link-secondary:hover i { color: #fff; }
        a.link-primary:active:hover, a.link-secondary:active:hover { transform: scale(0.98); }
      }

      /* === Site nav (minimal) === */
      a.link-site {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        min-height: 44px;
        padding: 9px 16px;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        border-radius: 11px;
        transition: color 0.3s, background 0.3s;
      }
      a.link-site i { width: 16px; flex-shrink: 0; text-align: center; }
      a.link-site .arrow { margin-left: auto; font-size: 0.75rem; opacity: 0; transition: opacity 0.3s, transform 0.3s; transform: translateX(-4px); }
      a.link-site:focus-visible,
      a.link-site:active { color: var(--orange); background: rgb(var(--accent-rgb)/0.08); }
      a.link-site:focus-visible .arrow,
      a.link-site:active .arrow { opacity: 1; transform: translateX(0); }
      @media (hover: hover) {
        a.link-site:hover { color: var(--orange); background: rgb(var(--accent-rgb)/0.08); }
        a.link-site:hover .arrow { opacity: 1; transform: translateX(0); }
      }

      /* a hairline across the whole card column; a short one read as a smudge on the video */
      .divider {
        width: 100%;
        height: 1px;
        border: none;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.14) 12%, rgba(255,255,255,0.14) 88%, transparent);
        margin: 2px 0;
      }

      footer { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 2px; padding-top: 12px; }
      /* .6 white keeps the small print above 4.5:1 wherever the video shows through */
      footer p, footer a { font-size: 0.8rem; color: rgba(255,255,255,0.6); text-decoration: none; }
      /* a full-size tap target around a small line of text */
      footer a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px; }
      footer a:hover { color: #fff; }
      footer a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; color: #fff; }
      footer .legal { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; color: rgba(255,255,255,0.35); }
      footer .legal a, footer .legal button { font-size: 0.75rem; color: rgba(255,255,255,0.6); }
      footer .legal button {
        appearance: none; background: none; border: 0; font-family: inherit; cursor: pointer;
        display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px;
      }
      footer .legal a:hover, footer .legal button:hover { color: #fff; }
      footer .legal a:focus-visible,
      footer .legal button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; color: #fff; }

      /* === Subtle entrance === */
      @keyframes rise {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: none; }
      }
      main > * { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
      main > *:nth-child(1) { animation-delay: 0.04s; }
      main > *:nth-child(2) { animation-delay: 0.12s; }
      main > *:nth-child(3) { animation-delay: 0.18s; }
      main > *:nth-child(4) { animation-delay: 0.24s; }
      main > *:nth-child(5) { animation-delay: 0.30s; }
      main > *:nth-child(6) { animation-delay: 0.36s; }
      main > *:nth-child(7) { animation-delay: 0.42s; }
      main > *:nth-child(8) { animation-delay: 0.48s; }

      @media (prefers-reduced-motion: reduce) {
        main > * { animation: none; }
        a.link-primary, a.link-secondary, a.link-side { transition: border-color 0.3s, background 0.3s, color 0.3s; }
        a.link-primary:hover, a.link-secondary:hover, a.link-side:hover,
        a.link-primary:active, a.link-secondary:active, a.link-side:active { transform: none; }
        .link-side .side-arrow { transition: none; }
      }
    </style>
  </head>
  <body>

    <!-- Background video (540×960, ~0.7 MB, no audio). The poster is its own
         first frame, so the hand-off is seamless. The source is attached by the
         script below — skipped on Save-Data / 2G and for visitors who asked for
         reduced motion, where the still poster stays. -->
    <div class="bg-ambient" aria-hidden="true"></div>
    <video
      class="bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster="/videos/links-bg-poster.jpg"
      data-src="/videos/links-bg.mp4"
      aria-hidden="true"
    ></video>
    <script is:inline>
      (function () {
        var v = document.querySelector('.bg-video');
        var c = navigator.connection || {};
        if (!v || c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
        // full-screen motion behind the links is a vestibular trigger: keep the still
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        v.src = v.getAttribute('data-src');
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      })();
    </script>
    <div class="bg-overlay" aria-hidden="true"></div>

    <div class="lang-switch" role="group" aria-label={t.langSwitch.label}>
      {/* the language's own name, so a screen reader says "Srpski", not "S R" */}
      <a href="/links" hreflang={htmlLang.en} lang={htmlLang.en} aria-label={languages.en} title={languages.en} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      <a href="/sr/links" hreflang={htmlLang.sr} lang={htmlLang.sr} aria-label={languages.sr} title={languages.sr} aria-current={lang === 'sr' ? 'true' : undefined}>SR</a>
    </div>

    <main>

      <!-- Profile Header -->
      <header>
        <div class="avatar-ring">
          {/* Above the fold and the only real image on the page, so it is
              preloaded and loads eagerly at high priority — otherwise it queues
              behind the background video and the ring sits empty for a beat. */}
          <img
            src="/images/dj-zippy-house-music-dj.webp"
            alt={t.links.avatarAlt}
            width="108"
            height="108"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div>
          <h1>Zippy</h1>
          <p>{t.links.tagline}</p>
        </div>
      </header>

      <!-- The two sides, B first. They open the site, where both sides live. -->
      <section class="sides" aria-label={t.links.sidesLabel}>
        <a href={`${l('/mixes')}?side=b`} class="link-side" data-side="B">
          <span class="key" aria-hidden="true">B</span>
          <span class="side-text">
            <span class="side-name"><span class="sr-only">{t.sides.b}: </span>House Music Therapy</span>
            <span class="side-detail">{t.links.sideBDetail}</span>
          </span>
          <i class="fa-solid fa-arrow-right side-arrow" aria-hidden="true"></i>
        </a>
        <a href={`${l('/events')}?side=a`} class="link-side" data-side="A">
          <span class="key" aria-hidden="true">A</span>
          <span class="side-text">
            <span class="side-name"><span class="sr-only">{t.sides.a}: </span>Core Memories</span>
            <span class="side-detail">{t.links.sideADetail}</span>
          </span>
          <i class="fa-solid fa-arrow-right side-arrow" aria-hidden="true"></i>
        </a>
      </section>

      <!-- Main Links -->
      <section aria-label={t.links.mainLabel}>
        <p class="section-label">{t.links.streamFollow}</p>

        <a href={`https://zippydj.com${l('/')}`} class="link-primary">
          <i class="fa-solid fa-globe"></i>
          <span>{t.links.website}</span>
        </a>

        <a href="https://www.instagram.com/zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-instagram"></i>
          <span>Instagram</span>
        </a>

        <a href="https://www.youtube.com/@zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-youtube"></i>
          <span>{t.links.youtube}</span>
        </a>

        <a href="https://www.mixcloud.com/zovumezippy/" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-mixcloud"></i>
          <span>{t.links.mixcloud}</span>
        </a>

        <a href="https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle" target="_blank" rel="me noopener noreferrer" class="link-primary">
          <i class="fa-brands fa-spotify"></i>
          <span>Spotify</span>
        </a>
      </section>

      <hr class="divider" />

      <!-- Secondary Links -->
      <section aria-label={t.links.secondaryLabel}>
        <p class="section-label">{t.links.alsoOn}</p>

        <a href="https://soundcloud.com/zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-soundcloud"></i>
          <span>SoundCloud</span>
        </a>

        <a href="https://www.deezer.com/en/profile/2582254702" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-deezer"></i>
          <span>Deezer</span>
        </a>

        <a href="https://www.tiktok.com/@zovumezippy" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-brands fa-tiktok"></i>
          <span>TikTok</span>
        </a>

        <a href="https://ra.co/dj/zippy-2" target="_blank" rel="me noopener noreferrer" class="link-secondary">
          <i class="fa-solid fa-square-poll-vertical"></i>
          <span>Resident Advisor</span>
        </a>
      </section>

      <hr class="divider" />

      <!-- Site Navigation -->
      <section aria-label={t.links.navLabel}>
        <p class="section-label">{t.links.explore}</p>

        <a href={l('/events')} class="link-site">
          <i class="fa-solid fa-calendar"></i>
          <span>{t.links.events}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={l('/about')} class="link-site">
          <i class="fa-solid fa-user"></i>
          <span>{t.links.about}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={l('/mixes')} class="link-site">
          <i class="fa-solid fa-music"></i>
          <span>{t.links.mixes}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>

        <a href={`${l('/')}#contact`} class="link-site">
          <i class="fa-solid fa-envelope"></i>
          <span>{t.links.contact}</span>
          <i class="fa-solid fa-arrow-right arrow"></i>
        </a>
      </section>

      <!-- Footer -->
      <footer>
        <p>{t.links.copyright(new Date().getFullYear())}</p>
        <a href={`https://zippydj.com${l('/')}`}>{t.links.visit}</a>
        <p class="legal">
          <a href={l('/privacy')}>{t.footer.privacy}</a>
          <span aria-hidden="true"> · </span>
          <button type="button" data-consent-open>{t.footer.cookieSettings}</button>
        </p>
      </footer>

    </main>
    <CookieConsent lang={lang} />
    <script>
      import '../../scripts/attribution';
      import '../../scripts/track';
    </script>
  </body>
</html>
