---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, localize, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const pageUrl = `https://zippydj.com${l('/gallery')}`;

// Every frame with a picture. A frame is a still or a short muted clip (the clip
// plays only while it is on screen, and never on Save-Data or reduced motion).
// The first frame is the large one. Live photos from the stages listed under
// "Developing" go here as they arrive (T17); the viewer picks them up as is.
type Frame = {
  kind: 'image' | 'video';
  src: string;          // the still, or the clip's poster
  video?: string;
  width: number;
  height: number;
  caption: string;
  place: string;
  alt: string;
  shape: 'feature' | 'tall';
};

const frames: Frame[] = [
  { kind: 'image', src: '/images/dj-zippy-house-music-dj.webp', width: 800, height: 800, shape: 'feature', ...t.gallery.portrait },
  { kind: 'video', src: '/videos/links-bg-poster.jpg', video: '/videos/links-bg.mp4', width: 540, height: 960, shape: 'tall', ...t.gallery.live },
];

// What the viewer needs, in order
const viewerData = frames.map((f) => ({
  kind: f.kind, src: f.src, video: f.video, w: f.width, h: f.height, alt: f.alt, caption: f.caption, place: f.place,
}));

const gallerySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': t.breadcrumb.home, 'item': `https://zippydj.com${l('/')}` },
        { '@type': 'ListItem', 'position': 2, 'name': t.breadcrumb.gallery, 'item': pageUrl },
      ],
    },
    {
      '@type': 'ImageGallery',
      '@id': `${pageUrl}#gallery`,
      'url': pageUrl,
      'name': t.gallery.schemaName,
      'description': t.gallery.schemaDesc,
      'inLanguage': htmlLang[lang],
      'about': { '@id': 'https://zippydj.com/#person' },
      'image': frames.filter((f) => f.kind === 'image').map((f) => ({
        '@type': 'ImageObject',
        'contentUrl': `https://zippydj.com${f.src}`,
        'width': f.width,
        'height': f.height,
        'caption': `${f.caption} · ${f.place}`,
        'description': f.alt,
      })),
    },
  ],
};

const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout lang={lang} title={t.gallery.title} description={t.gallery.description} noindex={true}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <section class="isolate relative bg-brand-black pt-24 sm:pt-28 pb-10 sm:pb-14 overflow-hidden">
    <div class="aurora absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 text-center relative z-30">
      <nav aria-label={t.breadcrumb.label} class="mb-6">
        <ol class="flex justify-center items-center space-x-2 text-sm text-gray-400">
          <li><a href={l('/')} class="inline-block py-2.5 -my-2.5 hover:text-brand-orange transition-colors">{t.breadcrumb.home}</a></li>
          <li><span class="mx-2" aria-hidden="true">/</span></li>
          <li class="text-white" aria-current="page">{t.breadcrumb.gallery}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-2">{t.gallery.heading}</h1>
      <h2 class="font-display text-xl md:text-2xl lg:text-3xl font-bold text-brand-orange leading-tight mb-4">{t.gallery.subheading}</h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto">{t.gallery.lead}</p>
    </div>
  </section>

  <section id="gallery" class="isolate relative pb-16 sm:pb-24 bg-brand-black">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="gal" data-gallery data-frames={JSON.stringify(viewerData)}>
        <ul class="gal-grid" role="list">
          {frames.map((f, i) => (
            <li class={`gal-item gal-item--${f.shape}`} data-reveal>
              <button
                type="button"
                class="gal-frame"
                data-gal-index={i}
                aria-haspopup="dialog"
                aria-label={t.gallery.open.replace('{alt}', f.alt)}
              >
                {f.kind === 'video'
                  ? <video class="gal-frame__media" muted loop playsinline preload="none" poster={f.src} data-gal-clip={f.video} width={f.width} height={f.height} aria-hidden="true"></video>
                  : <img class="gal-frame__media" src={f.src} alt={f.alt} width={f.width} height={f.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
                <span class="gal-frame__no mono-caps" aria-hidden="true">{pad(i + 1)}</span>
                <span class="gal-frame__info" aria-hidden="true">
                  <span class="gal-frame__caption">{f.caption}</span>
                  <span class="gal-frame__place mono-caps">{f.place}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        {/* The shoots still to come, like prints in the darkroom; B side first */}
        <aside class="gal-notes" aria-labelledby="gal-notes-title" data-reveal>
          <h2 id="gal-notes-title" class="gal-notes__label mono-caps"><span class="gal-notes__lamp" aria-hidden="true"></span>{t.gallery.developing}</h2>
          <ul class="gal-notes__list" role="list">
            {t.gallery.developingItems.map((item) => (
              <li class="gal-notes__item" data-side={item.side}>
                <span class="side-key" aria-hidden="true">{item.side}</span>
                <span class="min-w-0">
                  <span class="sr-only">{item.side === 'A' ? t.sides.a : t.sides.b}: </span>
                  <span class="block font-display font-bold text-white text-[0.9375rem] leading-snug">{item.title}</span>
                  <span class="block mt-1 text-[0.8125rem] leading-snug text-gray-400">{item.detail}</span>
                </span>
              </li>
            ))}
          </ul>
          <p class="gal-notes__more">{t.gallery.more}</p>
        </aside>
      </div>

      <div class="mt-12 text-center">
        <a href={l('/')} class="inline-flex items-center gap-2 text-gray-400 hover:text-brand-orange transition-colors">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {t.gallery.backHome}
        </a>
      </div>
    </div>
  </section>

  {/* Viewer: Esc or the close button shuts it, arrow keys / swipe / the buttons
      move between frames, and focus goes back to the frame that opened it. */}
  <dialog class="gal-box" data-gal-box aria-label={t.gallery.viewer}>
    <div class="gal-box__bar">
      <p class="gal-box__count mono-caps" data-gal-count></p>
      <button type="button" class="gal-box__btn" data-gal-close aria-label={t.gallery.close} autofocus>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="gal-box__stage" data-gal-stage></div>
    <div class="gal-box__foot">
      <button type="button" class="gal-box__btn" data-gal-prev aria-label={t.gallery.prev}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <p class="gal-box__caption" aria-live="polite"><span class="gal-box__title" data-gal-caption></span><span class="gal-box__place mono-caps" data-gal-place></span></p>
      <button type="button" class="gal-box__btn" data-gal-next aria-label={t.gallery.next}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </dialog>
</Layout>

<style>
  /* Frames on the left (or on top), the darkroom notes beside them on wide screens */
  .gal { display: grid; gap: 0.75rem; }
  @media (min-width: 1024px) {
    .gal { grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem); gap: 1rem; }
  }

  .gal-grid { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  /* From a large phone up the feature and the clip share a row; the clip
     stretches to the feature's height */
  @media (min-width: 560px) {
    .gal-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }
  @media (min-width: 1024px) { .gal-grid { gap: 1rem; } }
  .gal-item { min-width: 0; }

  .gal-frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(255,255,255,0.1);
    background: #0b0b0b;
    text-align: left;
    cursor: zoom-in;
    transition: border-color 0.3s;
  }
  .gal-item--feature .gal-frame { aspect-ratio: 1; }
  .gal-item--tall .gal-frame { aspect-ratio: 4 / 5; }
  @media (min-width: 560px) {
    .gal-item--tall .gal-frame { aspect-ratio: auto; min-height: 100%; }
  }
  .gal-frame:hover { border-color: rgb(var(--accent-rgb)); }
  .gal-frame:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-color: rgb(var(--accent-rgb)); }
  .gal-frame__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .gal-frame:hover .gal-frame__media { transform: scale(1.04); }
  /* frame number, like the edge print on a contact sheet */
  .gal-frame__no {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: rgb(var(--alt-rgb));
    text-shadow: 0 1px 10px rgba(0,0,0,0.7);
  }
  .gal-frame__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 3rem 1.1rem 1.05rem;
    background: linear-gradient(to top, rgba(5,5,5,0.92), rgba(5,5,5,0));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s, transform 0.25s;
  }
  .gal-frame:hover .gal-frame__info,
  .gal-frame:focus-visible .gal-frame__info { opacity: 1; transform: none; }
  .gal-frame__caption { font-family: 'Unbounded', sans-serif; font-size: 1rem; font-weight: 700; line-height: 1.25; color: #fff; }
  .gal-frame__place { font-size: 0.6875rem; color: rgba(255,255,255,0.72); }
  /* no hover on touch screens, so the caption stays */
  @media (hover: none) {
    .gal-frame__info { opacity: 1; transform: none; }
  }

  .gal-notes {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255,255,255,0.09);
    background: linear-gradient(180deg, #131313, #0c0c0c);
  }
  @media (min-width: 1024px) { .gal-notes { padding: 1.5rem 1.35rem; } }
  .gal-notes__label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.6875rem; color: rgba(255,255,255,0.62); }
  /* the darkroom safelight */
  .gal-notes__lamp {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgb(var(--accent-rgb));
    box-shadow: 0 0 12px rgb(var(--accent-rgb) / 0.85);
    animation: gal-lamp 2.6s ease-in-out infinite alternate;
  }
  @keyframes gal-lamp { from { opacity: 0.45; } to { opacity: 1; } }
  .gal-notes__list { display: grid; gap: 1.1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 560px) and (max-width: 1023px) {
    .gal-notes__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  }
  .gal-notes__item { display: flex; align-items: flex-start; gap: 0.75rem; }
  .gal-notes__item .side-key { margin-top: 0.05rem; }
  /* tall panel beside a large frame: the list breathes with it */
  @media (min-width: 1280px) {
    .gal-notes { gap: 1.75rem; }
    .gal-notes__list { gap: 1.5rem; }
  }
  .gal-notes__more {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.875rem;
    color: rgb(156 163 175);
  }

  /* === Viewer === */
  .gal-box {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(5,5,5,0.97);
    color: #fff;
    overflow: hidden;
  }
  .gal-box[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .gal-box::backdrop { background: rgba(0,0,0,0.85); }
  .gal-box__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: max(0.75rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) 0.75rem max(1rem, env(safe-area-inset-left));
  }
  .gal-box__count { font-size: 0.75rem; color: rgb(var(--alt-rgb)); }
  .gal-box__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0 1rem;
    touch-action: pan-y pinch-zoom;
  }
  .gal-box__stage :global(.gal-box__media) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 1rem;
    object-fit: contain;
    background: #0b0b0b;
  }
  .gal-box__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  }
  .gal-box__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    text-align: center;
  }
  .gal-box__title { font-family: 'Unbounded', sans-serif; font-size: 0.9375rem; font-weight: 700; }
  .gal-box__place { font-size: 0.6875rem; color: rgba(255,255,255,0.65); }
  .gal-box__btn {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.18);
    background: rgba(5,5,5,0.5);
    color: #fff;
    transition: color 0.2s, border-color 0.2s;
  }
  .gal-box__btn:hover { color: rgb(var(--accent-rgb)); border-color: rgb(var(--accent-rgb)); }
  .gal-box__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .gal-box__btn[hidden] { display: none; }
  :global(html.gal-lock) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .gal-frame__media, .gal-frame__info { transition: none; }
    .gal-frame:hover .gal-frame__media { transform: none; }
    .gal-notes__lamp { animation: none; }
  }
</style>

<script>
  type ViewerFrame = { kind: 'image' | 'video'; src: string; video?: string; w: number; h: number; alt: string; caption: string; place: string };

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowData = () => {
    const c = (navigator as any).connection || {};
    return !!c.saveData || /(^|-)2g$/.test(c.effectiveType || '');
  };
  const pad = (n: number) => String(n).padStart(2, '0');

  function initGallery() {
    const root = document.querySelector<HTMLElement>('[data-gallery]');
    const box = document.querySelector<HTMLDialogElement>('[data-gal-box]');
    if (!root || !box || root.dataset.galReady) return;
    root.dataset.galReady = '1';

    let frames: ViewerFrame[] = [];
    try { frames = JSON.parse(root.dataset.frames || '[]'); } catch { /* no viewer */ }

    // Clips play only while they are on screen
    const clips = root.querySelectorAll<HTMLVideoElement>('video[data-gal-clip]');
    if (clips.length && !reduceMotion() && !lowData() && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const clip = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!clip.getAttribute('src')) clip.src = clip.dataset.galClip || '';
            clip.play().catch(() => {});
          } else {
            clip.pause();
          }
        });
      }, { threshold: 0.35 });
      clips.forEach((clip) => io.observe(clip));
    }

    if (!frames.length || typeof box.showModal !== 'function') return;

    const stage = box.querySelector<HTMLElement>('[data-gal-stage]')!;
    const count = box.querySelector<HTMLElement>('[data-gal-count]')!;
    const caption = box.querySelector<HTMLElement>('[data-gal-caption]')!;
    const place = box.querySelector<HTMLElement>('[data-gal-place]')!;
    const prev = box.querySelector<HTMLButtonElement>('[data-gal-prev]')!;
    const next = box.querySelector<HTMLButtonElement>('[data-gal-next]')!;
    const single = frames.length < 2;
    prev.hidden = single;
    next.hidden = single;

    let index = 0;
    let opener: HTMLElement | null = null;

    function media(f: ViewerFrame): HTMLElement {
      if (f.kind === 'video' && f.video) {
        const v = document.createElement('video');
        v.className = 'gal-box__media';
        v.poster = f.src;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.setAttribute('playsinline', '');
        v.width = f.w;
        v.height = f.h;
        v.setAttribute('aria-label', f.alt);
        v.src = f.video;
        // still pictures first for people who asked for less motion: the clip waits for play
        if (reduceMotion() || lowData()) { v.controls = true; v.preload = 'none'; }
        else { v.autoplay = true; v.play().catch(() => {}); }
        return v;
      }
      const img = new Image(f.w, f.h);
      img.className = 'gal-box__media';
      img.alt = f.alt;
      img.decoding = 'async';
      img.src = f.src;
      return img;
    }

    function show(i: number) {
      index = (i + frames.length) % frames.length;
      const f = frames[index];
      stage.replaceChildren(media(f));
      caption.textContent = f.caption;
      place.textContent = f.place;
      count.textContent = `${pad(index + 1)} / ${pad(frames.length)}`;
    }

    function open(i: number, from: HTMLElement) {
      opener = from;
      show(i);
      document.documentElement.classList.add('gal-lock');
      box!.showModal();
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-gal-index]');
      if (btn) open(Number(btn.dataset.galIndex) || 0, btn);
    });
    box.querySelector('[data-gal-close]')?.addEventListener('click', () => box.close());
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    box.addEventListener('keydown', (e) => {
      if (single) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    });
    // a click on the dark area around the picture closes it
    box.addEventListener('click', (e) => {
      if (e.target === box || e.target === stage) box.close();
    });
    box.addEventListener('close', () => {
      stage.replaceChildren();
      document.documentElement.classList.remove('gal-lock');
      // after the browser's own focus hand-back, so the frame that opened it wins
      const back = opener;
      setTimeout(() => back?.focus({ preventScroll: true }), 0);
    });

    // swipe between frames on touch screens
    let start: { x: number; y: number; id: number } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || single) return;
      start = { x: e.clientX, y: e.clientY, id: e.pointerId };
    });
    stage.addEventListener('pointerup', (e) => {
      if (!start || e.pointerId !== start.id) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.2) show(index + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => { start = null; });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>
