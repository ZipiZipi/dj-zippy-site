      .liner__credits dd { font-size: 0.8125rem; line-height: 1.35; }
    }
    /* small phones (iPhone SE and the like): the credits give way */
    @media (max-width: 639px) and (max-height: 720px) {
      .liner__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "sleeve" "head" "body"; }
      .liner__credits { display: none; }
