---
// Home page body. Rendered by /index.astro (en) and /sr/index.astro (sr) —
// the only difference between them is the `lang` prop.
import Layout from '../../layouts/Layout.astro';
import { getEvents, getMixes, MIX_PLATFORMS, youtubeThumb } from '../../lib/content';
import { useTranslations, localize, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const db = (Astro.locals as any).runtime?.env?.DB;
const { upcoming } = await getEvents(db);
const homeUpcoming = upcoming.slice(0, 4);
const { featured } = await getMixes(db);
// A disc label is ~230px at most, so YouTube's hqdefault (~30 KB) is plenty —
// maxresdefault was 100–200 KB each. hqdefault is 4:3 letterboxed, so the label
// zooms it to crop the black bars.
const featuredMixes = featured.map(m => {
  const p = MIX_PLATFORMS.find(x => x.id === m.platform);
  const platformLabel = p?.label ?? m.platform;
  const thumb = m.thumbnail ? youtubeThumb(m.thumbnail, 'hqdefault') : '';
  return {
    ...m,
    platformLabel,
    platformIcon: p?.icon ?? 'fa-solid fa-music',
    thumbStyle: !thumb ? undefined
      : thumb.endsWith('/hqdefault.jpg') ? `background-image: url('${thumb}'); background-size: auto 134%;`
      : `background-image: url('${thumb}');`,
    playLabel: t.home.playOn.replace('{title}', m.title).replace('{platform}', platformLabel),
    showLabel: t.home.showMix.replace('{title}', m.title),
  };
});

const pageUrl = `https://zippydj.com${l('/')}`;

// Person / Organization / WebSite are one entity across both locales, so their
// @ids stay canonical. Only the page node is per-locale.
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profilepage`,
      'url': pageUrl,
      'inLanguage': htmlLang[lang],
      'mainEntity': { '@id': 'https://zippydj.com/#person' },
      'isPartOf': { '@id': 'https://zippydj.com/#website' },
      'dateCreated': '2024-01-01T00:00:00-05:00',
      'dateModified': '2026-09-29T00:00:00+02:00',
    },
    {
      '@type': ['Person', 'MusicGroup'],
      '@id': 'https://zippydj.com/#person',
      'name': 'DJ Zippy',
      'givenName': 'Veljko',
      'familyName': 'Nedeljkovic',
      'alternateName': ['Zippy', 'Zippy DJ', 'Zovumezippy', 'Zipi', 'Veljko Nedeljković'],
      'url': 'https://zippydj.com',
      'image': {
        '@type': 'ImageObject',
        'url': 'https://zippydj.com/images/dj-zippy-house-music-dj.webp',
        'width': 800,
        'height': 800,
        'caption': 'DJ Zippy — House Music Therapy',
      },
      'description': t.schema.personDescription,
      'jobTitle': 'Serbian House DJ & Selector',
      'hasOccupation': { '@type': 'Occupation', 'name': 'Disc Jockey', 'occupationalCategory': '27-2099.00' },
      'nationality': { '@type': 'Country', 'name': 'Serbia' },
      'birthPlace': { '@type': 'City', 'name': 'Belgrade' },
      'homeLocation': { '@type': 'Place', 'address': { '@type': 'PostalAddress', 'addressCountry': 'RS' } },
      'address': { '@type': 'PostalAddress', 'addressCountry': 'RS' },
      'genre': ['House', 'Tech House', 'Deep House', 'Techno', 'Organic House'],
      'knowsLanguage': ['sr', 'en'],
      'memberOf': [
        { '@type': 'Organization', 'name': 'Kult Talents' },
        { '@type': 'Organization', 'name': 'Izuvanje' },
      ],
      'sameAs': [
        'https://musicbrainz.org/artist/a6a53c2e-8fa0-4612-8e43-8de7af43dc2a',
        'https://www.wikidata.org/wiki/Q138220521',
        'https://www.instagram.com/zovumezippy',
        'https://www.youtube.com/@zovumezippy',
        'https://ra.co/dj/zippy-2',
        'https://soundcloud.com/zovumezippy',
        'https://www.mixcloud.com/zovumezippy/',
        'https://www.tiktok.com/@zovumezippy',
        'https://www.facebook.com/zovumezippy',
        'https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle',
        'https://www.deezer.com/en/profile/2582254702',
      ],
      'knowsAbout': ['House Music', 'Tech House', 'Deep House', 'Techno', 'DJing', 'Music Selection'],
    },
    {
      '@type': 'Organization',
      '@id': 'https://zippydj.com/#organization',
      'name': 'DJ Zippy',
      'alternateName': 'House Music Therapy',
      'url': 'https://zippydj.com',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://zippydj.com/images/dj-zippy-house-music-dj.webp',
        'width': 800,
        'height': 800,
      },
      'image': 'https://zippydj.com/images/dj-zippy-house-music-dj.webp',
      'founder': { '@id': 'https://zippydj.com/#person' },
      'description': t.schema.orgDescription,
      'address': { '@type': 'PostalAddress', 'addressCountry': 'RS' },
      'contactPoint': {
        '@type': 'ContactPoint',
        'email': 'veljkoned@gmail.com',
        'contactType': 'booking',
        'areaServed': ['RS', 'EU'],
        'availableLanguage': ['en', 'sr'],
      },
      'sameAs': [
        'https://www.instagram.com/zovumezippy',
        'https://www.youtube.com/@zovumezippy',
        'https://ra.co/dj/zippy-2',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://zippydj.com/#website',
      'name': 'DJ Zippy',
      'url': 'https://zippydj.com',
      'inLanguage': ['en', 'sr-Latn'],
      'publisher': { '@id': 'https://zippydj.com/#organization' },
    },
  ],
};
---

<Layout lang={lang} title={t.home.title} description={t.home.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

  <style is:global>
    .coverflow {
      perspective: 600px;
      perspective-origin: 50% 50%;
      position: relative;
      height: 340px;
      display: flex;
      align-items: center;
      justify-content: center;
      /* free horizontal drag/flick (the script spins it); vertical swipes still scroll the page */
      touch-action: pan-y;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
    /* Positions are driven every frame by the script (drag + momentum), so no CSS transitions here */
    .coverflow-item {
      position: absolute;
      top: 50%;
      display: block;
      width: clamp(150px, 22vw, 280px);
      will-change: transform, opacity;
      transform-style: preserve-3d;
      cursor: grab;
      user-select: none;
      outline: none;
      -webkit-tap-highlight-color: transparent;
      -webkit-user-drag: none;
    }
    .coverflow-item.active { cursor: pointer; }
    .coverflow.is-dragging, .coverflow.is-dragging .coverflow-item { cursor: grabbing; }
    /* Non-rotating wrapper: holds the spinning disc plus the fixed light sheen,
       play icon and focus ring (so none of them spin with the record). */
    .cf-vinyl {
      position: relative;
      width: clamp(125px, 18vw, 230px);
      aspect-ratio: 1;
      margin: 0 auto;
      border-radius: 50%;
    }
    .coverflow-item:focus-visible .cf-vinyl { outline: 3px solid #fff; outline-offset: 5px; }
    .cf-disc {
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at center, transparent 18%, #101010 19%),
        repeating-radial-gradient(circle at center, #1e1e1e 0px, #141414 1px, #0f0f0f 2px, #191919 3px),
        linear-gradient(135deg, #141414 0%, #0a0a0a 50%, #141414 100%);
      border-radius: 50%;
      position: relative;
      box-shadow: 0 10px 30px rgba(0,0,0,0.45), 0 0 0 2px rgba(255,255,255,0.1), inset 0 0 50px rgba(0,0,0,0.6);
    }
    .cf-disc::before {
      content: '';
      position: absolute;
      inset: 2%;
      border-radius: 50%;
      background:
        repeating-radial-gradient(circle at center, transparent, transparent 1.5px, rgba(255,255,255,0.035) 2px, transparent 2.5px),
        repeating-radial-gradient(circle at center, transparent, transparent 5px, rgba(255,255,255,0.02) 5.5px, transparent 6px);
      pointer-events: none;
    }
    .cf-disc::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.1);
      pointer-events: none;
    }
    /* Fixed "light" reflection on the grooves — a soft bow-tie highlight like a
       real record under a lamp. Masked off the label so the artwork stays clean. */
    .cf-sheen {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      pointer-events: none;
      z-index: 3;
      background:
        conic-gradient(from 20deg, transparent 0deg, rgba(255,255,255,0.14) 24deg, transparent 58deg, transparent 180deg, rgba(255,255,255,0.1) 204deg, transparent 238deg),
        radial-gradient(circle at 30% 24%, rgba(255,255,255,0.1), transparent 46%);
      -webkit-mask-image: radial-gradient(circle closest-side, transparent 49%, #000 51%);
      mask-image: radial-gradient(circle closest-side, transparent 49%, #000 51%);
    }
    .cf-label {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 48%; height: 48%;
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
      box-shadow: 0 0 0 2px rgba(0,0,0,0.55), 0 0 12px rgba(0,0,0,0.3);
      z-index: 1;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }
    /* only a faint rim so the label reads as printed paper — the artwork stays bright */
    .cf-label::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle closest-side, transparent 72%, rgba(0,0,0,0.1) 100%);
      z-index: -1;
    }
    .cf-play-overlay {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      font-size: 3rem;
      color: rgba(255,255,255,0.95);
      text-shadow: 0 4px 15px rgba(0,0,0,0.8);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
      z-index: 10;
    }
    .coverflow-item.active:hover .cf-play-overlay,
    .coverflow-item.active:focus-visible .cf-play-overlay { opacity: 1; }
    .cf-label-title {
      font-size: clamp(0.55rem, 1.1vw, 0.8rem);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #fff;
      line-height: 1;
      margin-bottom: 10px;
    }
    .cf-label-sub {
      font-size: clamp(0.45rem, 0.85vw, 0.6rem);
      font-weight: 700;
      color: #fff;
      line-height: 1;
      margin-top: 10px;
    }
    .cf-spindle {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 7%; height: 7%;
      min-width: 8px; min-height: 8px;
      background: radial-gradient(circle, #1a1a1a 40%, #0a0a0a 100%);
      border-radius: 50%;
      box-shadow: inset 0 0 4px rgba(255,255,255,0.2), 0 0 2px rgba(0,0,0,0.8);
      z-index: 2;
    }
    .coverflow-item.active .cf-disc {
      box-shadow: 0 14px 40px rgba(0,0,0,0.55), 0 0 0 2px rgba(255,255,255,0.12), inset 0 0 50px rgba(0,0,0,0.6), 0 0 46px rgba(255,85,0,0.15);
    }
    /* Caption sits on a dark pill so it stays legible over the bright orange/peach gradient */
    .cf-caption {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      max-width: 100%;
      margin-top: 14px;
      padding: 6px 12px;
      border-radius: 12px;
      background: rgba(5,5,5,0.78);
      transition: opacity 0.4s;
    }
    .cf-caption-title { font-size: 12px; font-weight: 600; line-height: 1.3; color: #fff; }
    .cf-caption-platform {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.8);
    }
    .cf-caption-platform i { color: #FF5500; margin-right: 2px; }
    .coverflow-nav {
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      z-index: 20;
      width: 44px; height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: #fff;
      background: rgba(5,5,5,0.55);
      transition: color 0.3s, background-color 0.3s;
      cursor: pointer;
      border: none;
    }
    .coverflow-nav:hover { color: #FF5500; background: #050505; }
    .coverflow-nav:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
    .coverflow-nav.prev { left: 0; }
    .coverflow-nav.next { right: 0; }
    .cf-dots { display: none; }
    .cf-dot {
      width: 24px; height: 24px;
      display: grid;
      place-items: center;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .cf-dot::before {
      content: '';
      width: 8px; height: 8px;
      border-radius: 999px;
      background: rgba(5,5,5,0.4);
      transition: width 0.3s, background-color 0.3s;
    }
    .cf-dot[aria-current="true"]::before { width: 20px; background: #050505; }
    .cf-dot:focus-visible { outline: 2px solid #050505; outline-offset: 1px; border-radius: 6px; }
    .cf-listen {
      color: #fff;
      background: rgba(5,5,5,0.82);
      border: 1px solid rgba(255,255,255,0.14);
      transition: color 0.3s, background-color 0.3s;
    }
    .cf-listen:hover { color: #FF5500; background: #050505; }
    .coverflow-fade-wrap {
      position: relative;
      /* extra vertical room so the active disc's glow/shadow isn't clipped by the
         horizontal fade mask (a mask clips to its own box on all sides) */
      padding-top: 44px;
      padding-bottom: 44px;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
    }
    /* Phones: one big active disc with a neighbour peeking on each side (the rest
       are hidden by the script), no side fade, and the arrows move under the disc
       next to the dots so they never cover it. */
    @media (max-width: 639px) {
      .coverflow { height: clamp(320px, 96vw, 400px); }
      .coverflow-fade-wrap { -webkit-mask-image: none; mask-image: none; padding-top: 8px; padding-bottom: 8px; }
      .coverflow-item { width: clamp(200px, 64vw, 290px); }
      .cf-vinyl { width: clamp(180px, 56vw, 250px); }
      .cf-caption-title { font-size: 13px; }
      .coverflow-item:not(.active) .cf-caption { opacity: 0; }
      .cf-controls { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 4px; }
      .coverflow-nav { position: static; transform: none; }
      .cf-dots { display: flex; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cf-caption, .cf-play-overlay, .cf-dot::before { transition: none; }
    }

    /* Hero animated gradient — brand colours (black / orange / white) that
       shift vertically as the page scrolls (driven by --hero-shift). */
    .hero-gradient {
      --hero-shift: 26%;
      background-image: linear-gradient(168deg,
        #050505 0%,
        #120700 12%,
        #3a1400 24%,
        #99360a 36%,
        #ff5500 48%,
        #ff9a5e 55%,
        #ffe6d8 61%,
        #ff6a1f 69%,
        #5e2106 80%,
        #0a0604 92%,
        #050505 100%);
      background-size: 100% 235%;
      background-position: 50% var(--hero-shift);
      background-repeat: no-repeat;
      will-change: background-position;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-gradient { --hero-shift: 30%; }
    }

    /* "SERBIAN HOUSE DJ" kicker over the name, framed by two short orange rules.
       The trailing letter-spacing is balanced with the same left padding. */
    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.9em;
      letter-spacing: 0.4em;
      padding-left: 0.4em;
    }
    .hero-kicker::before,
    .hero-kicker::after {
      content: '';
      width: 1.8em;
      height: 2px;
      background: #FF5500;
    }
  </style>

  <!-- overflow-x-clip: discs parked off-screen behind the "cylinder" must not widen the page -->
  <section class="isolate relative flex flex-col items-center justify-center overflow-x-clip bg-brand-black pt-28 sm:pt-32">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="hero-gradient absolute inset-0"></div>
      <!-- legibility scrim: darker at the top (behind the title), clears lower so the gradient + vinyls show -->
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(5,5,7,0.5) 0%, rgba(5,5,7,0.12) 26%, rgba(5,5,7,0) 46%, rgba(5,5,7,0) 100%);"></div>
    </div>
    <div data-spotlight class="spotlight absolute inset-0 pointer-events-none z-10"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 text-center z-30">
      <!-- One H1 that reads "ZIPPY. — Serbian House DJ"; flex-col-reverse lifts
           the kicker above the name without changing the reading order. -->
      <h1 class="font-display flex flex-col-reverse items-center mb-0">
        <span class="block text-5xl md:text-7xl lg:text-9xl font-black leading-none glitch-text cursor-default" style="text-shadow:0 2px 34px rgba(0,0,0,0.55), 0 1px 2px rgba(0,0,0,0.6);">ZIPPY<span class="text-brand-orange">.</span></span>
        <span class="sr-only"> — </span>
        <span class="hero-kicker mb-2 sm:mb-3 text-[11px] sm:text-xs md:text-sm font-bold uppercase text-white/90" style="text-shadow:0 1px 10px rgba(0,0,0,0.6);">{t.home.kicker}</span>
      </h1>
      <h2 class="font-display text-2xl md:text-4xl lg:text-6xl font-black mb-0 text-transparent bg-clip-text bg-gradient-to-r from-brand-orange to-white tracking-tight" style="filter:drop-shadow(0 2px 16px rgba(0,0,0,0.5));">HOUSE MUSIC THERAPY</h2>

      <div id="highlights" class="relative pt-2 sm:pt-3 pb-10 sm:pb-14 z-30">
        <div class="container mx-auto px-6 sm:px-8 lg:px-12">
          <div class="text-center mb-6 sm:mb-8">
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-1" style="text-shadow:0 1px 12px rgba(0,0,0,0.5);">{t.home.featured1}<span class="text-brand-orange">{t.home.featured2}</span></h2>
            <p class="text-gray-300 text-sm" style="text-shadow:0 1px 8px rgba(0,0,0,0.6);">{t.home.featuredSub}</p>
          </div>
          <div id="cf-root" class="relative sm:px-14" role="region" aria-roledescription="carousel" aria-label={t.home.featured1 + t.home.featured2}>
            <div class="coverflow-fade-wrap">
              <div class="coverflow" id="coverflow-container">
                {featuredMixes.map(m => (
                  <a class="coverflow-item text-center" href={m.link} target="_blank" rel="noopener" draggable="false" aria-label={m.playLabel} data-play={m.playLabel} data-show={m.showLabel}>
                    <div class="cf-vinyl">
                      <div class="cf-disc">
                        <div class={m.thumbStyle ? 'cf-label' : 'cf-label bg-brand-orange'} style={m.thumbStyle}>
                          {!m.thumbnail && <span class="cf-label-title">ZIPPY</span>}
                          {!m.thumbnail && <span class="cf-label-sub">{m.platform.toUpperCase()}</span>}
                        </div>
                        <div class="cf-spindle"></div>
                      </div>
                      <div class="cf-sheen"></div>
                      <i class="fa-solid fa-play cf-play-overlay" aria-hidden="true"></i>
                    </div>
                    <span class="cf-caption" aria-hidden="true">
                      <span class="cf-caption-title">{m.title}</span>
                      <span class="cf-caption-platform"><i class={m.platformIcon}></i> {m.platformLabel}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
            <div class="cf-controls">
              <button type="button" class="coverflow-nav prev" aria-label={t.home.prev}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
              <div class="cf-dots">
                {featuredMixes.map((m, i) => (
                  <button type="button" class="cf-dot" data-index={i} aria-label={m.showLabel} aria-current={i === 0 ? 'true' : undefined}></button>
                ))}
              </div>
              <button type="button" class="coverflow-nav next" aria-label={t.home.next}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            </div>
            <p id="cf-status" class="sr-only" aria-live="polite"></p>
          </div>
          <div class="mt-12 sm:mt-16 text-center">
            <a href={l('/mixes')} class="cf-listen inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold">
              <i class="fa-solid fa-headphones" aria-hidden="true"></i> {t.home.listenNow}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- "Played at" tapes. The first venue list is the one screen readers get;
       the loop copy and the black genre tape are decoration. -->
  <section class="tapes bg-brand-black font-display" aria-labelledby="played-at">
    <div class="tape tape--main">
      <h2 id="played-at" class="tape__label">{t.home.playedAt}</h2>
      <div class="tape__viewport">
        <div class="tape__track">
          <ul class="tape__list">
            {t.home.venues.map((v) => <li>{v}</li>)}
          </ul>
          <ul class="tape__list" aria-hidden="true">
            {t.home.venues.map((v) => <li>{v}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="tape tape--sub" aria-hidden="true">
      <div class="tape__viewport">
        <div class="tape__track">
          {[0, 1, 2, 3].map(() => (
            <ul class="tape__list">
              {t.home.tapeWords.map((w) => <li>{w}</li>)}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="dates" class="isolate relative py-8 sm:py-16 bg-brand-black">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-8 text-center">{t.home.upcoming1}<span class="text-brand-orange">{t.home.upcoming2}</span></h2>
      <div class="space-y-1 flex flex-col items-center max-w-3xl mx-auto" data-reveal>
        {homeUpcoming.length === 0 && <p class="text-gray-400 text-center">{t.home.noUpcoming}</p>}
        {homeUpcoming.map(e => {
          const displayDate = e.date.split('-').reverse().join('/') + (e.time ? ` | ${e.time}` : '');
          return (
            <div class="w-full">
              <div class="flex flex-col md:flex-row items-center bg-brand-gray p-2 rounded-lg border-l-4 border-brand-orange hover:bg-white/5 transition-colors">
                <div class="md:w-2/5 text-center md:text-left mb-1 md:mb-0 flex-shrink-0">
                  <span class="block text-sm sm:text-base md:text-lg lg:text-xl font-display font-bold">{e.title.toUpperCase()}</span>
                  <span class="text-xs md:text-sm text-gray-400 uppercase tracking-widest">{e.location}</span>
                </div>
                <div class="md:w-3/5 text-center md:text-left mb-1 md:mb-0 px-2 flex-shrink-0">
                  <span class="block text-sm md:text-base lg:text-lg font-bold text-white">{e.subtitle || e.title}</span>
                  <span class="text-gray-400 text-xs md:text-sm">{displayDate}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="mt-8 text-center">
        <a href={l('/events')} class="inline-flex items-center gap-2 text-gray-400 hover:text-brand-orange transition-colors">
          <i class="fa-solid fa-calendar"></i> {t.home.viewAllEvents}
        </a>
      </div>
    </div>
  </section>

  <!-- Intro: the only real photo on the home page, plus enough copy for search
       engines to know who this is. Photo stacks above the text on phones. -->
  <section id="intro" class="isolate relative py-16 sm:py-24 bg-brand-black border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 md:gap-14 lg:gap-20 items-center max-w-5xl mx-auto" data-reveal>
        <div class="relative w-full max-w-[320px] sm:max-w-[360px] md:max-w-none mx-auto">
          <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl border-2 border-brand-orange" aria-hidden="true"></div>
          <img
            src="/images/dj-zippy-house-music-dj.webp"
            alt={t.home.introPhotoAlt}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="relative block w-full h-auto rounded-2xl"
          />
        </div>
        <div class="text-center md:text-left">
          <h2 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-5">{t.home.introHeading1}<span class="text-brand-orange">{t.home.introHeading2}</span></h2>
          <p class="text-gray-300 text-base md:text-lg leading-relaxed mb-6">{t.home.introBody}</p>
          <ul class="flex flex-wrap justify-center md:justify-start gap-2 mb-8">
            {t.home.introChips.map((c, i) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-gray-200">
                <i class={`${['fa-solid fa-star', 'fa-solid fa-music', 'fa-solid fa-compact-disc', 'fa-solid fa-location-dot'][i] ?? 'fa-solid fa-star'} text-brand-orange`} aria-hidden="true"></i>{c}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap justify-center md:justify-start gap-3">
            <a href={`${l('/')}#contact`} class="inline-flex items-center gap-2 rounded-full bg-brand-orange px-6 py-3 text-sm font-bold text-brand-black hover:bg-white transition-colors">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i> {t.home.introBook}
            </a>
            <a href={l('/about')} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-3 text-sm font-bold text-white hover:border-brand-orange hover:text-brand-orange transition-colors">
              {t.home.introBio} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  function initCoverflow() {
    // === COVERFLOW === (items are server-rendered from the DB)
    // An endless "revolver": `pos` is a continuous position (an integer = a disc
    // is centred) that wraps around forever. Drag / flick / horizontal wheel move
    // it freely, momentum carries a fast flick and always comes to rest on a disc.
    // Every item is a real link; side discs act as buttons that bring that disc to
    // the centre, and only the centred one opens the mix.
    var container = document.getElementById('coverflow-container');
    if (!container || container.dataset.cfReady) return;
    container.dataset.cfReady = '1';
    var root = document.getElementById('cf-root');
    var items = container.querySelectorAll('.coverflow-item');
    var n = items.length;
    if (!n) return;
    var dots = root ? root.querySelectorAll('.cf-dot') : [];
    var status = document.getElementById('cf-status');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var pos = 0;           // continuous position
    var target = 0;        // where the current animation will rest
    var active = -1;       // index of the centred disc
    var anim = null;       // { to, amp, start, tau } — exponential ease-out towards `to`
    var raf = 0;
    var announce = false;  // read the new mix out once the spin settles
    var refocus = null;    // 'item' | 'dot' — move keyboard focus once settled

    function wrap(i) { return ((i % n) + n) % n; }
    function getGap() {
      var vw = window.innerWidth;
      if (vw < 640) return vw * 0.34;
      if (vw < 1024) return vw * 0.2;
      return Math.min(vw * 0.16, 220);
    }

    function setActive(a) {
      active = a;
      items.forEach(function(el, i) {
        var on = i === a;
        el.classList.toggle('active', on);
        if (on) el.removeAttribute('role');
        else el.setAttribute('role', 'button');
        el.setAttribute('aria-label', el.getAttribute(on ? 'data-play' : 'data-show') || '');
      });
      dots.forEach(function(d, i) {
        if (i === a) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }

    function render() {
      var gap = getGap();
      var mobile = window.innerWidth < 640;
      var half = n / 2;
      // discs fade out before they reach the back of the cylinder, where they
      // jump from one side to the other — so the wrap-around is never visible
      var fadeStart = Math.min(mobile ? 1 : 2, half - 0.5);
      var fadeEnd = Math.min(fadeStart + (mobile ? 0.6 : 0.5), half);
      items.forEach(function(el, i) {
        var off = i - pos;
        off -= n * Math.round(off / n);   // shortest way round: [-n/2, n/2]
        var abs = Math.abs(off);
        var tz = abs < 1 ? 80 - abs * 220 : -(abs * 140);
        var ry = -Math.max(-1, Math.min(1, off)) * 55;
        var sc = abs < 1 ? 1.1 - abs * 0.25 : Math.max(0.65, 0.85 - (abs - 1) * 0.15);
        // side discs are dimmed with a filter instead of opacity, so the disc
        // stays solid black rather than letting the orange gradient bleed through
        var br = abs < 1 ? 1 - abs * 0.28 : Math.max(0.5, 0.72 - (abs - 1) * 0.22);
        var sat = 1 - Math.min(abs, 2) * 0.1;
        var op = abs <= fadeStart ? 1 : abs >= fadeEnd ? 0 : 1 - (abs - fadeStart) / (fadeEnd - fadeStart);
        el.style.transform = 'translateY(-50%) translateX(' + (off * gap).toFixed(2) + 'px) translateZ(' + tz.toFixed(2) + 'px) rotateY(' + ry.toFixed(2) + 'deg) scale(' + sc.toFixed(4) + ')';
        el.style.opacity = op.toFixed(3);
        el.style.filter = abs < 0.005 ? 'none' : 'brightness(' + br.toFixed(3) + ') saturate(' + sat.toFixed(3) + ')';
        el.style.zIndex = String(100 - Math.round(abs * 10));
        el.style.visibility = op === 0 ? 'hidden' : '';
        if (op === 0) el.setAttribute('tabindex', '-1');
        else el.removeAttribute('tabindex');
      });
      var a = wrap(Math.round(pos));
      if (a !== active) setActive(a);
    }

    function settle() {
      // keep the numbers small; an integer shift of n changes nothing on screen
      var k = n * Math.floor(pos / n);
      pos -= k; target -= k;
      if (announce && status) status.textContent = (active + 1) + ' / ' + n + ': ' + (items[active].getAttribute('data-play') || '');
      announce = false;
      if (refocus === 'item') items[active].focus({ preventScroll: true });
      else if (refocus === 'dot' && dots[active]) dots[active].focus({ preventScroll: true });
      refocus = null;
    }

    function tick(now) {
      raf = 0;
      if (!anim) return;
      var d = anim.amp * Math.exp(-(now - anim.start) / anim.tau);
      if (Math.abs(d) < 0.003) {
        pos = anim.to; anim = null; render(); settle();
        return;
      }
      pos = anim.to - d;
      render();
      raf = requestAnimationFrame(tick);
    }
    function animateTo(to, tau) {
      target = to;
      if (reduceMotion) { anim = null; pos = to; render(); settle(); return; }
      anim = { to: to, amp: to - pos, start: performance.now(), tau: tau };
      if (!raf) raf = requestAnimationFrame(tick);
    }
    function stop() { anim = null; target = pos; }

    // Buttons / arrow keys: one disc per press, presses stack up so holding a key
    // (or clicking fast) keeps the cylinder spinning.
    function step(dir) {
      announce = true;
      animateTo(Math.round(anim ? target : pos) + dir, 140);
    }
    function goTo(i) {
      var cur = Math.round(anim ? target : pos);
      var d = wrap(i - cur);
      if (d > n / 2) d -= n;
      announce = true;
      animateTo(cur + d, 160);
    }

    // --- drag / flick ---
    var drag = null;
    var suppressClick = false;
    container.addEventListener('pointerdown', function(e) {
      if (e.button !== 0) return;
      suppressClick = false;
      var wasSpinning = !!anim;
      stop();   // grabbing a spinning cylinder stops it under your finger
      drag = { id: e.pointerId, x: e.clientX, startPos: pos, moved: false, wasSpinning: wasSpinning, samples: [{ t: e.timeStamp, p: pos }] };
    });
    container.addEventListener('pointermove', function(e) {
      if (!drag || e.pointerId !== drag.id) return;
      var dx = e.clientX - drag.x;
      if (!drag.moved) {
        if (Math.abs(dx) < 6) return;
        drag.moved = true;
        try { container.setPointerCapture(e.pointerId); } catch (err) {}
        container.classList.add('is-dragging');
      }
      pos = drag.startPos - dx / getGap();
      var s = drag.samples;
      s.push({ t: e.timeStamp, p: pos });
      while (s.length > 2 && e.timeStamp - s[0].t > 100) s.shift();
      render();
    });
    function release(e) {
      if (!drag || e.pointerId !== drag.id) return;
      var d = drag;
      drag = null;
      container.classList.remove('is-dragging');
      if (d.moved) {
        suppressClick = true;
        // flick velocity (discs per ms) over the last ~100ms of the gesture
        var s = d.samples.filter(function(x) { return e.timeStamp - x.t < 100; });
        var v = 0;
        if (s.length >= 2) {
          var dt = s[s.length - 1].t - s[0].t;
          if (dt > 0) v = (s[s.length - 1].p - s[0].p) / dt;
        }
        var fling = Math.abs(v) > 0.0008;
        // project where the momentum would coast to, then rest on the nearest disc
        announce = true;
        animateTo(Math.round(pos + (fling ? v * 380 : 0)), fling ? 380 : 170);
      } else if (d.wasSpinning) {
        // a tap that stopped the spin shouldn't also open/select a mix
        suppressClick = true;
        animateTo(Math.round(pos), 170);
      }
    }
    container.addEventListener('pointerup', release);
    container.addEventListener('pointercancel', release);
    container.addEventListener('dragstart', function(e) { e.preventDefault(); });
    container.addEventListener('click', function(e) {
      if (suppressClick) { suppressClick = false; e.preventDefault(); e.stopPropagation(); }
    }, true);

    // trackpad / shift+wheel horizontal scrolling spins it too
    var wheelTimer = 0;
    container.addEventListener('wheel', function(e) {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      stop();
      pos += e.deltaX / getGap();
      render();
      clearTimeout(wheelTimer);
      wheelTimer = setTimeout(function() { announce = true; animateTo(Math.round(pos), 170); }, 120);
    }, { passive: false });

    items.forEach(function(el, i) {
      el.addEventListener('click', function(e) {
        if (i !== active) { e.preventDefault(); goTo(i); }
      });
      el.addEventListener('keydown', function(e) {
        if (e.key === ' ' && i !== active) { e.preventDefault(); goTo(i); }
      });
    });
    dots.forEach(function(d, i) { d.addEventListener('click', function() { goTo(i); }); });
    var prevBtn = root && root.querySelector('.coverflow-nav.prev');
    var nextBtn = root && root.querySelector('.coverflow-nav.next');
    if (prevBtn) prevBtn.addEventListener('click', function() { step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { step(1); });
    if (root) {
      root.addEventListener('keydown', function(e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        var f = document.activeElement;
        // keep focus on the same kind of control, now pointing at the new mix
        refocus = f && f.classList.contains('coverflow-item') ? 'item' : f && f.classList.contains('cf-dot') ? 'dot' : null;
        step(e.key === 'ArrowRight' ? 1 : -1);
      });
    }

    window.addEventListener('resize', render);
    render();
  }
  document.addEventListener('astro:page-load', initCoverflow);

  // Hero gradient shifts its brand colours vertically as the page scrolls down.
  function initHeroScroll() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.__heroScrollBound) { if (window.__heroApply) window.__heroApply(); return; }
    window.__heroScrollBound = true;
    var ticking = false;
    function apply() {
      ticking = false;
      var hero = document.querySelector('.hero-gradient');
      if (!hero) return;
      var y = window.scrollY || window.pageYOffset || 0;
      var p = Math.max(0, Math.min(1, y / (window.innerHeight * 1.4)));
      hero.style.setProperty('--hero-shift', (26 + p * 54) + '%');
    }
    window.__heroApply = apply;
    window.addEventListener('scroll', function() {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    }, { passive: true });
    apply();
  }
  document.addEventListener('astro:page-load', initHeroScroll);
  </script>
</Layout>
