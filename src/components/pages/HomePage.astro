      .liner__sleeve { width: min(clamp(13rem, 40vw, 25rem), 40vh); }
    }
    /* phones: the credits beside a smaller sleeve, as on wider screens; the
       deck's calendar buttons become icons beside the gig's title (their labels
       stay for screen readers), and the pads drop the place (it is in the deck) */
    @media (max-width: 639px) {
      .dates .deck__main { flex-direction: row; align-items: flex-end; justify-content: space-between; }
