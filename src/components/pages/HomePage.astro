          </div>
          <!-- The other side of the record. Decorative: the same facts are in the
               dates and the side switch, so it is hidden from screen readers. -->
          <div class="hero-flip__face hero-flip__face--a" aria-hidden="true">
            <div class="font-display flex flex-col-reverse items-center">
              <span class="hero-name block text-5xl md:text-7xl lg:text-9xl font-black leading-none" style="text-shadow:0 2px 34px rgba(0,0,0,0.55), 0 1px 2px rgba(0,0,0,0.6);">ZIPPY<span class="hero-side-a">.</span></span>
              <span class="hero-kicker hero-kicker--a mb-2 sm:mb-3 text-[11px] sm:text-xs md:text-sm font-bold uppercase text-white/90" style="text-shadow:0 1px 10px rgba(0,0,0,0.6);">{t.home.kickerA}</span>
            </div>
            <div class="hero-sub font-display text-2xl md:text-4xl lg:text-6xl font-black hero-side-a tracking-tight">CORE MEMORIES</div>
            <p class="hero-side-tag mono-caps hero-side-a">{t.sides.a} · {t.sides.aLabel}</p>
          </div>
        </div>
      </div>

      <div id="highlights" class="hero-stage relative pt-1 sm:pt-2 pb-8 sm:pb-12 z-30">
        <h2 class="sr-only">{t.home.featured1}{t.home.featured2}</h2>
        <div id="ring-root" class="relative" role="region" aria-roledescription="carousel" aria-label={t.home.featured1 + t.home.featured2}>
          <div class="hring" id="ring">
            <a class="hring-item active" style="--sx:0;--y:0;--s:1.08;z-index:100" href={vinyl.link} target="_blank" rel="noopener" draggable="false"
               aria-label={vinyl.playLabel} data-play={vinyl.playLabel} data-show={vinyl.showLabel}
               data-title={vinyl.title} data-platform={vinyl.platformLabel} data-icon={vinyl.platformIcon}>
              <span class="hring-obj sv">
                <span class="sv-slot"><span class="sv-disc"><span class="sv-label" style={vinyl.coverStyle}></span></span></span>
                <span class="sv-sleeve" style={vinyl.coverStyle}>
                  {!vinyl.coverStyle && <span class="sv-sleeve-title font-display">HOUSE<br />MUSIC<br />THERAPY</span>}
                  <span class="sv-cat hring-mono">HMT · {t.home.heroLatestTag}</span>
                </span>
              </span>
            </a>
            <a class="hring-item" style="--sx:0.866;--y:-22.5;--s:0.735;--f:brightness(0.57) saturate(0.78);z-index:25" href={l('/mixes')} draggable="false"
               role="button" aria-label={t.home.showMix.replace('{title}', t.home.heroAllMixes)} data-play={t.home.heroAllMixes} data-show={t.home.showMix.replace('{title}', t.home.heroAllMixes)}
               data-title={t.home.heroAllMixes} data-platform="zippydj.com/mixes" data-icon="fa-solid fa-headphones">
              <span class="hring-obj usb-obj">
                <span class="usb-body"><span class="usb-name font-display">ZIPPY</span><span class="usb-sub hring-mono">{t.home.heroAllMixes} →</span><span class="usb-led"></span></span>
                <span class="usb-plug"></span>
              </span>
            </a>
            <a class="hring-item" style="--sx:-0.866;--y:-22.5;--s:0.735;--f:brightness(0.57) saturate(0.78);z-index:25" href={tape.link} target="_blank" rel="noopener" draggable="false"
               role="button" aria-label={tape.showLabel} data-play={tape.playLabel} data-show={tape.showLabel}
               data-title={tape.title} data-platform={tape.platformLabel} data-icon={tape.platformIcon}>
              <span class="hring-obj tape-obj">
                <span class="tape-label">
                  <span class="tape-strip hring-mono">{tapeStrip}</span>
                  <span class="tape-line">{tapeLine}</span>
                  <span class="tape-side font-display" data-side={tapeSide}>{tapeSide}</span>
                </span>
                <span class="tape-window"><span class="tape-reel"></span><span class="tape-reel"></span></span>
                <span class="tape-teeth"></span>
                <span class="tape-screw" style="left:7px;top:7px"></span><span class="tape-screw" style="right:7px;top:7px"></span>
                <span class="tape-screw" style="left:7px;bottom:7px"></span><span class="tape-screw" style="right:7px;bottom:7px"></span>
              </span>
            </a>
          </div>
          <div class="mt-1" aria-hidden="true">
            <div class="hring-caption-title" id="ring-title">{vinyl.title}</div>
            <div class="hring-caption-platform hring-mono" id="ring-platform"><i class={vinyl.platformIcon}></i> {vinyl.platformLabel}</div>
          </div>
          <div class="flex items-center justify-center gap-3 mt-4">
            <button type="button" class="hring-nav prev" aria-label={t.home.prev}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <div class="flex">
              {[vinyl.showLabel, t.home.showMix.replace('{title}', t.home.heroAllMixes), tape.showLabel].map((label, i) => (
                <button type="button" class="hring-dot" data-index={i} aria-label={label} aria-current={i === 0 ? 'true' : undefined}></button>
              ))}
            </div>
            <button type="button" class="hring-nav next" aria-label={t.home.next}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          </div>
          <p id="ring-status" class="sr-only" aria-live="polite"></p>
        </div>
        {heroLine && (
          <a href={heroLine.href} class="hero-next hring-mono" {...(heroLine.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="hero-next-dot" aria-hidden="true"></span>{heroLine.label}{heroLine.side && <> · {heroLine.side === 'A' ? t.sides.a : t.sides.b}</>}{heroLine.when && <> · {heroLine.when}</>}{heroLine.name && <> · <b class={heroLine.openFormat ? 'is-open' : undefined}>{heroLine.name}</b></>}{heroLine.where && <> · {heroLine.where}</>} →
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- "Played at" tapes. The first venue list is the one screen readers get;
       the loop copy and the black genre tape are decoration. -->
  <section class="tapes bg-brand-black font-display" aria-labelledby="played-at">
    <div class="tape tape--main">
      <h2 id="played-at" class="tape__label">{t.home.playedAt}</h2>
      <div class="tape__viewport">
        <div class="tape__track">
          <ul class="tape__list">
            {t.home.venues.map((v) => <li>{v}</li>)}
          </ul>
          <ul class="tape__list" aria-hidden="true">
            {t.home.venues.map((v) => <li>{v}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="tape tape--sub" aria-hidden="true">
      <div class="tape__viewport">
        <div class="tape__track">
          {[0, 1, 2, 3].map(() => (
            <ul class="tape__list">
              {t.home.tapeWords.map((w) => <li>{w}</li>)}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming dates as a deck: one cue per gig on a waveform timeline -->
  <section id="dates" class="dates isolate relative bg-brand-black" aria-labelledby="dates-heading">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-8">
          <div>
            <p class="eyebrow">{t.home.datesKicker}</p>
            <h2 id="dates-heading" class="section-title mt-3">{t.home.upcoming1}<span class="text-brand-orange">{t.home.upcoming2}</span></h2>
          </div>
          {homeUpcoming.length > 0 && <SideFilter lang={lang} />}
        </div>
        {homeUpcoming.length === 0
          ? (
            <div class="deck-idle" data-reveal>
              <p class="deck-idle__title font-display">{t.home.noUpcoming}</p>
              <div class="deck-idle__main">
                <p class="deck-idle__hint">{t.events.noUpcomingHint}</p>
                <div class="deck-idle__actions">
                  <a href="#contact" class="btn btn--primary">{t.events.bookCta} <span aria-hidden="true">→</span></a>
                  <a href={feedUrl} class="home-link mono-caps">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
                    {t.deck.calSubscribe}
                  </a>
                </div>
              </div>
              {/* The timeline from today, with nothing cued on it yet */}
              <div class="deck-idle__wave" aria-hidden="true">
                <div class="deck-idle__bars">{idleBars.map((h) => <i style={`--h:${h}%`}></i>)}</div>
                <span class="deck-idle__ph"><span class="mono-caps">{t.deck.today}</span></span>
              </div>
            </div>
          )
          : <div data-reveal><DatesDeck lang={lang} events={homeUpcoming} /></div>}
        <div class="mt-6 sm:mt-8 text-center">
          <a href={l('/events')} class="home-link mono-caps">{t.home.viewAllEvents} <span class="home-link__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- The selector: the back of his record. The text comes first in the source,
       so the heading is what gets read first; on screen the sleeve leads. The
       photo is the sleeve with the record half out of it, the copy is the "who is
       DJ Zippy" text for search engines, the numbers come from the events
       archive, and the two sides of the record are the two kinds of nights he
       plays, B (his own) first. -->
  <section id="intro" class="liner isolate relative bg-brand-black" aria-labelledby="intro-heading">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="liner__grid max-w-6xl mx-auto" data-reveal>
        <div class="liner__text">
          <div class="liner__head">
            <p class="eyebrow">{t.home.introKicker}</p>
            <h2 id="intro-heading" class="liner__title section-title">{t.home.introHeading1}<span class="text-brand-side-b">{t.home.introHeading2}</span></h2>
            <p class="liner__quote">{t.home.introQuote.map((line) => <span>{line}<span class="liner__dot">.</span> </span>)}</p>
          </div>
          <div class="liner__body">
            <p class="liner__copy">{t.home.introBody}</p>
            {introStats.length > 0 && (
              <dl class="liner__stats">
                {introStats.map((s) => (
                  <div class="liner__stat">
                    <dt class="mono-caps">{s.label}</dt>
                    <dd class="font-display">{s.n}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="liner__cta">
              <a href={`${l('/')}#contact`} class="btn btn--primary">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i> {t.home.introBook}
              </a>
              <a href={l('/about')} class="btn btn--secondary">
                {t.home.introBio} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>

        <div class="liner__media">
          {/* The sleeve: his photo, printed like a cover, with the record sliding
              out of it (the label takes the accent colour). The print and the
              record are decoration; the photo carries the alt text. */}
          <div class="liner__sleeve" data-liner-sleeve>
            <div class="liner__stage">
              <div class="liner__record" aria-hidden="true"><span class="liner__label"></span></div>
              <div class="liner__cover">
                <img src="/images/dj-zippy-house-music-dj.webp" alt={t.home.introPhotoAlt} width="800" height="800" loading="lazy" decoding="async" />
                <span class="liner__print" aria-hidden="true">
                  <span class="liner__print-name font-display">ZIPPY<span class="text-brand-orange">.</span></span>
                  <span class="liner__print-side mono-caps">
                    <span class="liner__print-b">{t.sides.b} · House Music Therapy</span>
                    <span class="liner__print-a">{t.sides.a} · Core Memories</span>
                  </span>
                </span>
              </div>
            </div>
          </div>
          {/* Credits, as on the back of a sleeve. The plane is a small wink: he flies out for gigs. */}
          <dl class="liner__credits">
            {t.home.introCredits.map((c, i) => (
              <div>
                <dt class="mono-caps">{c.label}</dt>
                <dd>
                  {c.value}
                  {i === t.home.introCredits.length - 1 && (
                    <svg class="liner__plane" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" /></svg>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        {/* The two sides as a tracklist: B leads, A follows. The LED shows the side
            the visitor has picked (B until they pick A). */}
        <div class="liner__sides">
          {introSides.map((s) => (
            <div class={`liner-side liner-side--${s.side.toLowerCase()}`} data-side={s.side}>
              <div class="liner-side__meta" aria-hidden="true">
                <span class="side-key">{s.side}</span>
                <span class="mono-caps">{s.tag}</span>
                <span class="liner-side__led"></span>
              </div>
              <h3 class="liner-side__name font-display"><span class="sr-only">{s.tag}: </span>{s.name}</h3>
              <p class="liner-side__blurb">{s.blurb}</p>
              <ol class="liner-side__tracks">
                {s.tracks.map((tr, i) => (
                  <li>
                    <span class="liner-side__no mono-caps" aria-hidden="true">{s.side}{i + 1}</span>
                    <span class="liner-side__track">{tr.name}</span>
                    {tr.note && <span class="liner-side__note">{tr.note}</span>}
                  </li>
                ))}
              </ol>
              <a href={s.href} class="home-link mono-caps">{s.link} <span class="home-link__arrow" aria-hidden="true">→</span></a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  function initHeroRing() {
    // === HERO RING === vinyl / USB / tape on a turning plate.
    // `pos` is a continuous position (an integer = an object at the front) that
    // wraps around forever. Drag / flick / horizontal wheel turn it freely, momentum
    // carries a fast flick and always comes to rest on an object. Left alone it
    // turns to the next one every 4 bars at 124 BPM, until someone touches it.
    // Every item is a real link; the ones at the back act as buttons that bring
    // that object to the front, and only the front one opens.
    var ring = document.getElementById('ring');
    if (!ring || ring.dataset.ringReady) return;
    ring.dataset.ringReady = '1';
    var root = document.getElementById('ring-root');
    var items = ring.querySelectorAll('.hring-item');
    var n = items.length;
    if (!n) return;
    var dots = root.querySelectorAll('.hring-dot');
    var status = document.getElementById('ring-status');
    var title = document.getElementById('ring-title');
    var platform = document.getElementById('ring-platform');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var STEP = 2 * Math.PI / n;
    var AUTO_MS = 4 * 4 * 60000 / 124;   // 4 bars

    var pos = 0;           // continuous position
    var target = 0;        // where the current animation will rest
    var active = -1;       // index of the object at the front
    var anim = null;       // { to, amp, start, tau } — exponential ease-out towards `to`
    var raf = 0;
    var announce = false;  // read the new object out once the turn settles
    var refocus = null;    // 'item' | 'dot' — move keyboard focus once settled

    function wrap(i) { return ((i % n) + n) % n; }
    // same radius as --ring-r in the CSS; the scale is read from --ring-k
    function ringRadius() { var vw = window.innerWidth; return vw < 640 ? vw * 0.31 : Math.min(200, vw * 0.26); }
    function ringScale() { return parseFloat(getComputedStyle(ring).getPropertyValue('--ring-k')) || 1; }
    function pxPerItem() { return ringRadius() * STEP * 1.15; }

    function setActive(a) {
      active = a;
      items.forEach(function(el, i) {
        var on = i === a;
        el.classList.toggle('active', on);
        if (on) el.removeAttribute('role');
        else el.setAttribute('role', 'button');
        el.setAttribute('aria-label', el.getAttribute(on ? 'data-play' : 'data-show') || '');
      });
      dots.forEach(function(d, i) {
        if (i === a) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      var it = items[a];
      title.textContent = it.getAttribute('data-title');
      platform.innerHTML = '';
      var icon = document.createElement('i');
      icon.className = it.getAttribute('data-icon');
      platform.appendChild(icon);
      platform.appendChild(document.createTextNode(' ' + it.getAttribute('data-platform')));
    }

    function render() {
      var R = ringRadius(), k = ringScale();
      items.forEach(function(el, i) {
        var ang = (i - pos) * STEP;
        var z = (Math.cos(ang) + 1) / 2;   // 1 = front, 0 = back
        var x = Math.sin(ang) * R;
        var y = -(1 - z) * 30 * k;
        var sc = (0.62 + 0.46 * z) * k;
        el.style.transform = 'translate3d(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px,0) scale(' + sc.toFixed(4) + ')';
        el.style.filter = z > 0.995 ? 'none' : 'brightness(' + (0.42 + 0.58 * z).toFixed(3) + ') saturate(' + (0.7 + 0.3 * z).toFixed(3) + ')';
        el.style.zIndex = String(Math.round(z * 100));
      });
      var a = wrap(Math.round(pos));
      if (a !== active) setActive(a);
    }

    function settle() {
      // keep the numbers small; an integer shift of n changes nothing on screen
      var k = n * Math.floor(pos / n);
      pos -= k; target -= k;
      if (announce && status) status.textContent = (active + 1) + ' / ' + n + ': ' + (items[active].getAttribute('data-play') || '');
      announce = false;
      if (refocus === 'item') items[active].focus({ preventScroll: true });
      else if (refocus === 'dot' && dots[active]) dots[active].focus({ preventScroll: true });
      refocus = null;
    }

    function tick(now) {
      raf = 0;
      if (!anim) return;
      var d = anim.amp * Math.exp(-(now - anim.start) / anim.tau);
      if (Math.abs(d) < 0.002) {
        pos = anim.to; anim = null; render(); settle();
        return;
      }
      pos = anim.to - d;
      render();
      raf = requestAnimationFrame(tick);
    }
    function animateTo(to, tau) {
      target = to;
      if (reduceMotion) { anim = null; pos = to; render(); settle(); return; }
      anim = { to: to, amp: to - pos, start: performance.now(), tau: tau };
      if (!raf) raf = requestAnimationFrame(tick);
    }
    function stop() { anim = null; target = pos; }

    // --- auto-turn: stops for good on the first touch, pauses while hovered,
    //     focused, off screen or in a background tab ---
    var touched = false, hovered = false, focused = false, visible = true;
    var autoTimer = reduceMotion ? 0 : setInterval(function() {
      if (!ring.isConnected) { clearInterval(autoTimer); return; }   // page swapped by a view transition
      if (touched || hovered || focused || !visible || document.hidden || anim) return;
      animateTo(Math.round(pos) + 1, 260);
    }, AUTO_MS);
    function interact() {
      touched = true;
      if (autoTimer) { clearInterval(autoTimer); autoTimer = 0; }
    }
    if (autoTimer && 'IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) { visible = entries[0].isIntersecting; }).observe(ring);
    }
    root.addEventListener('pointerenter', function(e) { if (e.pointerType === 'mouse') hovered = true; });
    root.addEventListener('pointerleave', function() { hovered = false; });
    root.addEventListener('focusin', function() { focused = true; });
    root.addEventListener('focusout', function() { focused = false; });

    // Buttons / arrow keys: one object per press, presses stack up so holding a
    // key (or clicking fast) keeps the plate turning.
    function step(dir) {
      announce = true;
      animateTo(Math.round(anim ? target : pos) + dir, 160);
    }
    function goTo(i) {
      var cur = Math.round(anim ? target : pos);
      var d = wrap(i - cur);
      if (d > n / 2) d -= n;
      announce = true;
      animateTo(cur + d, 180);
    }

    // --- drag / flick ---
    var drag = null;
    var suppressClick = false;
    ring.addEventListener('pointerdown', function(e) {
      if (e.button !== 0) return;
      interact();
      suppressClick = false;
      var wasSpinning = !!anim;
      stop();   // grabbing a turning plate stops it under your finger
      drag = { id: e.pointerId, x: e.clientX, startPos: pos, moved: false, wasSpinning: wasSpinning, samples: [{ t: e.timeStamp, p: pos }] };
    });
    ring.addEventListener('pointermove', function(e) {
      if (!drag || e.pointerId !== drag.id) return;
      var dx = e.clientX - drag.x;
      if (!drag.moved) {
        if (Math.abs(dx) < 6) return;
        drag.moved = true;
        try { ring.setPointerCapture(e.pointerId); } catch (err) {}
        ring.classList.add('is-dragging');
      }
      pos = drag.startPos - dx / pxPerItem();
      var s = drag.samples;
      s.push({ t: e.timeStamp, p: pos });
      while (s.length > 2 && e.timeStamp - s[0].t > 100) s.shift();
      render();
    });
    function release(e) {
      if (!drag || e.pointerId !== drag.id) return;
      var d = drag;
      drag = null;
      ring.classList.remove('is-dragging');
      if (d.moved) {
        suppressClick = true;
        // flick velocity (objects per ms) over the last ~100ms of the gesture
        var s = d.samples.filter(function(x) { return e.timeStamp - x.t < 100; });
        var v = 0;
        if (s.length >= 2) {
          var dt = s[s.length - 1].t - s[0].t;
          if (dt > 0) v = (s[s.length - 1].p - s[0].p) / dt;
        }
        var fling = Math.abs(v) > 0.0006;
        // project where the momentum would coast to, then rest on the nearest object
        announce = true;
        animateTo(Math.round(pos + (fling ? v * 480 : 0)), fling ? 480 : 200);
      } else if (d.wasSpinning) {
        // a tap that stopped the turn shouldn't also open/select anything
        suppressClick = true;
        animateTo(Math.round(pos), 200);
      }
    }
    ring.addEventListener('pointerup', release);
    ring.addEventListener('pointercancel', release);
    ring.addEventListener('dragstart', function(e) { e.preventDefault(); });
    ring.addEventListener('click', function(e) {
      if (suppressClick) { suppressClick = false; e.preventDefault(); e.stopPropagation(); }
    }, true);

    // trackpad / shift+wheel horizontal scrolling turns it too
    var wheelTimer = 0;
    ring.addEventListener('wheel', function(e) {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      interact();
      stop();
      pos += e.deltaX / pxPerItem();
      render();
      clearTimeout(wheelTimer);
      wheelTimer = setTimeout(function() { announce = true; animateTo(Math.round(pos), 200); }, 120);
    }, { passive: false });

    items.forEach(function(el, i) {
      el.addEventListener('click', function(e) {
        interact();
        if (i !== active) { e.preventDefault(); goTo(i); }
      });
      el.addEventListener('keydown', function(e) {
        if (e.key === ' ' && i !== active) { e.preventDefault(); interact(); goTo(i); }
      });
    });
    dots.forEach(function(d, i) { d.addEventListener('click', function() { interact(); goTo(i); }); });
    root.querySelector('.hring-nav.prev').addEventListener('click', function() { interact(); step(-1); });
    root.querySelector('.hring-nav.next').addEventListener('click', function() { interact(); step(1); });
    root.addEventListener('keydown', function(e) {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      interact();
      var f = document.activeElement;
      // keep focus on the same kind of control, now pointing at the new object
      refocus = f && f.classList.contains('hring-item') ? 'item' : f && f.classList.contains('hring-dot') ? 'dot' : null;
      step(e.key === 'ArrowRight' ? 1 : -1);
    });

    window.addEventListener('resize', render);
    render();
  }
  // The hero title turns over to the other side while the mouse is on it. A
  // click or tap picks that side for the whole site (src/scripts/sides.ts),
  // which is also what decides the face it rests on.
  function initHeroFlip() {
    var flip = document.getElementById('hero-flip');
    if (!flip || flip.dataset.flipReady) return;
    flip.dataset.flipReady = '1';
    var hero = flip.closest('section');
    var restOnA = document.documentElement.getAttribute('data-side-pick') === 'A';
    var hovered = false;
    function render() {
      var a = hovered ? !restOnA : restOnA;
      flip.classList.toggle('is-a', a);
      if (hero) hero.classList.toggle('is-a', a);
    }
    flip.addEventListener('pointerenter', function(e) { if (e.pointerType === 'mouse') { hovered = true; render(); } });
    flip.addEventListener('pointerleave', function() { hovered = false; render(); });
    flip.addEventListener('click', function() {
      hovered = false;   // show the side just picked until the pointer leaves and comes back
      document.dispatchEvent(new CustomEvent('side:set', { detail: restOnA ? 'all' : 'A' }));
    });
    document.addEventListener('side:change', function(e) {
      if (!flip.isConnected) return;
      restOnA = e.detail === 'A';
      render();
    });
    // a visitor who arrives with the A side already picked sees it at once, not a turn on load
    flip.classList.add('no-turn');
    render();
    requestAnimationFrame(function() { requestAnimationFrame(function() { flip.classList.remove('no-turn'); }); });
  }
  // The selector's sleeve: the record waits tucked in while the sleeve is below
  // the fold and slides out as it comes into view. One already on screen, and
  // every visitor who prefers less motion, simply sees it out.
  function initLiner() {
    var sleeve = document.querySelector('[data-liner-sleeve]');
    if (!sleeve || sleeve.dataset.linerReady) return;
    sleeve.dataset.linerReady = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    if (sleeve.getBoundingClientRect().top < window.innerHeight * 0.9) return;
    // tuck it in without a slide, out of sight
    sleeve.classList.add('is-tucked', 'is-still');
    requestAnimationFrame(function() { requestAnimationFrame(function() { sleeve.classList.remove('is-still'); }); });
    var io = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting) return;
      sleeve.classList.remove('is-tucked');
      io.disconnect();
    }, { threshold: 0.5 });
    io.observe(sleeve);
  }
  document.addEventListener('astro:page-load', initLiner);
  document.addEventListener('astro:page-load', initHeroRing);
  document.addEventListener('astro:page-load', initHeroFlip);
  </script>
</Layout>
