              <button type="button" class="rail__nav" data-rail-next aria-label={t.home.next}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="rail__viewport" data-rail-viewport>
            <ol class="rail__track" data-rail-track>
              {path.map((y) => (
                <li class="path-year">
                  <span class="path-year__dot" aria-hidden="true"></span>
                  <h3 class="path-year__num font-display">{y.year}</h3>
                  <div class="path-year__meta">
