  <script>
    // The B / A switch in "Two sides". It picks the side for the whole site
    // (src/scripts/sides.ts), like the A/B flip in the header. B is where the
    // site rests, so pressing B goes back to "all" instead of filtering the A
    // side out of the lists on other pages.
    function initAboutSides() {
      const seg = document.querySelector<HTMLElement>('[data-about-seg]');
      if (!seg || seg.dataset.ready) return;
      seg.dataset.ready = '1';
      const buttons = seg.querySelectorAll<HTMLButtonElement>('[data-about-side]');
      const sync = (pick: string | null) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.aboutSide === 'A') === (pick === 'A'))));
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('side:set', { detail: b.dataset.aboutSide === 'A' ? 'A' : 'all' }));
      }));
      document.addEventListener('side:change', (e) => {
        if (seg.isConnected) sync((e as CustomEvent).detail);
      });
      sync(document.documentElement.getAttribute('data-side-pick'));
    }
    document.addEventListener('astro:page-load', initAboutSides);
  </script>
</Layout>
