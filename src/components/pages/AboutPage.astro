                            {g.stages.length > 0 && <p class="path-gig__stages">{g.stages.join(' · ')}</p>}
                            <p class="path-gig__meta mono-caps">{day} {month} · {g.location}<span class="sr-only"> · {g.side === 'A' ? t.sides.a : t.sides.b}</span></p>
                            {g.tag && <p class={`path-gig__tag mono-caps${g.first ? ' is-first' : ''}`}>{subtitleText(g.tag, lang)}</p>}
                          </div>
