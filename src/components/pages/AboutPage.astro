  <section id="faq" class="about-section about-section--faq border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="about-faq" data-reveal>
        <div>
          <p class="eyebrow">{t.about.faqLabel}</p>
