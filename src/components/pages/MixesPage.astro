---
import Layout from '../../layouts/Layout.astro';
import SideFilter from '../SideFilter.astro';
import { getMixes, MIX_PLATFORMS, mixIcon, mixFallbackIcon, mixSide, type UIMix } from '../../lib/content';
import { useTranslations, localize, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const db = (Astro.locals as any).runtime?.env?.DB;
const { all: mixes } = await getMixes(db);

const initialPlatform = 'youtube';
// A side or B side: by genre, and by title for playlists whose genre only names
// the platform (mixSide() in src/lib/content.ts). The side switch only earns its
// place once there is something on both sides.
const bothSides = new Set(mixes.map(mixSide)).size > 1;

const pageUrl = `https://zippydj.com${l('/mixes')}`;
const isPlaylist = (m: UIMix) => m.platform === 'spotify' || m.platform === 'deezer';
const sets = mixes.filter((m) => !isPlaylist(m));

// Build JSON-LD from the live data so it stays in sync with admin edits. The sets
// are listed as recordings that link out to where they play (the page embeds no
// players, so no VideoObject); playlists are MusicPlaylists.
const mixSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.breadcrumb.home, "item": `https://zippydj.com${l('/')}` },
        { "@type": "ListItem", "position": 2, "name": t.breadcrumb.mixes, "item": pageUrl }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#collection`,
      "url": pageUrl,
      "name": t.mixes.schemaName,
      "description": t.mixes.schemaDesc,
      "inLanguage": htmlLang[lang],
      "about": { "@id": "https://zippydj.com/#person" }
    },
    ...(sets.length ? [{
      "@type": "ItemList",
      "@id": `${pageUrl}#sets`,
      "numberOfItems": sets.length,
      "itemListElement": sets.map((m, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "MusicRecording",
          "@id": `${pageUrl}#${m.slug}`,
          "name": m.title,
          "url": m.link,
          ...(m.thumbnail ? { "image": m.thumbnail } : {}),
          ...(m.genre ? { "genre": m.genre } : {}),
          "byArtist": { "@id": "https://zippydj.com/#person" }
        }
      }))
    }] : []),
    ...mixes.filter(isPlaylist).map(m => ({
      "@type": "MusicPlaylist",
      "@id": `${pageUrl}#${m.slug}`,
      "name": m.title,
      "description": m.description,
      "url": m.link,
      "creator": { "@id": "https://zippydj.com/#person" }
    }))
  ]
};
---

<Layout lang={lang} title={t.mixes.title} description={t.mixes.description} activePage="mixes">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(mixSchema)} />

  <style is:global>
    /* === /mixes ===
       A card is the cover and nothing else. The details come up over it on hover
       or keyboard focus; on touch screens, where there is no hover, they sit along
       the bottom edge all the time. A set with no cover gets a sleeve: its side's
       colour, record grooves and the platform's mark. */

    /* Platform tabs: icons alone below 1280px, where the logos speak for themselves
       (with names, the tabs and the side switch would not share one line) */
    .mix-tab {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.625rem 0.75rem;
      border-bottom: 2px solid transparent;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      white-space: nowrap;
      color: #9ca3af;
      transition: color 0.2s, border-color 0.2s, opacity 0.2s;
    }
    .mix-tab i { font-size: 1.125rem; }
    .mix-tab:hover { color: #fff; }
    .mix-tab[aria-selected="true"] { color: #fff; border-color: rgb(var(--accent-rgb)); }
    /* nothing on the picked side here */
    .mix-tab[data-empty]:not([aria-selected="true"]) { opacity: 0.35; }
    .mix-tab:focus-visible { outline: 2px solid #fff; outline-offset: -2px; border-radius: 0.5rem; }
    @media (min-width: 640px) { .mix-tab { padding-inline: 1rem; } }
    @media (min-width: 1280px) { .mix-tab { padding-inline: 1.25rem; } .mix-tab i { font-size: 0.875rem; } }

    .mix-card {
      position: relative;
      display: block;
      flex: 0 0 auto;
      overflow: hidden;
      border-radius: 0.9rem;
      border: 1px solid rgba(255,255,255,0.1);
      background: #000;
      transition: border-color 0.3s;
      container-type: inline-size;
    }
    .mix-card[data-side="A"] { --card-rgb: var(--side-a-rgb); }
    .mix-card[data-side="B"] { --card-rgb: var(--side-b-rgb); }
    .mix-card.hidden { display: none; }   /* the platform tabs hide cards with Tailwind's .hidden */
    .mix-card--wide { width: 84%; aspect-ratio: 16 / 9; }
    .mix-card--square { width: 66%; aspect-ratio: 1; }
    @media (min-width: 640px) {
      .mix-card--wide { width: calc((100% - 1rem) / 2.2); }
      .mix-card--square { width: calc((100% - 2rem) / 3.2); }
    }
    @media (min-width: 1024px) {
      .mix-card--wide { width: calc((100% - 3rem) / 3.25); }
      .mix-card--square { width: calc((100% - 4rem) / 4.25); }
    }
    .mix-card:hover, .mix-card:focus-visible { border-color: var(--side, rgb(var(--accent-rgb))); }
    .mix-card:focus { outline: none; }
    .mix-card:focus-visible { outline: 2px solid #fff; outline-offset: -2px; }
    .mix-card__art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .mix-card:hover .mix-card__art { transform: scale(1.05); }
    .mix-card__info {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 1rem;
      /* dark where the words are, lighter in the middle so the cover still shows */
      background: linear-gradient(to bottom, rgba(5,5,5,0.84) 0%, rgba(5,5,5,0.58) 36%, rgba(5,5,5,0.74) 58%, rgba(5,5,5,0.95) 100%);
      opacity: 0;
      transition: opacity 0.25s;
    }
    .mix-card:hover .mix-card__info, .mix-card:focus-visible .mix-card__info { opacity: 1; }
    .mix-card__genre { display: flex; align-items: center; gap: 0.5rem; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--side, rgb(var(--accent-rgb))); }
    .mix-card__title { font-family: 'Unbounded', sans-serif; font-size: clamp(0.875rem, 4.2cqi, 1.125rem); font-weight: 700; line-height: 1.35; color: #fff; }
    .mix-card__listen { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.625rem; font-size: 0.8125rem; font-weight: 700; color: var(--side, rgb(var(--accent-rgb))); }
    /* A dark label rather than a coloured sticker: covers often carry their own
       orange lettering up there. The light is in the other side's colour. */
    .mix-card__badge {
      position: absolute;
      top: 0.625rem;
      right: 0.625rem;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.55rem;
      border-radius: 0.45rem;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(5,5,5,0.72);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      color: #fff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      line-height: 1;
      transition: opacity 0.25s;
    }
    .mix-card__badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: rgb(var(--alt-rgb)); box-shadow: 0 0 6px rgb(var(--alt-rgb) / 0.8); }
    .mix-card:hover .mix-card__badge, .mix-card:focus-visible .mix-card__badge { opacity: 0; }

    /* No cover image: a sleeve instead, and the details show all the time */
    .mix-card--bare { background: #0a0a0a; }
    .mix-card__sleeve {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background:
        radial-gradient(120% 85% at 100% 0%, rgb(var(--card-rgb) / 0.3), transparent 62%),
        repeating-radial-gradient(circle at 112% 112%, rgba(255,255,255,0.05) 0 1px, transparent 1px 7px),
        linear-gradient(160deg, #181818, #080808);
      transition: opacity 0.3s;
    }
    .mix-card__glyph { position: absolute; right: -0.12em; bottom: -0.18em; font-size: 62cqi; line-height: 1; color: rgba(255,255,255,0.07); transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .mix-card--bare:hover .mix-card__glyph { transform: rotate(-6deg) scale(1.05); }
    .mix-card--bare .mix-card__info { opacity: 1; background: none; padding: 1.125rem; }
    .mix-card--bare .mix-card__title { font-size: clamp(0.95rem, 6.2cqi, 1.375rem); line-height: 1.25; }

    @media (hover: none) {
      .mix-card__info {
        opacity: 1;
        justify-content: flex-end;
        background: linear-gradient(to top, rgba(5,5,5,0.94) 0%, rgba(5,5,5,0.6) 42%, rgba(5,5,5,0) 72%);
      }
      .mix-card--bare .mix-card__info { justify-content: space-between; background: none; }
      .mix-card__listen { display: none; }
      .mix-card:not(.mix-card--bare) .mix-card__title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mix-card__art, .mix-card__info, .mix-card__glyph { transition: none; }
      .mix-card:hover .mix-card__art, .mix-card--bare:hover .mix-card__glyph { transform: none; }
    }
  </style>

  <section class="isolate relative min-h-[40vh] flex flex-col items-center justify-center bg-brand-black pt-24 sm:pt-28 pb-10 sm:pb-12 overflow-hidden">
    <div class="aurora absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 text-center z-30">
      <nav aria-label={t.breadcrumb.label} class="mb-6">
        <ol class="flex justify-center items-center space-x-2 text-sm text-gray-400">
          <li><a href={l('/')} class="inline-block py-2.5 -my-2.5 hover:text-brand-orange transition-colors">{t.breadcrumb.home}</a></li>
          <li class="text-white" aria-current="page"><span class="ml-2 mr-4 text-gray-400" aria-hidden="true">/</span>{t.breadcrumb.mixes}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-4">{t.mixes.heading}</h1>
      <h2 class="font-display text-xl md:text-2xl lg:text-3xl font-bold text-brand-orange mb-4">{t.mixes.subheading1}{t.mixes.subheading2}{t.mixes.subheading3}</h2>
      <p class="text-gray-400 text-base sm:text-lg md:text-xl max-w-2xl mx-auto">{t.mixes.lead}</p>
    </div>
  </section>

  <section id="all-mixes" class="isolate relative pt-8 pb-16 sm:py-16 lg:py-20 bg-brand-black border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      {/* One row per platform. Past the third card the row slides sideways (drag,
          flick, arrows, arrow keys) instead of wrapping onto a new line. */}
      <div class="rail" data-rail id="mixes-rail">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-4 mb-6 sm:mb-8">
          <div class="flex flex-nowrap gap-1 sm:gap-2 lg:gap-3" id="mixes-tabs" role="tablist" aria-label={t.mixes.filterLabel}>
            {MIX_PLATFORMS.map(p => {
              const active = p.id === initialPlatform;
              return (
                <button type="button" id={`mixes-tab-${p.id}`} role="tab" class="mix-tab" aria-selected={active ? 'true' : 'false'} aria-controls="mixes-panel"
                  tabindex={active ? '0' : '-1'} data-platform={p.id} title={p.label}>
                  {/* the logos are familiar enough to stand alone below 1280px */}
                  <i class={p.icon} aria-hidden="true"></i><span class="sr-only xl:not-sr-only">{p.label}</span>
                </button>
              );
            })}
          </div>
          <div class="flex items-center gap-3 sm:ml-auto">
            {bothSides && <SideFilter lang={lang} />}
            <button type="button" class="rail__nav" data-rail-prev aria-label={t.home.prev} aria-controls="mixes-panel"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="rail__nav" data-rail-next aria-label={t.home.next} aria-controls="mixes-panel"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          </div>
        </div>
        <div class="rail__viewport" data-rail-viewport data-reveal id="mixes-panel" role="tabpanel" aria-labelledby={`mixes-tab-${initialPlatform}`}>
          <div class="rail__track" data-rail-track id="mixes-grid">
            {mixes.map(m => {
              const side = mixSide(m);
              // YouTube thumbnails are 16:9; Spotify, MixCloud, SoundCloud and Deezer covers are square
              const wide = m.platform === 'youtube';
              return (
                <a
                  href={m.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  draggable="false"
                  class={`mix-card ${wide ? 'mix-card--wide' : 'mix-card--square'} ${m.thumbnail ? '' : 'mix-card--bare'} ${m.platform === initialPlatform ? '' : 'hidden'}`}
                  data-platform={m.platform}
                  data-side={side}
                  data-side-item={bothSides ? side : undefined}
                >
                  {m.thumbnail
                    ? <img src={m.thumbnail} alt="" loading="lazy" decoding="async" draggable="false" width={wide ? 1280 : 640} height={wide ? 720 : 640} class="mix-card__art" />
                    : <div class="mix-card__sleeve" aria-hidden="true"><i class={`${mixFallbackIcon(m.platform)} mix-card__glyph`}></i></div>
                  }
                  {m.featured && <span class="mix-card__badge">{t.mixes.featuredBadge}</span>}
                  <div class="mix-card__info">
                    <div class="mix-card__genre">
                      <span class="side-key" aria-hidden="true">{side}</span>
                      <span class="sr-only">{side === 'A' ? t.sides.a : t.sides.b}:</span>
                      {m.genre}
                    </div>
                    <div>
                      <h3 class="mix-card__title">{m.title}</h3>
                      <span class="mix-card__listen"><i class={mixIcon(m.platform)} aria-hidden="true"></i> {t.mixes.listenNow}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
        <div class="rail__bar" data-rail-bar aria-hidden="true"><span></span></div>
      </div>
      <p id="mixes-empty" class="hidden text-gray-400 text-center py-12">{t.mixes.empty}</p>
    </div>
  </section>

  <script>
    // Platform tabs (ARIA tabs: arrow keys, Home / End, the selected one is the
    // only tab stop), and how they get along with the A side / B side switch:
    // a side with nothing on the open platform moves the row to one that has.
    type Api = { onSide: () => void };
    let api: Api | null = null;

    function initMixesTabs() {
      const grid = document.getElementById('mixes-grid');
      if (!grid || grid.dataset.mixReady) return;
      grid.dataset.mixReady = '1';
      const rail = document.getElementById('mixes-rail');
      const panel = document.getElementById('mixes-panel');
      const emptyMsg = document.getElementById('mixes-empty');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.mix-card'));
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#mixes-tabs [role="tab"]'));
      if (!tabs.length) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = (tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0]).dataset.platform ?? '';

      const picked = () => document.documentElement.getAttribute('data-side-pick');
      const onSide = (card: HTMLElement) => {
        const side = picked();
        return !side || !card.dataset.sideItem || card.dataset.sideItem === side;
      };
      const countFor = (platform: string) => cards.filter((c) => c.dataset.platform === platform && onSide(c)).length;

      function setFilter(platform: string, animate: boolean) {
        current = platform;
        const shown: HTMLElement[] = [];
        cards.forEach((card) => {
          const match = card.dataset.platform === platform;
          card.classList.toggle('hidden', !match);
          if (match && onSide(card)) shown.push(card);
        });
        rail?.dispatchEvent(new CustomEvent('rail:refresh'));
        emptyMsg?.classList.toggle('hidden', shown.length !== 0);
        tabs.forEach((tab) => {
          const on = tab.dataset.platform === platform;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
          if (on) panel?.setAttribute('aria-labelledby', tab.id);
          tab.toggleAttribute('data-empty', countFor(tab.dataset.platform ?? '') === 0);
        });
        if (animate && !reduce) {
          // the new row deals itself in, card after card
          shown.forEach((card, i) => {
            card.animate(
              [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
              { duration: 420, delay: Math.min(i, 5) * 45, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
            );
          });
        }
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          if (tab.dataset.platform !== current) setFilter(tab.dataset.platform ?? '', true);
        });
        tab.addEventListener('keydown', (e) => {
          let n = -1;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          if (n < 0) return;
          e.preventDefault();
          tabs[n].focus();
          setFilter(tabs[n].dataset.platform ?? '', true);
        });
      });

      api = {
        onSide() {
          if (!grid.isConnected) return;
          if (countFor(current) === 0) {
            const other = tabs.find((tab) => countFor(tab.dataset.platform ?? '') > 0);
            if (other) { setFilter(other.dataset.platform ?? '', true); return; }
          }
          setFilter(current, false);
        },
      };
      // a side may already be picked (it holds across pages)
      api.onSide();
    }

    document.addEventListener('side:change', () => api?.onSide());
    document.addEventListener('astro:page-load', initMixesTabs);
  </script>
</Layout>
