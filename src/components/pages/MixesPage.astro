---
import Layout from '../../layouts/Layout.astro';
import SideFilter from '../SideFilter.astro';
import { getMixes, MIX_PLATFORMS, mixIcon, mixFallbackIcon, mixSide } from '../../lib/content';
import { useTranslations, localize, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const db = (Astro.locals as any).runtime?.env?.DB;
const { all: mixes } = await getMixes(db);

const initialPlatform = 'youtube';
// The side switch only earns its place once there is something on both sides.
const bothSides = new Set(mixes.map(mixSide)).size > 1;

function ytId(link: string): string | null {
  const m = link.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  return m ? m[1] : null;
}

const pageUrl = `https://zippydj.com${l('/mixes')}`;

// Build JSON-LD from the live data so it stays in sync with admin edits.
const mixSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.breadcrumb.home, "item": `https://zippydj.com${l('/')}` },
        { "@type": "ListItem", "position": 2, "name": t.breadcrumb.mixes, "item": pageUrl }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#collection`,
      "url": pageUrl,
      "name": t.mixes.schemaName,
      "description": t.mixes.schemaDesc,
      "inLanguage": htmlLang[lang],
      "about": { "@id": "https://zippydj.com/#person" }
    },
    ...mixes.filter(m => m.platform === 'youtube' && ytId(m.link)).map(m => ({
      "@type": "VideoObject",
      "@id": `${pageUrl}#${m.slug}`,
      "name": `${m.title} — DJ Zippy`,
      "description": m.description,
      "thumbnailUrl": m.thumbnail || `https://img.youtube.com/vi/${ytId(m.link)}/maxresdefault.jpg`,
      "uploadDate": "2024-01-01T00:00:00+00:00",
      "embedUrl": `https://www.youtube.com/embed/${ytId(m.link)}`,
      "url": m.link,
      "publisher": { "@id": "https://zippydj.com/#organization" }
    })),
    ...mixes.filter(m => m.platform === 'spotify' || m.platform === 'deezer').map(m => ({
      "@type": "MusicPlaylist",
      "@id": `${pageUrl}#${m.slug}`,
      "name": m.title,
      "description": m.description,
      "url": m.link,
      "creator": { "@id": "https://zippydj.com/#person" }
    }))
  ]
};
---

<Layout lang={lang} title={t.mixes.title} description={t.mixes.description} activePage="mixes">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(mixSchema)} />

  <section class="isolate relative min-h-[40vh] flex flex-col items-center justify-center bg-brand-black pt-24 sm:pt-28 pb-12 overflow-hidden">
    <div class="aurora absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 text-center z-30">
      <nav aria-label={t.breadcrumb.label} class="mb-6">
        <ol class="flex justify-center items-center space-x-2 text-sm text-gray-400">
          <li><a href={l('/')} class="hover:text-brand-orange transition-colors">{t.breadcrumb.home}</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-white">{t.breadcrumb.mixes}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-4">{t.mixes.heading}</h1>
      <h2 class="font-display text-xl md:text-2xl lg:text-3xl font-bold text-brand-orange mb-4">{t.mixes.subheading1}<span class="text-brand-orange">{t.mixes.subheading2}</span>{t.mixes.subheading3}</h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto mb-8">{t.mixes.lead}</p>
    </div>
  </section>

  <section id="all-mixes" class="isolate relative py-16 sm:py-20 bg-brand-dark border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      {/* One row per platform. Past the third card the row slides sideways (drag,
          flick, arrows, arrow keys) instead of wrapping onto a new line. */}
      <div class="rail" data-rail id="mixes-rail">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-4 mb-8">
          <div class="flex flex-nowrap gap-1 sm:gap-2 lg:gap-4" id="mixes-tabs" role="tablist" aria-label={t.mixes.filterLabel}>
            {MIX_PLATFORMS.map(p => {
              const active = p.id === initialPlatform;
              return (
                <button id={`mixes-tab-${p.id}`} role="tab" aria-selected={active ? 'true' : 'false'} data-platform={p.id} title={p.label}
                  class={`flex items-center gap-2 px-3 sm:px-4 lg:px-5 py-2.5 text-sm font-bold uppercase whitespace-nowrap border-b-2 transition-colors ${active ? 'border-brand-orange text-white' : 'border-transparent text-gray-500 hover:text-white'}`}>
                  {/* the logos are familiar enough to stand alone on narrow screens */}
                  <i class={`${p.icon} text-lg lg:text-sm`} aria-hidden="true"></i> <span class="sr-only lg:not-sr-only">{p.label}</span>
                </button>
              );
            })}
          </div>
          <div class="flex items-center gap-3 ml-auto">
            {bothSides && <SideFilter lang={lang} />}
            <button type="button" class="rail__nav" data-rail-prev aria-label={t.home.prev}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="rail__nav" data-rail-next aria-label={t.home.next}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
          </div>
        </div>
        <div class="rail__viewport" data-rail-viewport data-reveal>
          <div class="rail__track" data-rail-track id="mixes-grid">
            {mixes.map(m => {
              const side = mixSide(m);
              // YouTube thumbnails are 16:9; Spotify, MixCloud, SoundCloud and Deezer covers are square
              const wide = m.platform === 'youtube';
              return (
                <a
                  href={m.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  draggable="false"
                  class={`mix-card ${wide ? 'mix-card--wide' : 'mix-card--square'} ${m.thumbnail ? '' : 'mix-card--bare'} ${m.platform === initialPlatform ? '' : 'hidden'}`}
                  data-platform={m.platform}
                  data-side={side}
                  data-side-item={bothSides ? side : undefined}
                >
                  {m.thumbnail
                    ? <img src={m.thumbnail} alt={m.alt} loading="lazy" decoding="async" draggable="false" width={wide ? 1280 : 640} height={wide ? 720 : 640} class="mix-card__art" />
                    : <div class="absolute inset-0 bg-gradient-to-br from-brand-gray to-brand-black flex items-center justify-center"><i class={`${mixFallbackIcon(m.platform)} text-6xl text-white/10`}></i></div>
                  }
                  {m.featured && <span class="mix-card__badge">{t.mixes.featuredBadge}</span>}
                  <div class="mix-card__info">
                    <div class="mix-card__genre">
                      <span class="side-key" aria-hidden="true">{side}</span>
                      <span class="sr-only">{side === 'A' ? t.sides.a : t.sides.b}:</span>
                      {m.genre}
                    </div>
                    <div>
                      <h3 class="mix-card__title">{m.title}</h3>
                      <span class="mix-card__listen"><i class={mixIcon(m.platform)} aria-hidden="true"></i> {t.mixes.listenNow}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
        <div class="rail__bar" data-rail-bar aria-hidden="true"><span></span></div>
      </div>
      <p id="mixes-empty" class="hidden text-gray-400 text-center py-12">{t.mixes.empty}</p>
    </div>
  </section>

  <script is:inline>
  function initMixesTabs() {
    var grid = document.getElementById('mixes-grid');
    if (!grid || grid.dataset.mixReady) return;
    grid.dataset.mixReady = '1';
    var cards = Array.prototype.slice.call(document.querySelectorAll('.mix-card'));
    var tabs = Array.prototype.slice.call(document.querySelectorAll('#mixes-tabs button'));
    var emptyMsg = document.getElementById('mixes-empty');
    var current = 'youtube';
    if (!cards.length && !tabs.length) return;

    function setFilter(platform) {
      var shown = 0;
      cards.forEach(function(card) {
        var match = card.getAttribute('data-platform') === platform;
        card.classList.toggle('hidden', !match);
        // a card can also be hidden by the A side / B side switch
        if (match && getComputedStyle(card).display !== 'none') shown++;
      });
      current = platform;
      var rail = document.getElementById('mixes-rail');
      if (rail) rail.dispatchEvent(new CustomEvent('rail:refresh'));
      if (emptyMsg) emptyMsg.classList.toggle('hidden', shown !== 0);
      tabs.forEach(function(tab) {
        var match = tab.getAttribute('data-platform') === platform;
        tab.classList.toggle('border-brand-orange', match);
        tab.classList.toggle('text-white', match);
        tab.classList.toggle('border-transparent', !match);
        tab.classList.toggle('text-gray-500', !match);
        tab.setAttribute('aria-selected', match ? 'true' : 'false');
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() { setFilter(tab.getAttribute('data-platform')); });
    });
    // the A side / B side switch can empty a tab, so the "no mixes" line is re-checked
    document.addEventListener('side:change', function() { if (grid.isConnected) setFilter(current); });
  }
  document.addEventListener('astro:page-load', initMixesTabs);
  </script>
</Layout>
