---
import Layout from '../../layouts/Layout.astro';
import SideFilter from '../SideFilter.astro';
import CalendarActions from '../CalendarActions.astro';
import PastGigRow from '../PastGigRow.astro';
import { getEvents, eventInterval, eventSound, eventSide, type UIEvent } from '../../lib/content';
import { useTranslations, localize, dateParts, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const db = (Astro.locals as any).runtime?.env?.DB;
const { upcoming, past } = await getEvents(db);

// The archive: past gigs grouped by year, newest first. Each year shows its
// highlights plus its most recent nights (YEAR_ROWS lines at most) and folds
// the rest away.
const YEAR_ROWS = 5;
const newestFirst = (a: UIEvent, b: UIEvent) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0);
const years = [...new Set(past.map(e => e.date.slice(0, 4)))].sort().reverse().map(year => {
  const gigs = past.filter(e => e.date.startsWith(year)).sort(newestFirst);
  const featured = gigs.filter(e => e.featured);
  const recent = gigs.filter(e => !e.featured).slice(0, Math.max(0, YEAR_ROWS - featured.length));
  const top = gigs.filter(e => featured.includes(e) || recent.includes(e));
  const a = gigs.filter(e => eventSide(e) === 'A').length;
  return { year, total: gigs.length, top, rest: gigs.filter(e => !top.includes(e)), a, b: gigs.length - a };
});

const pageUrl = `https://zippydj.com${l('/events')}`;

const toMusicEvent = (e: typeof upcoming[number]) => {
  const { start, end } = eventInterval(e);
  return {
    "@type": "MusicEvent",
    "@id": `${pageUrl}#${e.slug}`,
    "name": `${e.title} — ${e.subtitle || (eventSound(e).openFormat ? 'Open Format Night' : 'House Music Therapy')}`,
    "startDate": start,
    "endDate": end,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "inLanguage": htmlLang[lang],
    "location": {
      "@type": "Place",
      "name": e.title,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": e.location,
        "addressCountry": e.country
      }
    },
    "performer": {
      "@type": ["Person","MusicGroup"],
      "@id": "https://zippydj.com/#person",
      "name": "DJ Zippy",
      "alternateName": "Zippy"
    },
    "organizer": {
      "@type": "Organization",
      "@id": "https://zippydj.com/#organization",
      "name": "DJ Zippy",
      "url": "https://zippydj.com"
    },
    "offers": {
      "@type": "Offer",
      "url": pageUrl,
      "availability": "https://schema.org/InStock",
      "price": "0",
      "priceCurrency": "EUR",
      "validFrom": `${e.date}T00:00:00`
    },
    "url": pageUrl,
    "image": "https://zippydj.com/images/dj-zippy-house-music-dj.webp",
    "description": t.schema.eventDescription(e.title, e.location)
  };
};

const musicEventSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.breadcrumb.home, "item": `https://zippydj.com${l('/')}` },
        { "@type": "ListItem", "position": 2, "name": t.breadcrumb.events, "item": pageUrl }
      ]
    },
    ...upcoming.map(toMusicEvent),
    ...past.map(toMusicEvent)
  ]
};
---

<Layout lang={lang} title={t.events.title} description={t.events.description} activePage="events">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(musicEventSchema)} />

  <section id="upcoming" class="isolate relative bg-brand-black pt-24 sm:pt-28 pb-16 overflow-hidden">
    <div class="aurora absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 z-30 relative">
      <nav aria-label={t.breadcrumb.label} class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-400">
          <li><a href={l('/')} class="hover:text-brand-orange transition-colors">{t.breadcrumb.home}</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-white">{t.breadcrumb.events}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-2">{t.events.heading}</h1>
      <h2 class="font-display text-xl md:text-2xl lg:text-3xl font-bold leading-tight mb-4 text-brand-orange">{t.events.subheading}</h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mb-6">{t.events.lead}</p>
      <SideFilter lang={lang} class="mb-10" />
      <div class="flex items-center gap-4 mb-6">
        <div class="w-2 h-8 bg-brand-orange"></div>
        <h3 class="font-display text-2xl md:text-3xl font-bold">{t.events.upcoming1}<span class="text-brand-orange">{t.events.upcoming2}</span></h3>
      </div>
      <div class="space-y-3" data-reveal data-side-list>
        {upcoming.length === 0 && <p class="text-gray-400">{t.events.noUpcoming}</p>}
        {upcoming.map(e => {
          const { day, month, year } = dateParts(e.date, lang);
          const sound = eventSound(e);
          const side = eventSide(e);
          return (
            <article class="upcoming-row" data-side-item={side} data-side={side}>
              <div class="flex-shrink-0 text-center min-w-[3.5rem] sm:min-w-[4rem]">
                <span class="block font-display font-bold text-xl leading-none" style="color:var(--side)">{day}</span>
                <span class="block text-xs text-gray-400 uppercase tracking-widest">{month}</span>
                <span class="block text-xs text-gray-400">{year}</span>
              </div>
              <div class="w-px self-stretch bg-white/10 flex-shrink-0"></div>
              <div class="flex-1 min-w-0">
                <h4 class="font-display font-bold text-white text-base sm:text-lg leading-tight">{e.title}{sound.name && <span class="font-body font-normal text-gray-300 text-sm sm:text-base"> — {sound.name}</span>}</h4>
                <p class="text-gray-400 text-sm">{e.location}{e.time ? ` · ${e.time}` : ''}</p>
                <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs sm:text-sm font-semibold text-gray-200">
                  <span class="side-key" aria-hidden="true">{side}</span>
                  <span class="sr-only">{side === 'A' ? t.sides.a : t.sides.b}:</span>
                  {sound.openFormat
                    ? <span style="color:var(--side-a)">{t.events.openFormat}</span>
                    : sound.genres.map((g, i) => <span class="whitespace-nowrap">{i > 0 && <span class="text-brand-orange mr-2" aria-hidden="true">·</span>}{g}</span>)}
                </p>
              </div>
              <CalendarActions lang={lang} event={e} compact class="flex-shrink-0 self-center flex-col sm:flex-row" />
            </article>
          );
        })}
        <p class="text-gray-400" data-side-empty hidden>{t.sides.empty}</p>
      </div>
    </div>
  </section>

  <section id="past" class="isolate relative py-16 sm:py-20 bg-brand-black border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex items-center gap-4 mb-10">
        <div class="w-2 h-8 bg-white/30"></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold">{t.events.past1}<span class="text-gray-400">{t.events.past2}</span></h2>
      </div>
      {/* One panel per year: the year in large type, how its nights split between
          the two sides, then its highlights and most recent gigs. */}
      <div class="space-y-4">
        {years.map(y => (
          <section class="year-panel" data-reveal aria-label={y.year}>
            <div class="year-panel__head">
              <h3 class="font-display font-bold leading-none text-5xl lg:text-[3.5rem]">{y.year}</h3>
              <div>
                <div class="year-split" aria-hidden="true">
                  {y.a > 0 && <i style={`flex:${y.a};background:var(--side-a)`}></i>}
                  {y.b > 0 && <i style={`flex:${y.b};background:var(--side-b)`}></i>}
                </div>
                <p class="mono-caps mt-2 text-[0.6875rem] text-gray-400" aria-hidden="true">{y.a} A · {y.b} B</p>
                <p class="sr-only">{t.events.yearSummary.replace('{n}', String(y.total)).replace('{a}', String(y.a)).replace('{b}', String(y.b))}</p>
              </div>
            </div>
            <div class="min-w-0" data-side-list>
              <ol>
                {y.top.map(e => <PastGigRow lang={lang} event={e} />)}
              </ol>
              {y.rest.length > 0 && (
                <details class="year-more">
                  <summary>{t.events.showAllYear.replace('{n}', String(y.total))} <i class="fa-solid fa-chevron-right year-more__chevron" aria-hidden="true"></i></summary>
                  <ol>
                    {y.rest.map(e => <PastGigRow lang={lang} event={e} />)}
                  </ol>
                </details>
              )}
              <p class="px-3 py-2 text-sm text-gray-400" data-side-empty hidden>{t.sides.empty}</p>
            </div>
          </section>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href={l('/')} class="inline-flex items-center gap-2 text-gray-400 hover:text-brand-orange transition-colors">
          <i class="fa-solid fa-arrow-left"></i> {t.events.backHome}
        </a>
      </div>
    </div>
  </section>

</Layout>
