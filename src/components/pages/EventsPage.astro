---
import Layout from '../../layouts/Layout.astro';
import { getEvents, eventInterval, eventSound } from '../../lib/content';
import { useTranslations, localize, dateParts, htmlLang, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

const db = (Astro.locals as any).runtime?.env?.DB;
const { upcoming, past } = await getEvents(db);
// `past` is already featured-first, then newest first.
const highlights = past.filter(e => e.featured);
const others = past.filter(e => !e.featured);

const pageUrl = `https://zippydj.com${l('/events')}`;

const toMusicEvent = (e: typeof upcoming[number]) => {
  const { start, end } = eventInterval(e);
  return {
    "@type": "MusicEvent",
    "@id": `${pageUrl}#${e.slug}`,
    "name": `${e.title} — ${e.subtitle || (eventSound(e).openFormat ? 'Open Format Night' : 'House Music Therapy')}`,
    "startDate": start,
    "endDate": end,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "inLanguage": htmlLang[lang],
    "location": {
      "@type": "Place",
      "name": e.title,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": e.location,
        "addressCountry": e.country
      }
    },
    "performer": {
      "@type": ["Person","MusicGroup"],
      "@id": "https://zippydj.com/#person",
      "name": "DJ Zippy",
      "alternateName": "Zippy"
    },
    "organizer": {
      "@type": "Organization",
      "@id": "https://zippydj.com/#organization",
      "name": "DJ Zippy",
      "url": "https://zippydj.com"
    },
    "offers": {
      "@type": "Offer",
      "url": pageUrl,
      "availability": "https://schema.org/InStock",
      "price": "0",
      "priceCurrency": "EUR",
      "validFrom": `${e.date}T00:00:00`
    },
    "url": pageUrl,
    "image": "https://zippydj.com/images/dj-zippy-house-music-dj.webp",
    "description": t.schema.eventDescription(e.title, e.location)
  };
};

const musicEventSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": t.breadcrumb.home, "item": `https://zippydj.com${l('/')}` },
        { "@type": "ListItem", "position": 2, "name": t.breadcrumb.events, "item": pageUrl }
      ]
    },
    ...upcoming.map(toMusicEvent),
    ...past.map(toMusicEvent)
  ]
};
---

<Layout lang={lang} title={t.events.title} description={t.events.description} activePage="events">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(musicEventSchema)} />

  <section id="upcoming" class="isolate relative bg-brand-black pt-24 sm:pt-28 pb-16 overflow-hidden">
    <div class="aurora absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full pointer-events-none"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 z-30 relative">
      <nav aria-label={t.breadcrumb.label} class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-400">
          <li><a href={l('/')} class="hover:text-brand-orange transition-colors">{t.breadcrumb.home}</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-white">{t.breadcrumb.events}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-2">{t.events.heading}</h1>
      <h2 class="font-display text-xl md:text-2xl lg:text-3xl font-bold leading-tight mb-4 text-brand-orange">{t.events.subheading}</h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mb-10">{t.events.lead}</p>
      <div class="flex items-center gap-4 mb-6">
        <div class="w-2 h-8 bg-brand-orange"></div>
        <h3 class="font-display text-2xl md:text-3xl font-bold">{t.events.upcoming1}<span class="text-brand-orange">{t.events.upcoming2}</span></h3>
      </div>
      <div class="space-y-3" data-reveal>
        {upcoming.length === 0 && <p class="text-gray-400">{t.events.noUpcoming}</p>}
        {upcoming.map(e => {
          const { day, month, year } = dateParts(e.date, lang);
          const sound = eventSound(e);
          return (
            <article class={`flex items-center gap-4 sm:gap-6 border-l-4 ${sound.openFormat ? 'border-sky-400' : 'border-brand-orange'} bg-brand-gray rounded-r-lg p-4 hover:bg-white/5 transition-colors`}>
              <div class="flex-shrink-0 text-center min-w-[4rem]">
                <span class={`block font-display font-bold text-xl leading-none ${sound.openFormat ? 'text-sky-300' : 'text-brand-orange'}`}>{day}</span>
                <span class="block text-xs text-gray-400 uppercase tracking-widest">{month}</span>
                <span class="block text-xs text-gray-400">{year}</span>
              </div>
              <div class="w-px h-10 bg-white/10 flex-shrink-0"></div>
              <div class="flex-1 min-w-0">
                <h4 class="font-display font-bold text-white text-base sm:text-lg leading-tight">{e.title}{sound.name && <span class="font-body font-normal text-gray-300 text-sm sm:text-base"> — {sound.name}</span>}</h4>
                <p class="text-gray-400 text-sm"><i class="fa-solid fa-location-dot mr-1 text-brand-orange"></i>{e.location}{e.time ? ` · ${e.time}` : ''}</p>
                <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs sm:text-sm font-semibold text-gray-200">
                  {sound.openFormat
                    ? <span class="open-chip">{t.events.openFormat}</span>
                    : sound.genres.map((g, i) => <span class="whitespace-nowrap">{i > 0 && <span class="text-brand-orange mr-2" aria-hidden="true">·</span>}{g}</span>)}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="past" class="isolate relative py-16 sm:py-20 bg-brand-black border-t border-white/5">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex items-center gap-4 mb-10">
        <div class="w-2 h-8 bg-white/30"></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold">{t.events.past1}<span class="text-gray-400">{t.events.past2}</span></h2>
      </div>
      {/* Highlights (featured) as cards, two per row on wider screens */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal>
        {highlights.map(e => {
          const { day, month, year } = dateParts(e.date, lang);
          return (
            <article class="relative flex flex-col rounded-xl border border-white/10 border-l-4 border-l-brand-orange bg-brand-gray p-5 sm:p-6 hover:border-white/25 hover:border-l-brand-orange transition-colors">
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="font-display font-bold text-brand-orange text-sm tracking-wide">{day} {month} {year}</span>
                <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-brand-orange">
                  <i class="fa-solid fa-star" aria-hidden="true"></i> {t.events.highlightBadge}
                </span>
              </div>
              <h3 class="font-display font-bold text-white text-lg sm:text-xl leading-tight mb-2">{e.title}</h3>
              <p class="text-gray-300 text-sm"><i class="fa-solid fa-location-dot mr-1.5 text-brand-orange" aria-hidden="true"></i>{e.location}{e.subtitle ? ` · ${e.subtitle}` : ''}</p>
            </article>
          );
        })}
      </div>

      {/* Everything else folds into a compact list — native <details>, no JS */}
      {others.length > 0 && (
        <details class="past-more mt-8 rounded-xl border border-white/10 bg-brand-dark">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-sm font-bold uppercase tracking-wide text-white hover:text-brand-orange transition-colors">
            <span>{t.events.showAllPast} <span class="text-gray-400">({others.length})</span></span>
            <i class="fa-solid fa-chevron-right past-more__chevron text-brand-orange transition-transform" aria-hidden="true"></i>
          </summary>
          <ol class="divide-y divide-white/5 border-t border-white/10">
            {others.map(e => {
              const { day, month, year } = dateParts(e.date, lang);
              return (
                <li class="grid grid-cols-[6.75rem_minmax(0,1fr)] sm:grid-cols-[8.75rem_minmax(0,1fr)_minmax(0,1fr)] items-baseline gap-x-4 gap-y-0.5 px-5 py-3">
                  <span class="font-display text-[11px] sm:text-sm font-bold text-gray-300 whitespace-nowrap">{day} {month} {year}</span>
                  <h3 class="font-display text-sm sm:text-base font-bold text-white leading-tight">{e.title}</h3>
                  <p class="col-start-2 sm:col-start-3 text-gray-300 text-xs sm:text-sm"><i class="fa-solid fa-location-dot mr-1.5 text-brand-orange" aria-hidden="true"></i>{e.location}{e.subtitle ? ` · ${e.subtitle}` : ''}</p>
                </li>
              );
            })}
          </ol>
        </details>
      )}
      <div class="mt-12 text-center">
        <a href={l('/')} class="inline-flex items-center gap-2 text-gray-400 hover:text-brand-orange transition-colors">
          <i class="fa-solid fa-arrow-left"></i> {t.events.backHome}
        </a>
      </div>
    </div>
  </section>

  <style>
    .past-more summary::-webkit-details-marker { display: none; }
    .past-more[open] .past-more__chevron { transform: rotate(90deg); }
    .past-more summary:focus-visible { outline: 2px solid #fff; outline-offset: -2px; border-radius: 0.75rem; }
  </style>
</Layout>
