---
// 404. Shared by the prerendered /404 and the on-demand catch-all routes
// (src/pages/[...slug].astro, src/pages/sr/[...slug].astro).
// The deck on the left is the "track not found" moment: when the page opens the
// needle lifts off the record and the platter spins down to a stop.
import Layout from '../../layouts/Layout.astro';
import { useTranslations, localize, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const l = (path: string) => localize(path, lang);

// Record grooves (radii in the SVG's units); the bolder ones are the gaps between tracks.
const grooves = [84, 80, 76, 72, 68, 60, 56, 52, 48, 44, 40];
const trackGaps = [64, 36];
---

<Layout lang={lang} title={t.notFound.title} description={t.notFound.description} noindex={true}>
  <section class="nf isolate relative overflow-hidden bg-brand-black">
    <div class="nf__glow" aria-hidden="true"></div>
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 relative">
      <div class="nf__grid">
        <div class="nf__deck" aria-hidden="true">
          <svg viewBox="0 0 280 210" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <defs>
              <linearGradient id="nf-plate" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#181818" />
                <stop offset="1" stop-color="#0c0c0c" />
              </linearGradient>
              <linearGradient id="nf-sheen" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0.28" stop-color="#fff" stop-opacity="0" />
                <stop offset="0.4" stop-color="#fff" stop-opacity="0.07" />
                <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
                <stop offset="0.62" stop-color="#fff" stop-opacity="0.04" />
                <stop offset="0.74" stop-color="#fff" stop-opacity="0" />
              </linearGradient>
            </defs>

            <!-- deck plate -->
            <rect x="1" y="1" width="278" height="208" rx="22" fill="url(#nf-plate)" stroke="rgba(255,255,255,0.08)" />
            <!-- power light: the other side's colour -->
            <circle class="nf-svg-alt" cx="22" cy="22" r="7" opacity="0.18" />
            <circle class="nf-svg-alt" cx="22" cy="22" r="3" />
            <!-- start / stop and the two speed keys -->
            <rect x="14" y="184" width="28" height="15" rx="4" fill="#1d1d1d" stroke="rgba(255,255,255,0.08)" />
            <rect x="48" y="189" width="13" height="8" rx="2.5" fill="#1d1d1d" />
            <rect x="65" y="189" width="13" height="8" rx="2.5" fill="#1d1d1d" />

            <!-- platter and record: spins down when the page opens -->
            <circle cx="110" cy="105" r="95" fill="#060606" stroke="rgba(255,255,255,0.06)" />
            <g class="nf-record">
              <circle cx="110" cy="105" r="93" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="2" stroke-dasharray="1.2 5.6" />
              <circle cx="110" cy="105" r="88" fill="#0b0b0b" />
              {grooves.map((r) => <circle cx="110" cy="105" r={r} fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.7" />)}
              {trackGaps.map((r) => <circle cx="110" cy="105" r={r} fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.4" />)}
              <circle class="nf-svg-accent" cx="110" cy="105" r="28" />
              <text x="110" y="101" text-anchor="middle" class="nf-svg-label">ZIPPY.</text>
              <text x="110" y="116" text-anchor="middle" class="nf-svg-small">TRACK 404</text>
            </g>
            <circle cx="110" cy="105" r="88" fill="url(#nf-sheen)" />
            <circle cx="110" cy="105" r="3" fill="#d6d6d6" />

            <!-- tonearm: lifts off the record and settles on its rest -->
            <circle cx="236" cy="150" r="6" fill="#222" stroke="rgba(255,255,255,0.08)" />
            <g class="nf-arm">
              <rect x="224" y="6" width="16" height="22" rx="4" fill="#2b2b2b" stroke="rgba(255,255,255,0.1)" />
              <circle cx="232" cy="44" r="17" fill="#1b1b1b" stroke="rgba(255,255,255,0.1)" />
              <circle cx="232" cy="44" r="8" fill="#2a2a2a" />
              <path d="M232 44 L236 150 L227 172" fill="none" stroke="#cfcfcf" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="219" y="168" width="14" height="22" rx="2.5" fill="#bdbdbd" transform="rotate(22 226 179)" />
              <rect class="nf-svg-alt" x="221.5" y="182" width="9" height="7" rx="1.5" transform="rotate(22 226 179)" />
            </g>

            <!-- pitch fader -->
            <rect x="259" y="78" width="6" height="96" rx="3" fill="#050505" stroke="rgba(255,255,255,0.08)" />
            <rect x="252" y="118" width="20" height="11" rx="3" fill="#2b2b2b" stroke="rgba(255,255,255,0.12)" />
            <rect class="nf-svg-accent" x="252" y="123" width="20" height="1.2" />
          </svg>
        </div>

        <div class="nf__copy">
          <p class="mono-caps nf__kicker">{t.notFound.kicker}</p>
          <h1 class="nf__title font-display">404</h1>
          <p class="nf__lead">{t.notFound.lead}</p>
          <p class="nf__path" data-nf-path hidden><span class="sr-only">{t.notFound.pathLabel}: </span><s data-nf-path-text></s></p>
          <div class="nf__actions">
            <a href={l('/')} class="btn btn--primary">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {t.notFound.backHome}
            </a>
            <a href={l('/events')} class="btn btn--secondary">{t.notFound.events}</a>
            <a href={l('/mixes')} class="btn btn--secondary">{t.notFound.mixes}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    display: flex;
    align-items: center;
    min-height: min(100svh, 60rem);
    padding: 6.5rem 0 4.5rem;
  }
  .nf__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(90vw, 56rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.13), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .nf__grid {
    display: grid;
    gap: 2.25rem;
    justify-items: center;
    text-align: center;
  }
  .nf__deck { width: min(76vw, 21rem); }
  .nf__deck svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 28px 50px rgba(0,0,0,0.6)); }
  .nf__copy { max-width: 32rem; }
  .nf__kicker { font-size: 0.75rem; color: rgb(var(--accent-rgb)); }
  .nf__title {
    margin: 0.5rem 0 0;
    font-size: clamp(4.75rem, 20vw, 8.5rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .nf__lead { margin-top: 1.25rem; font-size: 1.0625rem; line-height: 1.6; color: rgb(209 213 219); }
  .nf__path {
    margin-top: 0.9rem;
    max-width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.8125rem;
    color: rgb(156 163 175);
    overflow-wrap: anywhere;
  }
  .nf__path s { text-decoration-color: rgb(var(--alt-rgb)); text-decoration-thickness: 1.5px; }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* the deck sits beside the copy once there is room for both */
  @media (min-width: 768px) {
    .nf__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      justify-items: start;
      align-items: center;
      text-align: left;
    }
    .nf__deck { width: 100%; max-width: 30rem; justify-self: end; }
    .nf__actions { justify-content: flex-start; }
  }
  /* phones on their side: the same two columns, smaller */
  @media (max-height: 500px) and (orientation: landscape) {
    .nf { min-height: 0; padding: 5rem 0 3rem; }
    .nf__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: 2rem;
      justify-items: start;
      align-items: center;
      text-align: left;
    }
    .nf__deck { width: 100%; max-width: 17rem; justify-self: end; }
    .nf__title { font-size: 4.5rem; }
    .nf__lead { margin-top: 0.75rem; font-size: 0.9375rem; }
    .nf__actions { justify-content: flex-start; margin-top: 1.25rem; }
  }

  /* SVG colours that follow the side switch */
  .nf-svg-accent { fill: rgb(var(--accent-rgb)); }
  .nf-svg-alt { fill: rgb(var(--alt-rgb)); }
  .nf-svg-label { font-family: 'Unbounded', sans-serif; font-size: 8.5px; font-weight: 800; fill: #050505; letter-spacing: 0.02em; }
  .nf-svg-small { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 5.4px; font-weight: 700; fill: #050505; letter-spacing: 0.12em; }

  .nf-record {
    transform-box: view-box;
    transform-origin: 110px 105px;
    animation: nf-spin-down 3.8s cubic-bezier(0.12, 0.62, 0.22, 1) both;
  }
  .nf-arm {
    transform-box: view-box;
    transform-origin: 232px 44px;
    animation: nf-lift 1.1s cubic-bezier(0.45, 0, 0.2, 1) 0.25s both;
  }
  @keyframes nf-spin-down {
    from { transform: rotate(-1440deg); }
    to   { transform: rotate(0deg); }
  }
  @keyframes nf-lift {
    from { transform: rotate(28deg); }
    to   { transform: rotate(0deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-record, .nf-arm { animation: none; }
  }
</style>

<script>
  // Shows the address that was asked for, struck through, under the lead.
  function initNotFound() {
    const line = document.querySelector<HTMLElement>('[data-nf-path]');
    const text = line?.querySelector<HTMLElement>('[data-nf-path-text]');
    if (!line || !text || line.dataset.ready) return;
    line.dataset.ready = '1';
    let path = location.pathname;
    // opened as /404 itself: there is no wrong address to show
    if (/^\/(sr\/)?404\/?$/.test(path)) return;
    try { path = decodeURI(path); } catch { /* keep it encoded */ }
    if (path.length > 90) path = `${path.slice(0, 87)}…`;
    text.textContent = path;
    line.hidden = false;
  }
  document.addEventListener('astro:page-load', initNotFound);
</script>
