---
// One line of the past-gigs archive on /events. A highlight (featured) gets a
// larger title and its own surface; everything else is a single quiet line.
// Its styles are in EventsPage.astro, the only page that shows it.
import { eventSide, type UIEvent } from '../lib/content';
import { placeName, venueName, subtitleText } from '../lib/places';
import { useTranslations, dateParts, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  event: UIEvent;
}

const { lang, event: e } = Astro.props as Props;
const t = useTranslations(lang);
const { day, month } = dateParts(e.date, lang);
const side = eventSide(e);
const sideText = side === 'A' ? `${t.sides.a} · ${t.sides.aLabel}` : `${t.sides.b} · ${t.sides.bLabel}`;
const title = venueName(e.title);
const where = [placeName(e.location, lang), subtitleText(e.subtitle, lang)].filter(Boolean).join(' · ');
---

<li class={`past-row ${e.featured ? 'past-row--hi' : ''}`} data-side-item={side} data-side={side}>
  <span class="side-key" aria-hidden="true">{side}</span>
  <time class="past-row__date mono-caps" datetime={e.date}>{day} {month}</time>
  {e.featured ? (
    <div class="past-row__title">
      <h4 class="font-display font-bold text-white text-base sm:text-lg leading-tight">{title}</h4>
      {where && <p class="mt-1 text-sm text-gray-400">{where}</p>}
    </div>
  ) : (
    <h4 class="past-row__title text-sm sm:text-[0.9375rem] leading-snug font-normal text-white">{title}{where && <span class="text-gray-400"> · {where}</span>}</h4>
  )}
  <span class="sr-only">{sideText}</span>
</li>
