---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/fonts.css';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { getLangFromUrl, useTranslations, alternateLinks, htmlLang, ogLocale, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: Lang;
  /** An image that is above the fold on this page (e.g. the About portrait). */
  preloadImage?: string;
  /** og:type; a blog post is an `article`. */
  ogType?: 'website' | 'article' | 'profile';
}

// The URL is authoritative for language; the prop only exists so a page can be
// explicit about it (and so TS catches a page that forgets to pass it through).
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t.home.description,
  activePage = '',
  ogImage = 'https://zippydj.com/images/og-dj-zippy.jpg',
  noindex = false,
  preloadImage,
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// hreflang: every localised page points at all of its siblings plus x-default,
// which is the English URL. A noindex page (404, gallery, blog for now) gets
// neither a canonical nor hreflang: pointing search engines at a page they are
// told not to index, or at the "other language" of a missing URL, only sends
// mixed signals.
const alternates = alternateLinks(Astro.url, Astro.site);
const xDefault = alternates.find((a) => a.lang === 'en')!.href;
---

<!doctype html>
<html lang={htmlLang[lang]} class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="1y96dxupl676x6rktfb8erhhpbmy9o" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <!-- The browser bar takes the page's own black on both sides -->
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- hreflang — English at /, Serbian under /sr -->
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.schema.ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DJ Zippy" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}

    {/* Twitter / X Card. No twitter:site or twitter:creator: there is no
        official X profile (none on the Links page or in the sameAs lists), so
        the card is not attributed to a handle. Add both back if one is made. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.schema.ogImageAlt} />

    <!-- Only pages with a photo above the fold ask for this (About) -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Fonts: self-hosted (src/styles/fonts.css). Only Unbounded is preloaded:
         it sets every heading and the hero title, the usual LCP element. Inter
         (body text) follows as soon as the CSS asks for it; until then a
         metric-matched Arial holds the lines in place (font-display: swap). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/unbounded/unbounded-latin.woff2" crossorigin />

    <!-- Meta Pixel + GTM + Google Ads (deferred, see Analytics.astro) -->
    <Analytics />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Zippy" />
    <link rel="manifest" href="/images/site.webmanifest" />

    <!-- Font Awesome (self-hosted subset — only the icons this site uses) -->
    <link rel="stylesheet" href="/fonts/fa/fa-subset.css" />

    <slot name="head" />

    <ViewTransitions />
    {/* JS is on: scroll-reveal may hide what it is about to show, and the
        header may go see-through at the top. A client-side page change swaps
        <html>'s attributes for the new page's, so the flag is put back.
        A link that names a side (?side=a / ?side=b, docs/tracking/README.md)
        gets that side's colours from the first paint. attribution.ts makes the
        pick official through sides.ts once the page has loaded; without this
        the page would show orange until then and flip to blue. */}
    <script is:inline>
      (function (d) {
        d.documentElement.classList.add('anim-ready');
        try {
          var side = (new URLSearchParams(location.search).get('side') || '').trim().toUpperCase();
          if (side === 'A' || side === 'B') d.documentElement.setAttribute('data-side-pick', side);
        } catch (e) {}
        if (window.__zippyAnimFlag) return;
        window.__zippyAnimFlag = true;
        d.addEventListener('astro:after-swap', function () { d.documentElement.classList.add('anim-ready'); });
      })(document);
    </script>
  </head>
  <body class="overflow-x-hidden">
    <!-- First in the page, so a keyboard reaches the cookie choice before
         anything else; it is fixed to a corner, so it looks the same -->
    <CookieConsent lang={lang} />

    <Header activePage={activePage} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Site animations: scroll-reveal, magnetic buttons -->
    <script>
      import '../scripts/sides';
      import '../scripts/rail';
      import '../scripts/cal-menu';
      import '../scripts/attribution';
      import '../scripts/track';

      function setupAnimations() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll-reveal
        const revealEls = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('in-view'));
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((e) => {
              if (e.isIntersecting) { e.target.classList.add('in-view'); obs.unobserve(e.target); }
            });
          // Reveal as soon as any part is on screen (plus a small lead), rather
          // than waiting for 12% of a possibly very tall block to scroll in.
          }, { threshold: 0, rootMargin: '0px 0px 6% 0px' });
          revealEls.forEach((el) => { if (!el.classList.contains('in-view')) io.observe(el); });
          // Safety net: never leave content hidden if something misfires
          setTimeout(() => revealEls.forEach((el) => el.classList.add('in-view')), 3000);
        }

        if (reduce) return;
        const fine = window.matchMedia('(pointer: fine)').matches;
        if (!fine) return;

        // Magnetic buttons
        document.querySelectorAll('[data-magnetic]').forEach((el) => {
          if (el.dataset.magBound) return;
          el.dataset.magBound = '1';
          el.addEventListener('pointermove', (ev) => {
            const r = el.getBoundingClientRect();
            el.style.transform = 'translate(' + (ev.clientX - r.left - r.width / 2) * 0.4 + 'px,' + (ev.clientY - r.top - r.height / 2) * 0.4 + 'px)';
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      }
      document.addEventListener('astro:page-load', setupAnimations);
    </script>
  </body>
</html>
