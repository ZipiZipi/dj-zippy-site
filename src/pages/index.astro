---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Journey from '../components/Journey.astro';
import Countdown from '../components/Countdown.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { getEvents, getMixes, dateParts, ytThumb } from '../lib/content';

const db = (Astro.locals as any).runtime?.env?.DB;
const { upcoming } = await getEvents(db);
const homeUpcoming = upcoming.slice(0, 4);
const { featured: featuredMixes } = await getMixes(db);

const ticker = ['House Music Therapy', 'Exit Festival', 'Belgrade', 'Deep House', 'Tech House', 'Novi Sad', 'Selector', 'Grooves'];
---

<Layout
  title="Zippy | House Music Therapy | DJ from Serbia"
  description="Official website of Zippy (DJ Zippy). House Music Therapy creator from Belgrade, Serbia. Curator, selector, and vibe architect. Book now."
>
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfilePage",
        "@id": "https://zippydj.com/#profilepage",
        "mainEntity": { "@id": "https://zippydj.com/#person" },
        "dateCreated": "2024-01-01T00:00:00-05:00",
        "dateModified": "2025-07-13T00:00:00-05:00"
      },
      {
        "@type": ["Person","MusicGroup"],
        "@id": "https://zippydj.com/#person",
        "name": "DJ Zippy",
        "givenName": "Veljko",
        "familyName": "Nedeljkovic",
        "alternateName": ["Zippy","Zippy DJ","Zovumezippy","Zipi","Veljko Nedeljković"],
        "url": "https://zippydj.com",
        "image": {
          "@type": "ImageObject",
          "url": "https://zippydj.com/images/dj-zippy-house-music-dj.webp",
          "width": 1200,
          "height": 1200,
          "caption": "DJ Zippy — House Music Therapy"
        },
        "description": "DJ Zippy (Veljko Nedeljković) is a House and Tech-House DJ and selector based in Belgrade, Serbia, known for the 'House Music Therapy' mix series and performances at Exit Festival and major regional clubs.",
        "jobTitle": "DJ & Selector",
        "hasOccupation": { "@type": "Occupation", "name": "Disc Jockey", "occupationalCategory": "27-2099.00" },
        "nationality": { "@type": "Country", "name": "Serbia" },
        "birthPlace": { "@type": "City", "name": "Belgrade" },
        "homeLocation": { "@type": "City", "name": "Belgrade" },
        "address": { "@type": "PostalAddress", "addressLocality": "Belgrade", "addressCountry": "RS" },
        "genre": ["House","Tech House","Deep House","Techno","Organic House"],
        "knowsLanguage": ["sr","en"],
        "memberOf": [
          { "@type": "Organization", "name": "Kult Talents" },
          { "@type": "Organization", "name": "Izuvanje" }
        ],
        "sameAs": [
          "https://musicbrainz.org/artist/a6a53c2e-8fa0-4612-8e43-8de7af43dc2a",
          "https://www.wikidata.org/wiki/Q138220521",
          "https://www.instagram.com/zovumezippy",
          "https://www.youtube.com/@zovumezippy",
          "https://ra.co/dj/zippy-2",
          "https://soundcloud.com/zovumezippy",
          "https://www.mixcloud.com/zovumezippy/",
          "https://www.tiktok.com/@zovumezippy",
          "https://www.facebook.com/zovumezippy",
          "https://open.spotify.com/user/31aj2g4yokqhpoxwkpo5odxegsle",
          "https://www.deezer.com/en/profile/2582254702"
        ],
        "knowsAbout": ["House Music","Tech House","Deep House","Techno","DJing","Music Selection"]
      },
      {
        "@type": "Organization",
        "@id": "https://zippydj.com/#organization",
        "name": "DJ Zippy",
        "alternateName": "House Music Therapy",
        "url": "https://zippydj.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://zippydj.com/images/dj-zippy-house-music-dj.webp",
          "width": 1200,
          "height": 1200
        },
        "image": "https://zippydj.com/images/dj-zippy-house-music-dj.webp",
        "founder": { "@id": "https://zippydj.com/#person" },
        "description": "House Music Therapy - DJ brand curating frequencies, grooves, and the journey through house music.",
        "address": { "@type": "PostalAddress", "addressLocality": "Belgrade", "addressCountry": "RS" },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "veljkoned@gmail.com",
          "contactType": "booking",
          "areaServed": ["RS","EU"],
          "availableLanguage": ["en","sr"]
        },
        "sameAs": [
          "https://www.instagram.com/zovumezippy",
          "https://www.youtube.com/@zovumezippy",
          "https://ra.co/dj/zippy-2"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://zippydj.com/#website",
        "name": "DJ Zippy",
        "url": "https://zippydj.com",
        "publisher": { "@id": "https://zippydj.com/#organization" }
      }
    ]
  }
  </script>

  <style is:global>
    /* Vinyl rail — The Collection carousel (scroll-snap, nothing overlaps) */
    .vinyl-rail-wrap { position: relative; }
    .vinyl-rail {
      display: flex; gap: clamp(1.2rem, 3vw, 2.6rem);
      overflow-x: auto; scroll-snap-type: x mandatory;
      padding: 1.6rem max(8vw, calc(50vw - 560px)) 2.2rem;
      scrollbar-width: none;
    }
    .vinyl-rail::-webkit-scrollbar { display: none; }
    .vinyl-card {
      flex: 0 0 auto; width: clamp(150px, 19vw, 205px);
      scroll-snap-align: center; text-align: center;
      background: none; border: 0; cursor: pointer; padding: 0;
    }
    .vc-disc {
      position: relative; display: block; width: 100%; aspect-ratio: 1;
      border-radius: 50%;
      background:
        radial-gradient(circle at center, transparent 17%, #0c0c0c 18%),
        repeating-radial-gradient(circle at center, rgba(32,32,32,1) 0px, rgba(18,18,18,1) 1.5px, rgba(26,26,26,1) 3px),
        linear-gradient(135deg, #121212 0%, #090909 55%, #121212 100%);
      box-shadow: 0 10px 30px rgba(0,0,0,0.65), 0 0 0 2px rgba(255,255,255,0.07), inset 0 0 44px rgba(0,0,0,0.8);
      transition: transform 0.45s cubic-bezier(0.22,1,0.36,1), box-shadow 0.45s;
    }
    .vinyl-card:hover .vc-disc, .vinyl-card:focus-visible .vc-disc {
      transform: translateY(-10px) rotate(10deg) scale(1.04);
      box-shadow: 0 18px 44px rgba(0,0,0,0.7), 0 0 0 2px rgba(255,120,50,0.5), 0 0 30px rgba(255,85,0,0.35), inset 0 0 44px rgba(0,0,0,0.8);
    }
    .vc-label {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 38%; height: 38%; border-radius: 50%;
      background-size: cover; background-position: center;
      box-shadow: 0 0 0 3px rgba(0,0,0,0.55);
    }
    .vc-hole { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 6%; height: 6%; border-radius: 50%; background: #000; box-shadow: inset 0 0 3px rgba(255,255,255,0.3); }
    .vc-play {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 1.6rem; opacity: 0; transition: opacity 0.3s; text-shadow: 0 4px 14px rgba(0,0,0,0.8);
    }
    .vinyl-card:hover .vc-play { opacity: 1; }
    .vc-title { display: block; margin-top: 0.9rem; font-weight: 600; font-size: 0.8rem; color: rgba(255,255,255,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.8); }
    .vc-meta { display: block; margin-top: 0.15rem; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,150,80,0.75); }
    .rail-btn {
      position: absolute; top: 38%; transform: translateY(-50%); z-index: 5;
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(5,3,2,0.55); border: 1px solid rgba(255,255,255,0.14);
      color: rgba(255,255,255,0.75); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      transition: color 0.3s, border-color 0.3s;
    }
    .rail-btn:hover { color: #FF5500; border-color: rgba(255,85,0,0.6); }
    .rail-btn.prev { left: max(1rem, 2vw); }
    .rail-btn.next { right: max(1rem, 2vw); }
    @media (max-width: 640px) { .rail-btn { display: none; } }

    /* Event trail — a lantern path through the forest instead of a table */
    .ev-trail { position: relative; max-width: 46rem; margin: 0 auto; padding: 0.5rem 0; }
    .ev-trail::before {
      content: ''; position: absolute; top: 0; bottom: 0; left: 1.05rem; width: 2px;
      background: linear-gradient(180deg, transparent, rgba(255,120,45,0.55) 12%, rgba(255,120,45,0.55) 88%, transparent);
      box-shadow: 0 0 10px rgba(255,85,0,0.45);
    }
    .ev-node { position: relative; padding: 0 0 1.4rem 3.2rem; }
    .ev-dot {
      position: absolute; left: 1.05rem; top: 1.35rem; width: 14px; height: 14px; margin-left: -6px;
      border-radius: 50%;
      background: radial-gradient(circle, #ffc79b 0%, #ff7a1f 55%, rgba(255,85,0,0) 78%);
      box-shadow: 0 0 14px rgba(255,110,30,0.85);
      animation: j-firefly 1.935s ease-in-out infinite;
    }
    .ev-card {
      background: rgba(6,3,2,0.55);
      border: 1px solid rgba(255,255,255,0.09);
      border-left: 3px solid rgba(255,85,0,0.65);
      border-radius: 0.9rem;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      padding: 1rem 1.2rem;
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.2rem;
      transition: border-color 0.35s, transform 0.35s;
    }
    .ev-node:hover .ev-card { border-color: rgba(255,120,50,0.55); transform: translateX(4px); }
    .ev-date { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.14em; color: #ff9250; }
    .ev-title { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 1rem; color: #fff; width: 100%; }
    .ev-loc { font-size: 0.8rem; color: rgba(230,220,210,0.7); flex: 1; min-width: 10rem; }
    @media (min-width: 768px) {
      .ev-trail::before { left: 50%; }
      .ev-node { width: 50%; padding: 0 3rem 2rem 0; }
      .ev-node[data-side="r"] { margin-left: 50%; padding: 0 0 2rem 3rem; }
      .ev-node .ev-dot { left: auto; right: -7px; margin-left: 0; }
      .ev-node[data-side="r"] .ev-dot { right: auto; left: -7px; }
      .ev-node[data-side="l"] .ev-card { justify-content: flex-end; text-align: right; }
    }

    /* Booking form on the beach */
    .bk-input {
      width: 100%;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 0.65rem;
      padding: 0.8rem 1rem;
      font-size: 0.875rem; color: #fff;
    }
    .bk-input::placeholder { color: rgba(200,190,182,0.55); }
    .bk-input:focus { outline: none; border-color: rgba(255,85,0,0.75); box-shadow: 0 0 0 3px rgba(255,85,0,0.12); }
  </style>

  <!-- "One Record, Every Horizon" — the fixed world every section scrolls through -->
  <Journey />

  <!-- Chapter 0 — the brand, high above the clouds -->
  <section id="ch-brand" class="j-chapter min-h-[100svh] flex items-end justify-center pb-[12svh]" data-scene="sky">
    <div class="j-brand-block text-center px-6">
      <p class="j-brand-kicker">ONE RECORD. EVERY HORIZON.</p>
      <h1 class="j-brand-h glitch-text glitch-auto">ZIPPY<span class="text-brand-orange">.</span></h1>
      <p class="j-brand-sub">HOUSE MUSIC THERAPY</p>
      <div class="eq-bars mt-4" aria-hidden="true">
        {Array.from({ length: 24 }).map(() => <span></span>)}
      </div>
    </div>
    <div class="j-hint absolute bottom-[4%] left-1/2 -translate-x-1/2" aria-hidden="true">SCROLL</div>
  </section>

  <!-- Chapter 1 — THE SUMMIT: the collection laid out at altitude -->
  <section id="ch-collection" class="j-chapter min-h-[100svh] py-24 flex flex-col justify-center overflow-hidden" data-scene="peak">
      <div id="highlights" class="relative pb-4">
        <div class="j-chapter-head px-6" data-anim="up">
          <span class="j-kicker">CHAPTER 01 — THE SUMMIT · FESTIVAL ALTITUDE</span>
          <h2 class="j-title">THE COLLECTION</h2>
          <p class="j-sub">Records that headline the peak. Swipe through — press play.</p>
        </div>
        <div class="vinyl-rail-wrap">
          <button class="rail-btn prev" aria-label="Scroll collection left"><i class="fa-solid fa-chevron-left"></i></button>
          <div class="vinyl-rail" id="vinyl-rail">
            {featuredMixes.map(m => (
              <button type="button" class="vinyl-card" data-link={m.link} data-platform={m.platform} data-title={m.title}>
                <span class="vc-disc">
                  <span class="vc-label" style={`background-image:url('${m.thumbnail ? ytThumb(m.thumbnail, 'mqdefault') : '/images/art/vinyl-label.webp'}')`}></span>
                  <span class="vc-hole"></span>
                  <span class="vc-play"><i class="fa-solid fa-play"></i></span>
                </span>
                <span class="vc-title">{m.title}</span>
                <span class="vc-meta">{m.platform}</span>
              </button>
            ))}
          </div>
          <button class="rail-btn next" aria-label="Scroll collection right"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <div class="mt-6 text-center" data-anim="up">
          <a href="/mixes" class="inline-flex items-center gap-2 text-gray-300 hover:text-brand-orange transition-colors" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
            <i class="fa-solid fa-headphones"></i> Full collection
          </a>
        </div>
      </div>
  </section>

  <!-- Chapter 2 — THE FOREST at the mountain's foot: upcoming sessions on a lantern trail -->
  <section id="ch-events" class="j-chapter min-h-[100svh] py-24 flex flex-col justify-center" data-scene="wood">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
      <div class="j-chapter-head" data-anim="up">
        <span class="j-kicker">CHAPTER 02 — THE FOREST FLOOR · CLUB NIGHTS</span>
        <h2 class="j-title">UPCOMING THERAPY</h2>
        <p class="j-sub">Follow the lanterns — hypnosis at 124 BPM. Catch the next session.</p>
      </div>
      <div class="mb-10" data-anim="zoom">
        <Countdown event={upcoming[0] ?? null} />
      </div>
      <div class="ev-trail">
        {homeUpcoming.length === 0 && <p class="text-gray-400 text-center" data-anim="up" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">No upcoming events scheduled — book your own therapy below.</p>}
        {homeUpcoming.map((e, i) => {
          const { day, month, year } = dateParts(e.date);
          return (
            <article class="ev-node" data-side={i % 2 ? 'r' : 'l'}>
              <span class="ev-dot" aria-hidden="true"></span>
              <div class="ev-card">
                <span class="ev-date">{day} {month} {year}{e.time ? ` · ${e.time}` : ''}</span>
                <h3 class="ev-title">{e.title}</h3>
                <p class="ev-loc">{e.location}{e.subtitle ? ` — ${e.subtitle}` : ''}</p>
                {e.link
                  ? <a href={e.link} target="_blank" rel="noopener noreferrer" data-track="tickets"
                      class="flex-shrink-0 bg-brand-orange hover:bg-white hover:text-brand-black text-white text-[11px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full transition-colors">
                      Get Tickets
                    </a>
                  : <a href="#contact" data-track="booking"
                      class="flex-shrink-0 border border-white/25 text-gray-200 hover:border-brand-orange hover:text-brand-orange text-[11px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full transition-colors">
                      Book a Date
                    </a>}
              </div>
            </article>
          );
        })}
      </div>
      <div class="mt-8 text-center" data-anim="up">
        <a href="/events" class="inline-flex items-center gap-2 text-gray-300 hover:text-brand-orange transition-colors" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
          <i class="fa-solid fa-calendar"></i> View All Events & Past Highlights
        </a>
      </div>
    </div>
  </section>

  <!-- Chapter 3 — THE SHORE: guest list before the party -->
  <section id="ch-lead" class="j-chapter min-h-[95svh] py-24 flex items-center" data-scene="beach">
    <div class="container mx-auto px-6">
      <div class="max-w-xl mx-auto j-glass px-6 sm:px-10 py-10" data-anim="zoom">
        <div class="j-chapter-head mb-6">
          <span class="j-kicker">CHAPTER 03 — THE SHORE · GUEST LIST</span>
          <h2 class="j-title">THE GUEST LIST</h2>
          <p class="j-sub">The party starts at sundown. Unreleased mixes + first invites, straight to your inbox.</p>
        </div>
        <LeadMagnet variant="story" />
      </div>
    </div>
  </section>

  <!-- Chapter 4 — SUNSET PARTY: the sun-record touches the sea, book the next one -->
  <section id="contact" class="j-chapter min-h-[100svh] py-28 flex items-center" data-scene="beach">
    <div class="container mx-auto px-6">
      <div class="j-chapter-head" data-anim="up">
        <span class="j-kicker">CHAPTER 04 — SUNSET PARTY · THE SET NEVER ENDS</span>
        <h2 class="j-title">BOOK THE THERAPY</h2>
        <p class="j-sub">Wherever your floor is — beach, club or festival. Tell me about the night.</p>
      </div>
      <form id="contact-form" name="contact" method="POST" class="j-glass max-w-xl mx-auto px-6 sm:px-10 py-9 space-y-5" data-anim="zoom">
        <input type="hidden" name="access_key" value="53a011ae-cafe-4a90-b080-b4e4d5891262" />
        <input type="hidden" name="subject" value="DJ Zippy — Booking Request" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <input type="text" name="name" placeholder="Name" required class="bk-input" />
          <input type="text" name="venue" placeholder="Venue / Event" required class="bk-input" />
        </div>
        <input type="email" name="email" placeholder="Email Address" required class="bk-input" />
        <textarea name="message" rows="3" placeholder="Tell me about the gig..." required class="bk-input resize-none"></textarea>
        <div class="text-center pt-1">
          <button type="submit" data-track="booking"
            class="bg-brand-orange hover:bg-white hover:text-brand-black text-white text-sm font-bold uppercase tracking-widest px-9 py-4 rounded-full transition-colors">
            Book DJ Zippy
          </button>
        </div>
      </form>
      <p class="text-center text-xs text-gray-300 mt-5" data-anim="up" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
        Direct: <a href="mailto:veljkoned@gmail.com?subject=DJ%20Zippy%20%E2%80%94%20Booking%20Request" class="text-brand-orange hover:text-white transition-colors">veljkoned@gmail.com</a>
        <span class="mx-2 text-gray-500">·</span>
        <a href="https://ra.co/dj/zippy-2" target="_blank" rel="noopener noreferrer" class="text-brand-orange hover:text-white transition-colors">Resident Advisor</a>
      </p>
    </div>
  </section>

  <div class="marquee relative z-10 bg-brand-black border-y border-white/5 py-4 sm:py-5" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => ticker.map((w) => (
        <span class="inline-flex items-center gap-10">
          <span class="font-display text-lg sm:text-2xl font-black uppercase tracking-widest text-white/15">{w}</span>
          <span class="text-brand-orange text-base">&#9679;</span>
        </span>
      )))}
    </div>
  </div>

  <LeadMagnet variant="popup" />

  <script is:inline>
  // Vinyl rail: arrows + play-in-dock
  function initRail() {
    var rail = document.getElementById('vinyl-rail');
    if (!rail || rail.dataset.bound) return;
    rail.dataset.bound = '1';
    var wrap = rail.parentElement;
    function step() { return Math.min(rail.clientWidth * 0.7, 640); }
    var prev = wrap.querySelector('.rail-btn.prev');
    var next = wrap.querySelector('.rail-btn.next');
    if (prev) prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { rail.scrollBy({ left: step(), behavior: 'smooth' }); });
    rail.querySelectorAll('.vinyl-card').forEach(function (card) {
      card.addEventListener('click', function () {
        var link = card.getAttribute('data-link');
        if (!link) return;
        var played = window.ZippyDock && window.ZippyDock.play({
          platform: card.getAttribute('data-platform'),
          link: link,
          title: card.getAttribute('data-title'),
        });
        if (!played) window.open(link, '_blank', 'noopener,noreferrer');
      });
    });
  }
  document.addEventListener('astro:page-load', initRail);

  // Booking form (moved from the footer to the sunset-party finale)
  function initBookingForm() {
    var form = document.getElementById('contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var orig = btn.innerText;
      btn.disabled = true;
      btn.innerText = 'Sending...';
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
        .then(function (res) {
          btn.innerText = res.ok ? 'Sent — see you at the party ✓' : 'Error — try veljkoned@gmail.com';
          if (res.ok) {
            form.reset();
            try {
              if (window.fbq) fbq('track', 'Lead');
              if (window.gtag) gtag('event', 'generate_lead', { source: 'booking_form' });
            } catch (_) {}
          }
        })
        .catch(function () { btn.innerText = 'Error — try veljkoned@gmail.com'; })
        .finally(function () {
          setTimeout(function () { btn.disabled = false; btn.innerText = orig; }, 4500);
        });
    });
  }
  document.addEventListener('astro:page-load', initBookingForm);
  </script>

</Layout>
