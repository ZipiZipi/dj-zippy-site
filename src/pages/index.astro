        "url": "https://zippydj.com",
        "publisher": { "@id": "https://zippydj.com/#organization" }
      }
    ]
  }
  </script>

  <style is:global>
    /* The Collection — vertical record stack (scroll-driven, the big one is the highlight) */
    .vstage { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; justify-content: center; }
    .vstack { position: relative; height: 54svh; }
    .vs-disc {
      position: absolute; left: 50%; top: 50%;
      width: clamp(104px, 12vw, 150px); aspect-ratio: 1;
      background: none; border: 0; padding: 0; cursor: pointer;
      will-change: transform, opacity;
      transform: translate(-50%, -50%);
    }
    .vs-core {
      position: relative; display: block; width: 100%; height: 100%; border-radius: 50%;
      background:
        radial-gradient(circle at center, transparent 17%, #0c0c0c 18%),
        repeating-radial-gradient(circle at center, rgba(32,32,32,1) 0px, rgba(18,18,18,1) 1.5px, rgba(26,26,26,1) 3px),
        linear-gradient(135deg, #121212 0%, #090909 55%, #121212 100%);
      box-shadow: 0 8px 26px rgba(0,0,0,0.6), 0 0 0 1.5px rgba(255,255,255,0.06), inset 0 0 34px rgba(0,0,0,0.8);
      transition: box-shadow 0.4s;
    }
    .vs-disc.active .vs-core {
      animation: vinyl-spin 12s linear infinite;
      box-shadow: 0 10px 30px rgba(0,0,0,0.65), 0 0 0 2px rgba(255,120,50,0.55), 0 0 26px rgba(255,85,0,0.35), inset 0 0 34px rgba(0,0,0,0.8);
    }
    .vs-label {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 38%; height: 38%; border-radius: 50%;
      background-size: cover; background-position: center;
      box-shadow: 0 0 0 2px rgba(0,0,0,0.55);
    }
    .vs-hole { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 6%; height: 6%; border-radius: 50%; background: #000; box-shadow: inset 0 0 3px rgba(255,255,255,0.3); }
    .vs-meta {
      position: absolute; left: 50%; top: calc(50% + clamp(64px, 7.5vw, 88px) + 18px);
      transform: translateX(-50%);
      width: min(82vw, 400px); text-align: center; pointer-events: none;
    }
    .vs-title { display: block; font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.76rem; color: rgba(255,255,255,0.92); text-shadow: 0 1px 10px rgba(0,0,0,0.85); }
    .vs-sub { display: block; margin-top: 3px; font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255,150,80,0.8); }
    .vs-hint { display: block; margin-top: 7px; font-size: 0.55rem; letter-spacing: 0.32em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
    html.reduce-motion .vstage { position: static; height: auto; padding: 4rem 0; }
    html.reduce-motion .vstack { height: auto; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; padding: 1rem 0; }
    html.reduce-motion .vs-disc { position: static; transform: none !important; width: 92px; }
    html.reduce-motion .vs-meta { display: none; }
    html.reduce-motion #ch-collection { min-height: 0; }

    /* Event trail — a lantern path through the forest instead of a table */
    .ev-trail { position: relative; max-width: 36rem; margin: 0 auto; padding: 0.5rem 0; }
    .ev-trail::before {
      content: ''; position: absolute; top: 0; bottom: 0; left: 1.05rem; width: 2px;
      background: linear-gradient(180deg, transparent, rgba(255,120,45,0.55) 12%, rgba(255,120,45,0.55) 88%, transparent);
      box-shadow: 0 0 10px rgba(255,85,0,0.45);
    }
    .ev-node { position: relative; padding: 0 0 1rem 2.5rem; }
    .ev-dot {
      position: absolute; left: 1.05rem; top: 1rem; width: 11px; height: 11px; margin-left: -4.5px;
      border-radius: 50%;
      background: radial-gradient(circle, #ffc79b 0%, #ff7a1f 55%, rgba(255,85,0,0) 78%);
      box-shadow: 0 0 14px rgba(255,110,30,0.85);
      animation: j-firefly 1.935s ease-in-out infinite;
    }
    .ev-card {
      background: rgba(6,3,2,0.55);
      border: 1px solid rgba(255,255,255,0.09);
      border-left: 3px solid rgba(255,85,0,0.65);
      border-radius: 0.7rem;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      padding: 0.65rem 0.9rem;
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.85rem;
      transition: border-color 0.35s, transform 0.35s;
    }
    .ev-node:hover .ev-card { border-color: rgba(255,120,50,0.55); transform: translateX(4px); }
    .ev-date { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.6rem; letter-spacing: 0.14em; color: #ff9250; }
    .ev-title { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.8rem; color: #fff; width: 100%; }
    .ev-loc { font-size: 0.7rem; color: rgba(230,220,210,0.7); flex: 1; min-width: 8rem; }
    @media (min-width: 768px) {
      .ev-trail::before { left: 50%; }
      .ev-node { width: 50%; padding: 0 2.3rem 1.4rem 0; }
      .ev-node[data-side="r"] { margin-left: 50%; padding: 0 0 1.4rem 2.3rem; }
      .ev-node .ev-dot { left: auto; right: -7px; margin-left: 0; }
      .ev-node[data-side="r"] .ev-dot { right: auto; left: -7px; }
      .ev-node[data-side="l"] .ev-card { justify-content: flex-end; text-align: right; }
    }

    /* Booking form on the beach */
    .bk-input {
      width: 100%;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 0.65rem;
      padding: 0.8rem 1rem;
      font-size: 0.875rem; color: #fff;
    }
    .bk-input::placeholder { color: rgba(200,190,182,0.55); }
    .bk-input:focus { outline: none; border-color: rgba(255,85,0,0.75); box-shadow: 0 0 0 3px rgba(255,85,0,0.12); }
  </style>

  <!-- "One Record, Every Horizon" — the fixed world every section scrolls through -->
  <Journey />

  <!-- Chapter 0 — the brand, right under the record-moon -->
  <section id="ch-brand" class="j-chapter min-h-[100svh] flex items-start justify-center pt-[37svh]" data-scene="sky">
    <div class="j-brand-block text-center px-6">
      <p class="j-brand-kicker">ONE RECORD. EVERY HORIZON.</p>
      <h1 class="j-brand-h glitch-text glitch-auto">ZIPPY<span class="text-brand-orange">.</span></h1>
      <p class="j-brand-sub">HOUSE MUSIC THERAPY</p>
      <div class="eq-bars mt-4" aria-hidden="true">
        {Array.from({ length: 24 }).map(() => <span></span>)}
      </div>
    </div>
    <div class="j-hint absolute bottom-[4%] left-1/2 -translate-x-1/2" aria-hidden="true">SCROLL</div>
  </section>

  <!-- Chapter 1 — THE SUMMIT: scroll down the ridge, the records turn over -->
  <section id="ch-collection" class="j-chapter min-h-[240svh]" data-scene="peak">
    <div class="vstage" id="highlights">
      <div class="j-chapter-head px-6 mb-2" data-anim="up">
        <span class="j-kicker">CHAPTER 01 — THE SUMMIT · FESTIVAL ALTITUDE</span>
        <h2 class="j-title">THE COLLECTION</h2>
        <p class="j-sub">Ride down the ridge — the records turn with you.</p>
      </div>
      <div class="vstack" id="vstack">
        {featuredMixes.map(m => (
          <button type="button" class="vs-disc" data-link={m.link} data-platform={m.platform} data-title={m.title} aria-label={`Play ${m.title}`}>
            <span class="vs-core">
              <span class="vs-label" style={`background-image:url('${m.thumbnail ? ytThumb(m.thumbnail, 'mqdefault') : '/images/art/vinyl-label.webp'}')`}></span>
              <span class="vs-hole"></span>
            </span>
          </button>
        ))}
        <div class="vs-meta" id="vs-meta">
          <span class="vs-title" id="vs-title"></span>
          <span class="vs-sub" id="vs-sub"></span>
          <span class="vs-hint"><i class="fa-solid fa-play"></i> play</span>
        </div>
      </div>
      <div class="text-center mt-3" data-anim="up">
        <a href="/mixes" class="inline-flex items-center gap-2 text-xs text-gray-400 hover:text-brand-orange transition-colors uppercase tracking-widest" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
          <i class="fa-solid fa-headphones"></i> Full collection
        </a>
      </div>
    </div>
  </section>

  <!-- Chapter 2 — THE FOREST at the mountain's foot: upcoming sessions on a lantern trail -->
  <section id="ch-events" class="j-chapter min-h-[100svh] py-24 flex flex-col justify-center" data-scene="wood">
    <div class="container mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
      <div class="j-chapter-head" data-anim="up">
        <span class="j-kicker">CHAPTER 02 — THE FOREST FLOOR · CLUB NIGHTS</span>
        <h2 class="j-title">UPCOMING THERAPY</h2>
        <p class="j-sub">Follow the lanterns — hypnosis at 124 BPM. Catch the next session.</p>
      </div>
      <div class="mb-10" data-anim="zoom">
        <Countdown event={upcoming[0] ?? null} />
      </div>
      <div class="ev-trail">
        {homeUpcoming.length === 0 && <p class="text-gray-400 text-center" data-anim="up" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">No upcoming events scheduled — book your own therapy below.</p>}
        {homeUpcoming.map((e, i) => {
          const { day, month, year } = dateParts(e.date);
          return (
            <article class="ev-node" data-side={i % 2 ? 'r' : 'l'}>
              <span class="ev-dot" aria-hidden="true"></span>
              <div class="ev-card">
                <span class="ev-date">{day} {month} {year}{e.time ? ` · ${e.time}` : ''}</span>
                <h3 class="ev-title">{e.title}</h3>
                <p class="ev-loc">{e.location}{e.subtitle ? ` — ${e.subtitle}` : ''}</p>
                {e.link
                  ? <a href={e.link} target="_blank" rel="noopener noreferrer" data-track="tickets"
                      class="flex-shrink-0 bg-brand-orange hover:bg-white hover:text-brand-black text-white text-[11px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full transition-colors">
                      Get Tickets
                    </a>
                  : <a href="#contact" data-track="booking"
                      class="flex-shrink-0 border border-white/25 text-gray-200 hover:border-brand-orange hover:text-brand-orange text-[11px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full transition-colors">
                      Book a Date
                    </a>}
              </div>
            </article>
          );
        })}
      </div>
      <div class="mt-8 text-center" data-anim="up">
        <a href="/events" class="inline-flex items-center gap-2 text-gray-300 hover:text-brand-orange transition-colors" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
          <i class="fa-solid fa-calendar"></i> View All Events & Past Highlights
        </a>
      </div>
    </div>
  </section>

  <!-- Chapter 3 — THE SHORE: guest list before the party -->
  <section id="ch-lead" class="j-chapter min-h-[95svh] py-24 flex items-center" data-scene="beach">
    <div class="container mx-auto px-6">
      <div class="max-w-xl mx-auto j-glass px-6 sm:px-10 py-10" data-anim="zoom">
        <div class="j-chapter-head mb-6">
          <span class="j-kicker">CHAPTER 03 — THE SHORE · GUEST LIST</span>
          <h2 class="j-title">THE GUEST LIST</h2>
          <p class="j-sub">The party starts at sundown. Unreleased mixes + first invites, straight to your inbox.</p>
        </div>
        <LeadMagnet variant="story" />
      </div>
    </div>
  </section>

  <!-- Chapter 4 — SUNSET PARTY: the sun-record touches the sea, book the next one -->
  <section id="contact" class="j-chapter min-h-[100svh] py-28 flex items-center" data-scene="beach">
    <div class="container mx-auto px-6">
      <div class="j-chapter-head" data-anim="up">
        <span class="j-kicker">CHAPTER 04 — SUNSET PARTY · THE SET NEVER ENDS</span>
        <h2 class="j-title">BOOK THE THERAPY</h2>
        <p class="j-sub">Wherever your floor is — beach, club or festival. Tell me about the night.</p>
      </div>
      <form id="contact-form" name="contact" method="POST" class="j-glass max-w-xl mx-auto px-6 sm:px-10 py-9 space-y-5" data-anim="zoom">
        <input type="hidden" name="access_key" value="53a011ae-cafe-4a90-b080-b4e4d5891262" />
        <input type="hidden" name="subject" value="DJ Zippy — Booking Request" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <input type="text" name="name" placeholder="Name" required class="bk-input" />
          <input type="text" name="venue" placeholder="Venue / Event" required class="bk-input" />
        </div>
        <input type="email" name="email" placeholder="Email Address" required class="bk-input" />
        <textarea name="message" rows="3" placeholder="Tell me about the gig..." required class="bk-input resize-none"></textarea>
        <div class="text-center pt-1">
          <button type="submit" data-track="booking"
            class="bg-brand-orange hover:bg-white hover:text-brand-black text-white text-sm font-bold uppercase tracking-widest px-9 py-4 rounded-full transition-colors">
            Book DJ Zippy
          </button>
        </div>
      </form>
      <p class="text-center text-xs text-gray-300 mt-5" data-anim="up" style="text-shadow:0 1px 8px rgba(0,0,0,0.8);">
        Direct: <a href="mailto:veljkoned@gmail.com?subject=DJ%20Zippy%20%E2%80%94%20Booking%20Request" class="text-brand-orange hover:text-white transition-colors">veljkoned@gmail.com</a>
        <span class="mx-2 text-gray-500">·</span>
        <a href="https://ra.co/dj/zippy-2" target="_blank" rel="noopener noreferrer" class="text-brand-orange hover:text-white transition-colors">Resident Advisor</a>
      </p>
    </div>
  </section>

  <LeadMagnet variant="popup" />

  <script is:inline>
  // Booking form (moved from the footer to the sunset-party finale)
  function initBookingForm() {
    var form = document.getElementById('contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var orig = btn.innerText;
      btn.disabled = true;
      btn.innerText = 'Sending...';
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
        .then(function (res) {
          btn.innerText = res.ok ? 'Sent — see you at the party ✓' : 'Error — try veljkoned@gmail.com';
          if (res.ok) {
            form.reset();
            try {
              if (window.fbq) fbq('track', 'Lead');
              if (window.gtag) gtag('event', 'generate_lead', { source: 'booking_form' });
            } catch (_) {}
          }
        })
        .catch(function () { btn.innerText = 'Error — try veljkoned@gmail.com'; })
        .finally(function () {
          setTimeout(function () { btn.disabled = false; btn.innerText = orig; }, 4500);
        });
    });
  }
  document.addEventListener('astro:page-load', initBookingForm);
  </script>

  <!-- The Collection: scroll-driven vertical record stack (small discs, the
       big one is the highlight; riding down the ridge turns the records) -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    function initStack() {
      const stack = document.getElementById('vstack');
      if (!stack || stack.dataset.bound) return;
      stack.dataset.bound = '1';
      const discs = Array.from(stack.querySelectorAll<HTMLElement>('.vs-disc'));
      const n = discs.length;
      if (!n) return;
      const titleEl = document.getElementById('vs-title');
      const subEl = document.getElementById('vs-sub');

      const play = (el: HTMLElement) => {
        const link = el.dataset.link;
        if (!link) return;
        const played = (window as any).ZippyDock && (window as any).ZippyDock.play({
          platform: el.dataset.platform, link, title: el.dataset.title,
        });
        if (!played) window.open(link, '_blank', 'noopener,noreferrer');
      };

      if ((window as any).__motionOff()) {
        discs.forEach((el) => el.addEventListener('click', () => play(el)));
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      let activeIdx = -1;

      function render(a: number) {
        const step = Math.min(window.innerHeight * 0.16, 132);
        discs.forEach((el, i) => {
          const d = i - a;
          const ad = Math.abs(d);
          const s = Math.max(0.28, 1 - 0.36 * ad);
          el.style.transform = `translate(-50%, -50%) translateY(${d * step}px) scale(${s})`;
          el.style.opacity = String(Math.max(0, 1 - 0.42 * ad));
          el.style.zIndex = String(100 - Math.round(ad * 10));
          el.style.pointerEvents = ad > 2.2 ? 'none' : 'auto';
        });
        const idx = Math.max(0, Math.min(n - 1, Math.round(a)));
        if (idx !== activeIdx) {
          activeIdx = idx;
          discs.forEach((el, i) => el.classList.toggle('active', i === idx));
          if (titleEl) titleEl.textContent = discs[idx].dataset.title || '';
          if (subEl) subEl.textContent = discs[idx].dataset.platform || '';
          gsap.fromTo('#vs-meta', { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' });
        }
      }

      ScrollTrigger.create({
        trigger: '#ch-collection',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.4,
        onUpdate(self) { render(self.progress * (n - 1)); },
      });
      render(0);

      discs.forEach((el, i) => el.addEventListener('click', () => {
        if (i === activeIdx) { play(el); return; }
        const sec = document.getElementById('ch-collection');
        if (!sec) return;
        const len = sec.offsetHeight - window.innerHeight;
        const target = sec.offsetTop + (i / (n - 1)) * len;
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(target); else window.scrollTo({ top: target, behavior: 'smooth' });
      }));
    }
    document.addEventListener('astro:page-load', initStack);
  </script>
</Layout>
